/* Shared mobile rhythm. Page-specific colors keep each service recognizable. */
page { --campus-ink: #193449; --campus-muted: #7e94a6; --campus-paper: #f2f6fa; --campus-line: #dde7ef; background: var(--campus-paper); color: var(--campus-ink); font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; }
button { box-sizing: border-box; } button::after { border: 0; }
.campus-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 28rpx; box-sizing: border-box; }
.campus-heading-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.campus-kicker { font-size: 20rpx; letter-spacing: 2rpx; color: var(--campus-muted); line-height: 1.4; }
.campus-title { margin-top: 6rpx; font-size: 40rpx; font-weight: 750; line-height: 1.3; color: var(--campus-ink); }
.campus-subtitle { display: block; margin-top: 10rpx; font-size: 24rpx; line-height: 1.6; color: #70879b; }
.campus-search-icon { width: 22rpx; height: 22rpx; border: 3rpx solid currentColor; border-radius: 50%; position: relative; flex-shrink: 0; margin-right: 18rpx; box-sizing: border-box; }
.campus-search-icon::after { content: ""; position: absolute; right: -7rpx; bottom: -5rpx; width: 10rpx; height: 3rpx; border-radius: 3rpx; background: currentColor; transform: rotate(45deg); }
.campus-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 52rpx 28rpx; border: 2rpx dashed var(--campus-line); border-radius: 28rpx; background: #ffffff; text-align: center; }
.campus-empty-title { margin-top: 24rpx; font-size: 29rpx; font-weight: 650; line-height: 1.4; }
.campus-empty-note { margin-top: 10rpx; font-size: 24rpx; color: var(--campus-muted); line-height: 1.6; }
.campus-pressed { opacity: .75; }
