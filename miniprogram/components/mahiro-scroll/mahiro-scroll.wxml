<scroll-view scroll-y class="scroll" scroll-into-view="{{scrollTarget}}" scroll-with-animation refresher-enabled refresher-threshold="80" refresher-default-style="none" refresher-background="#f2f6fa" refresher-triggered="{{triggered}}" bindrefresherpulling="onPulling" bindrefresherrefresh="onRefresh" bindrefresherrestore="onRestore" bindrefresherabort="onRestore" bindscrolltolower="onMore">
  <view slot="refresher" class="refresh refresh--{{state}}" aria-live="polite">
    <view class="character"><image wx:if="{{!imageFailed}}" class="mahiro" src="https://www.crbuj.icu/campus-api/uploads/mahiro-refresh-v2.png" mode="aspectFit" binderror="onImageError" /><text wx:else class="fallback">✿</text><text class="sparkle">✦</text></view>
    <view class="copy"><text class="title">{{state === 'loading' ? '真寻正在搬运新鲜事…' : (state === 'success' ? '刷新好啦，给你比个心！' : (state === 'error' ? '没连上，再拉一次试试' : (state === 'ready' ? '松手，让真寻出发！' : '下拉，和真寻一起刷新')))}}</text><text class="note">{{state === 'success' ? '你的小小日常，已更新 ✧' : (state === 'error' ? '保留原有内容，稍后重试' : 'MAHIRO · CAMPUS DAILY')}}</text></view>
  </view>
  <slot />
</scroll-view>

