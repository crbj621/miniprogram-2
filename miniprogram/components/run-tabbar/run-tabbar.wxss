button {
  margin: 0;
  padding: 0;
  line-height: normal;
  background: transparent;
  color: inherit;
}

button::after {
  border: 0;
}

.tab-bar {
  position: fixed;
  z-index: 40;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 28rpx rgba(16, 42, 43, 0.08);
}

.tab-bar-border {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 1rpx;
  background: #d9e7e3;
}

.tab-bar-item {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border-radius: 0;
  transition: opacity 160ms ease, background-color 160ms ease;
}

.tab-bar-item--pressed {
  opacity: 0.62;
  background: #edf7f5;
}

.tab-bar-item.selected::before {
  content: "";
  position: absolute;
  top: 0;
  left: 50%;
  width: 44rpx;
  height: 5rpx;
  border-radius: 0 0 6rpx 6rpx;
  background: #0f766e;
  transform: translateX(-50%);
}

.tab-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  color: #71827f;
}

.tab-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 500;
  color: #71827f;
}

.selected .tab-icon,
.selected .tab-label {
  color: #0f766e;
}

.run-head {
  position: absolute;
  top: 2rpx;
  right: 8rpx;
  width: 10rpx;
  height: 10rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.run-body,
.run-arm,
.run-leg {
  position: absolute;
  height: 4rpx;
  border-radius: 4rpx;
  background: currentColor;
  transform-origin: left center;
}

.run-body {
  top: 17rpx;
  left: 19rpx;
  width: 24rpx;
  transform: rotate(22deg);
}

.run-arm {
  top: 20rpx;
  left: 20rpx;
  width: 19rpx;
  transform: rotate(148deg);
}

.run-leg-one {
  top: 28rpx;
  left: 27rpx;
  width: 22rpx;
  transform: rotate(35deg);
}

.run-leg-two {
  top: 29rpx;
  left: 27rpx;
  width: 23rpx;
  transform: rotate(135deg);
}

.tab-icon-rank {
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.rank-bar {
  width: 9rpx;
  border: 3rpx solid currentColor;
  border-bottom-width: 4rpx;
  border-radius: 3rpx 3rpx 0 0;
  box-sizing: border-box;
}

.rank-bar + .rank-bar {
  margin-left: 5rpx;
}

.rank-bar-one {
  height: 22rpx;
}

.rank-bar-two {
  height: 39rpx;
}

.rank-bar-three {
  height: 30rpx;
}

.profile-head {
  position: absolute;
  top: 3rpx;
  left: 17rpx;
  width: 15rpx;
  height: 15rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.profile-body {
  position: absolute;
  left: 8rpx;
  bottom: 3rpx;
  width: 32rpx;
  height: 21rpx;
  border: 4rpx solid currentColor;
  border-bottom: 0;
  border-radius: 22rpx 22rpx 0 0;
  box-sizing: border-box;
}
.tab-bar { left: 24rpx; right: 24rpx; bottom: calc(12rpx + env(safe-area-inset-bottom)); height: 96rpx; padding-bottom: 0; border: 2rpx solid #dce8f1; border-radius: 30rpx; box-shadow: 0 5rpx 0 #e2ebf3; background: #fff; overflow: hidden; }.tab-bar-border { display: none; }.tab-bar-item { min-height: 96rpx; }.tab-bar-item.selected { background: #e8f4fc; }.tab-bar-item.selected::before { display: none; }.selected .tab-icon,.selected .tab-label { color: #338ac7; }.tab-icon { color: #93a7b8; }.tab-label { color: #879ead; font-size: 21rpx; }.tab-bar-item--pressed { background: #dfeefb; }
