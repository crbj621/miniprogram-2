.share-page { min-height:100vh; padding:90rpx 40rpx; box-sizing:border-box; background:linear-gradient(145deg,#fff4f8,#eff2ff); color:#81657d; }
.share-card { background:#ffffffec; padding:60rpx 38rpx; border-radius:44rpx; text-align:center; box-shadow:0 24rpx 80rpx #b589aa1c; }
.symbol { display:block; font-size:94rpx; margin:20rpx; }
.kicker,.note,.help { display:block; font-size:24rpx; color:#b292a7; line-height:1.9; }
.title { display:block; font-size:36rpx; font-weight:700; line-height:1.6; margin:26rpx 0; }
button { margin:38rpx 0 20rpx; border-radius:28rpx; font-size:28rpx; color:#81657d; }
.help { font-size:22rpx; }
