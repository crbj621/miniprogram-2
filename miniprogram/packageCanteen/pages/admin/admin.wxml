<mahiro-scroll id="page-refresh" class="page-refresh-scroll" bindrefresh="refreshPage">
<view class="page">
  <view class="campus-heading"><view class="campus-heading-copy"><text class="campus-kicker">校园管理 · 吃前看看</text><text class="campus-title">食堂评分管理</text><text class="campus-subtitle">照片、菜品与评价，一站整理</text></view><campus-sticker kind="canteen" /></view>
  <view class="notice">先拍摄档口并发布，再添加菜品。草稿不会出现在同学端。</view>
  <view class="tabs"><button class="{{tab === 'stalls' ? 'active' : ''}} tech-control" data-tab="stalls" bindtap="switchTab" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">档口</button><button class="{{tab === 'dishes' ? 'active' : ''}} tech-control" data-tab="dishes" bindtap="switchTab" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">菜品</button><button class="{{tab === 'reviews' ? 'active' : ''}} tech-control" data-tab="reviews" bindtap="switchTab" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">评价</button><button class="{{tab === 'submissions' ? 'active' : ''}} tech-control" data-tab="submissions" bindtap="switchTab" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">投稿 {{submissions.length}}</button></view>
  <block wx:if="{{tab === 'stalls'}}">
    <view class="form"><text class="heading">{{stallForm.id ? '编辑档口' : '新增档口'}}</text><text class="form-label">档口名称</text><input placeholder="档口名称" value="{{stallForm.name}}" data-field="name" bindinput="stallInput" placeholder-style="color:#8597ad" class="tech-input" /><text class="form-label">位置</text><input placeholder="位置，例如第一食堂一楼东侧" value="{{stallForm.location}}" data-field="location" bindinput="stallInput" placeholder-style="color:#8597ad" class="tech-input" /><text class="form-label">档口介绍</text><textarea placeholder="档口介绍" value="{{stallForm.description}}" data-field="description" bindinput="stallInput" placeholder-style="color:#8597ad" class="tech-input" /><button class="photo tech-control" data-type="stall" bindtap="chooseImage" loading="{{uploading}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">{{stallForm.image ? '更换档口照片' : '拍摄或选择档口照片'}}</button><image wx:if="{{stallForm.image}}" src="{{stallForm.image}}" mode="aspectFill"></image><view class="switch-row"><text>发布给同学</text><tech-switch checked="{{stallForm.status === 'published'}}" bindchange="stallStatus" /></view><view class="actions"><button bindtap="resetStall" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100" class="tech-control">清空</button><button class="primary uiverse-sweep uiverse-sweep--tint tech-control tech-primary" bindtap="saveStall" loading="{{saving}}" hover-class="uiverse-sweep-pressed tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100"><view class="uiverse-sweep-plane" />保存档口</button></view></view>
    <view class="heading list-heading">已录入档口</view><view class="entry" wx:for="{{stalls}}" wx:key="_id"><view><text class="entry-name">{{item.name}}</text><text class="entry-meta">{{item.location}} · {{item.status === 'published' ? '已发布' : '草稿'}}</text></view><button data-id="{{item._id}}" bindtap="editStall" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100" class="tech-control">编辑</button></view>
  </block>
  <block wx:elif="{{tab === 'dishes'}}">
    <view class="form"><text class="heading">{{dishForm.id ? '编辑菜品' : '新增菜品'}}</text><picker range="{{stalls}}" range-key="name" value="{{stallIndex}}" bindchange="chooseStall"><view class="picker">所属档口：{{stalls.length ? stalls[stallIndex].name : '请先新增档口'}} ▾</view></picker><text class="form-label">菜品名称</text><input placeholder="菜品名称" value="{{dishForm.name}}" data-field="name" bindinput="dishInput" placeholder-style="color:#8597ad" class="tech-input" /><text class="form-label">价格</text><input placeholder="价格（可不填）" value="{{dishForm.price}}" type="digit" data-field="price" bindinput="dishInput" placeholder-style="color:#8597ad" class="tech-input" /><text class="form-label">菜品描述</text><textarea placeholder="味道、份量或菜品描述" value="{{dishForm.description}}" data-field="description" bindinput="dishInput" placeholder-style="color:#8597ad" class="tech-input" /><button class="photo tech-control" data-type="dish" bindtap="chooseImage" loading="{{uploading}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">{{dishForm.image ? '更换菜品照片' : '拍摄或选择菜品照片'}}</button><image wx:if="{{dishForm.image}}" src="{{dishForm.image}}" mode="aspectFill"></image><view class="switch-row"><text>发布给同学</text><tech-switch checked="{{dishForm.status === 'published'}}" bindchange="dishStatus" /></view><view class="actions"><button bindtap="resetDish" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100" class="tech-control">清空</button><button class="primary uiverse-sweep uiverse-sweep--tint tech-control tech-primary" bindtap="saveDish" loading="{{saving}}" hover-class="uiverse-sweep-pressed tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100"><view class="uiverse-sweep-plane" />保存菜品</button></view></view>
    <view class="heading list-heading">已录入菜品</view><view class="entry" wx:for="{{dishes}}" wx:key="_id"><view><text class="entry-name">{{item.name}}</text><text class="entry-meta">{{item.status === 'published' ? '已发布' : '草稿'}} · {{item.count}} 条评价</text></view><button data-id="{{item._id}}" bindtap="editDish" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100" class="tech-control">编辑</button></view>
  </block>
  <block wx:elif="{{tab === 'reviews'}}"><view class="heading list-heading">同学评价</view><view class="entry review" wx:for="{{reviews}}" wx:key="_id"><view><text class="entry-name">{{item.nickname}} · {{item.score}} 分</text><text class="entry-meta">{{item.comment}}</text></view><button data-id="{{item._id}}" bindtap="hideReview" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100" class="tech-control">隐藏</button></view><view class="empty" wx:if="{{!reviews.length}}">暂无评价</view></block>
  <block wx:else><view class="entry submission-entry" wx:for="{{submissions}}" wx:key="_id"><view><text class="entry-name">{{item.dishName}} · {{item.nickname}}</text><text class="entry-meta">{{item.stallName || '现有档口'}} {{item.location}}</text><text class="entry-meta">{{item.description}}</text><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" /></view><view class="submission-actions"><button bindtap="moderate" data-id="{{item._id}}" data-status="rejected" disabled="{{saving}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100" class="tech-control">退回</button><button class="primary uiverse-sweep uiverse-sweep--tint tech-control tech-primary" bindtap="moderate" data-id="{{item._id}}" data-status="approved" disabled="{{saving}}" hover-class="uiverse-sweep-pressed tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100"><view class="uiverse-sweep-plane" />通过发布</button></view></view><view class="empty" wx:if="{{!submissions.length}}">投稿都处理好啦 ✦</view></block>
</view>

</mahiro-scroll>
