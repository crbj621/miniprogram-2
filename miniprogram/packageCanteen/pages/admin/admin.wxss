@import "../../../styles/admin-ui.wxss";
.page { padding: 0 28rpx calc(40rpx + env(safe-area-inset-bottom)); }.campus-heading { padding: 28rpx 0; }
.notice { background: #e7f2fc; color: #437caa; border-radius: 24rpx; padding: 22rpx; font-size: 24rpx; line-height: 1.6; }
.tabs { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 12rpx; margin: 24rpx 0; }.tabs button { margin: 0; height: 88rpx; border-radius: 20rpx; font-size: 24rpx; background: #f1f4ea; color: #7e94a6; }.tabs .active { background: #e7f2fc; color: #437caa; font-weight: 700; }
.form { background: #fff; border: 2rpx solid #dee8f0; border-radius: 28rpx; padding: 26rpx; display: flex; flex-direction: column; gap: 16rpx; }.heading { font-size: 32rpx; font-weight: 700; }.form-label { font-size: 24rpx; margin-top: 8rpx; color: #70879b; }
.form input,.form textarea,.picker { box-sizing: border-box; width: 100%; border: 2rpx solid #dee8f0; border-radius: 20rpx; padding: 0 20rpx; font-size: 27rpx; background: #f2f6fa; }.form input,.picker { height: 88rpx; }.picker { display: flex; align-items: center; overflow: hidden; }.form textarea { padding: 20rpx; height: 180rpx; line-height: 1.6; }.form image { width: 100%; height: 300rpx; border-radius: 22rpx; }
.photo { margin: 8rpx 0 0; min-height: 96rpx; padding: 18rpx; background: #e8f4fc; color: #3786b8; font-size: 27rpx; border-radius: 22rpx; }.switch-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 100rpx; font-size: 27rpx; }
.actions { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }.actions button { margin: 0; height: 88rpx; background: #edf3f8; color: #70879b; border-radius: 22rpx; font-size: 27rpx; }.actions .primary { background: #338ac7; color: #fff; }
.list-heading { margin: 30rpx 0 18rpx; }.entry { background: #fff; border: 2rpx solid #dee8f0; border-radius: 24rpx; margin-bottom: 16rpx; padding: 22rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }.entry > view { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }.entry-name { font-size: 28rpx; font-weight: 700; overflow-wrap: break-word; }.entry-meta { font-size: 23rpx; color: #7e94a6; line-height: 1.6; overflow-wrap: break-word; }.entry button { width: 112rpx; flex-shrink: 0; margin: 0; min-height: 88rpx; border-radius: 22rpx; font-size: 25rpx; background: #e8f4fc; color: #3786b8; }.review button { background: #eaf0fc; color: #647ba7; }.empty { text-align: center; padding: 60rpx 0; font-size: 26rpx; color: #7e94a6; }
.submission-entry { flex-direction: column; align-items: stretch; }.submission-entry image { width: 100%; height: 240rpx; border-radius: 20rpx; margin-top: 14rpx; }.entry .submission-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }.submission-actions button { width: 100%; }.submission-actions .primary { background: #7aaa71; color: #fff; }

.page-refresh-scroll { height: 100vh; display: block; }

@import "../../../styles/tech-ui.wxss";
