@import "../../../styles/campus-ui.wxss";
.page { padding: 0 28rpx calc(40rpx + env(safe-area-inset-bottom)); }.campus-heading { margin: 0 -28rpx; padding: 32rpx 28rpx; background: #e8f4fc; border-radius: 0 0 36rpx 36rpx; }.campus-title { font-size: 37rpx; }
button { margin: 0; padding: 0; line-height: normal; }.card { margin-top: 24rpx; padding: 28rpx; border: 2rpx solid #dee8f0; background: #fff; border-radius: 28rpx; }.section-title { font-size: 31rpx; font-weight: 700; }.modes { display: flex; gap: 10rpx; padding: 8rpx; margin-top: 24rpx; background: #f0f5fa; border-radius: 22rpx; }.mode { flex: 1; min-width: 0; min-height: 88rpx; padding: 8rpx 4rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; color: #7e94a6; background: transparent; font-size: 24rpx; line-height: 1.4; text-align: center; }.mode.active { color: #338ac7; background: #fff; box-shadow: 0 3rpx 10rpx rgba(104,82,54,.06); font-weight: 650; }.hint { display: block; min-height: 40rpx; margin: 20rpx 0; color: #7e94a6; font-size: 23rpx; line-height: 1.6; }.pick { width: 100%; min-height: 92rpx; padding: 20rpx; border-radius: 24rpx; background: linear-gradient(120deg,#338ac7,#34b4c8); border-bottom: 6rpx solid #277da9; box-shadow: 0 8rpx 20rpx #338ac71f; color: #ffffff; font-size: 29rpx; font-weight: 650; text-align: center; }
.picked { display: flex; align-items: center; gap: 16rpx; margin-top: 22rpx; padding: 18rpx; background: #edf6fc; border-radius: 22rpx; }.picked image { width: 100rpx; height: 100rpx; flex-shrink: 0; border-radius: 18rpx; }.picked-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 9rpx; font-size: 23rpx; color: #7e94a6; }.picked-name { font-size: 28rpx; font-weight: 650; color: #193449; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.search { display: flex; align-items: center; gap: 12rpx; padding: 8rpx 8rpx 8rpx 24rpx; margin: 24rpx 0; border-radius: 24rpx; background: #edf3f8; color: #8299ac; }.search input { flex: 1; min-width: 0; font-size: 26rpx; height: 80rpx; }.search button { min-height: 80rpx; padding: 0 24rpx; border-radius: 18rpx; background: #fff; color: #338ac7; font-size: 25rpx; }
.tabs { display: flex; padding: 6rpx; gap: 10rpx; border-radius: 24rpx; background: #edf3f8; margin-bottom: 24rpx; }.tabs button { flex: 1; min-height: 88rpx; padding: 18rpx; border-radius: 20rpx; font-size: 28rpx; color: #7e94a6; text-align: center; background: transparent; }.tabs .selected { background: #fff; color: #338ac7; font-weight: 650; }
.list-card { display: flex; align-items: center; gap: 20rpx; padding: 22rpx; margin-bottom: 18rpx; border: 2rpx solid #dee8f0; border-radius: 28rpx; background: #fff; }.list-card image,.placeholder { width: 112rpx; height: 112rpx; border-radius: 24rpx; flex-shrink: 0; }.list-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 10rpx; font-size: 23rpx; color: #7e94a6; }.list-name { font-size: 29rpx; font-weight: 700; color: #193449; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.score { font-size: 24rpx; color: #3786b8; line-height: 1.5; }.verdict { display: inline-block; border-radius: 8rpx; background: #edf5e9; padding: 3rpx 8rpx; color: #48785c; font-size: 21rpx; }.verdict.danger { color: #a54b45; background: #fce8e2; }.empty-tip { display: block; text-align: center; color: #7e94a6; font-size: 24rpx; padding: 32rpx 20rpx; line-height: 1.6; }
.discovery-actions { display: grid; grid-template-columns: 1fr auto; gap: 14rpx; margin-bottom: 24rpx; }.discovery-actions button { margin: 0; min-height: 82rpx; padding: 16rpx 20rpx; font-size: 24rpx; line-height: 1.4; color: #5e87a7; border-radius: 20rpx; background: #edf6fc; border: 2rpx solid #d9e8f3; }

.page-refresh-scroll { height: 100vh; display: block; }

@import "../../../styles/uiverse.wxss";

.pick.uiverse-sweep { background: #f7f8ff; color: #5274b2; border: 2rpx solid #6083c7; box-shadow: 0 8rpx 20rpx #9a8ed323; }

