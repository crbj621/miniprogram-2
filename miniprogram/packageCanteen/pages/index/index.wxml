<share-intro wx:if="{{__sharePublic}}" title="{{__shareTitle}}" path="{{__sharePath}}" /><block wx:else>
<mahiro-scroll id="page-refresh" class="page-refresh-scroll" bindrefresh="refreshPage">
<view class="page campus-theme {{theme.key !== 'default' ? 'campus-theme-enabled' : ''}}" style="{{theme.style}}">
  <view class="campus-heading campus-theme-surface"><view class="campus-heading-copy"><text class="campus-kicker">{{pageCopy.title}}</text><text class="campus-title">食堂饭菜评价<text wx:if="{{theme.key !== 'default'}}" class="campus-theme-decoration">{{theme.decoration}}</text></text><text class="campus-subtitle">{{pageCopy.subtitle}}</text></view><campus-sticker kind="canteen" /></view>
  <view class="meal-tabs"><button wx:for="{{meals}}" wx:key="key" class="tech-control {{meal === item.key ? 'selected' : ''}}" data-meal="{{item.key}}" bindtap="chooseMeal" hover-class="tech-pressed">{{item.label}}</button></view><text class="meal-note">午晚餐共用菜品 · 按供应时段筛选</text>
  <view class="random card tech-card campus-theme-surface">
    <view class="discovery-actions"><button bindtap="goSubmit" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100" class="tech-control">＋ 投稿我的发现</button><button bindtap="load" loading="{{loading}}" disabled="{{loading}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100" class="tech-control">刷新 ↻</button></view>
    <view class="section-title">今天不知道吃什么？</view>
    <view class="modes">
      <button class="mode {{randomMode === 'quality' ? 'active' : ''}} tech-control" data-mode="quality" bindtap="selectMode" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">优质随机</button>
      <button class="mode {{randomMode === 'all' ? 'active' : ''}} tech-control" data-mode="all" bindtap="selectMode" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">全部随机</button>
      <button class="mode {{randomMode === 'unusual' ? 'active' : ''}} tech-control" data-mode="unusual" bindtap="selectMode" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">异食癖随机</button>
    </view>
    <text class="hint" wx:if="{{randomMode === 'quality'}}">至少 2 人评分且均分 ≥ 4 分</text>
    <text class="hint" wx:elif="{{randomMode === 'unusual'}}">至少 2 人评分且均分 ≤ 2.5 分，敢吃就来</text>
    <text class="hint" wx:else>从全部已发布菜品中抽取</text>
    <button class="pick uiverse-sweep tech-control tech-primary" bindtap="pick" loading="{{picking}}" disabled="{{picking}}" hover-class="uiverse-sweep-pressed tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100"><view class="uiverse-sweep-plane" />{{picking ? '正在抽取…' : '帮我抽一道'}}</button>
    <view class="picked" wx:if="{{picked}}" bindtap="goPicked" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
      <image wx:if="{{picked.image}}" src="{{picked.image}}" mode="aspectFill"></image>
      <view class="picked-copy"><text class="picked-name">{{picked.name}}</text><text>{{pickedStall.name}} · {{picked.count ? picked.score + ' 分' : '暂无评分'}}</text></view>
      <text>›</text>
    </view>
    <text class="empty-tip" wx:if="{{randomMessage}}">{{randomMessage}}</text>
  </view>
  <view class="search"><view class="campus-search-icon"></view><tech-search class="tech-search-host"><input adjust-position="{{true}}" cursor-spacing="24" placeholder="搜索档口或菜品" value="{{keyword}}" bindinput="onKeyword" bindconfirm="search" placeholder-style="color:#8597ad" class="tech-input" /></tech-search><button bindtap="search" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100" class="tech-control">搜索</button></view>
  <view class="tabs"><button class="{{tab === 'stalls' ? 'selected' : ''}} tech-control" data-tab="stalls" bindtap="switchTab" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">档口排行</button><button class="{{tab === 'dishes' ? 'selected' : ''}} tech-control" data-tab="dishes" bindtap="switchTab" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">菜品排行</button></view>
  <view wx:if="{{loading}}" class="empty-tip"><tech-loader/>加载中…</view>
  <block wx:elif="{{tab === 'stalls'}}">
    <view class="list-card tech-card" wx:for="{{stalls}}" wx:key="_id" data-id="{{item._id}}" bindtap="goStall" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
      <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"></image><view wx:else class="placeholder"><campus-sticker kind="food" /></view>
      <view class="list-copy"><text class="list-name">{{index + 1}}. {{item.name}}</text><text>{{item.location}} · {{item.dishCount}} 道菜</text><text class="score">{{item.count ? item.score + ' 分 · ' + item.count + ' 份评分' : '暂无评分'}} <text wx:if="{{item.verdict}}" class="verdict {{item.verdict === '避雷' ? 'danger' : ''}}">{{item.verdict}}</text></text></view><text>›</text>
    </view>
    <view class="empty-tip" wx:if="{{!loading && !stalls.length}}">这里还没有公开档口，来投稿第一份发现吧</view>
  </block>
  <block wx:else>
    <view class="list-card tech-card" wx:for="{{dishes}}" wx:key="_id" data-id="{{item._id}}" bindtap="goDish" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
      <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"></image><view wx:else class="placeholder"><campus-sticker kind="food" /></view>
      <view class="list-copy"><text class="list-name">{{index + 1}}. {{item.name}}</text><text wx:if="{{item.price !== null}}">¥{{item.price}}</text><text class="score">{{item.count ? item.score + ' 分 · ' + item.count + ' 人评分' : '暂无评分'}} <text wx:if="{{item.verdict}}" class="verdict {{item.verdict === '避雷' ? 'danger' : ''}}">{{item.verdict}}</text></text></view><text>›</text>
    </view>
    <view class="empty-tip" wx:if="{{!loading && !dishes.length}}">这个餐次还没有菜品，试试其他餐次或补充发现</view>
  </block>
</view>

</mahiro-scroll>

</block>
