page{background:#f7f7f2;color:#263329}.page{padding-bottom:70rpx}.cover{width:100%;height:430rpx;background:#e5e9e1}.info{background:#fff;padding:30rpx;display:flex;flex-direction:column;gap:14rpx}.title{font-size:42rpx;font-weight:700}.location{color:#3c7757;font-size:26rpx}.desc{color:#7e8b80;font-size:25rpx;line-height:1.6}.meta{display:flex;gap:22rpx;color:#bb772c;font-size:24rpx}.heading{font-weight:700;font-size:32rpx;padding:32rpx 28rpx 18rpx}.dish{display:flex;gap:18rpx;background:#fff;margin:0 24rpx 16rpx;padding:16rpx;border-radius:18rpx;align-items:center}.dish image{width:138rpx;height:138rpx;border-radius:12rpx}.copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:8rpx}.name{font-size:29rpx;font-weight:700}.description{font-size:22rpx;color:#839084;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.score{font-size:23rpx;color:#bc7829}.arrow{font-size:38rpx;color:#8c9d90}.empty{text-align:center;color:#849186;padding:50rpx}
.cover.placeholder{display:flex;align-items:center;justify-content:center;font-size:110rpx;color:#598367}.thumb-placeholder{width:138rpx;height:138rpx;border-radius:12rpx;background:#e7efe7;display:flex;align-items:center;justify-content:center;font-size:55rpx}

.page-refresh-scroll { height: 100vh; display: block; }

