page{background:#f7f7f2;color:#263329}button::after{border:0}.page{padding-bottom:80rpx}.cover{width:100%;height:440rpx;background:#e5e9e1}.info,.form{background:#fff;padding:30rpx;display:flex;flex-direction:column;gap:15rpx}.title{font-size:44rpx;font-weight:700}.stall{font-size:24rpx;color:#4c7f5d}.price{font-size:28rpx;color:#bc792d}.desc{font-size:25rpx;color:#708174;line-height:1.6}.score{font-size:32rpx;color:#b7762b;font-weight:700}.score text{font-size:22rpx;font-weight:400;color:#829184}.form{margin-top:22rpx}.heading{font-size:31rpx;font-weight:700}.stars{display:flex;gap:20rpx}.stars text{font-size:58rpx;color:#d5dbd3}.stars .on{color:#f4b650}.form textarea{box-sizing:border-box;width:100%;height:165rpx;border:1rpx solid #e0e7df;border-radius:14rpx;padding:18rpx;font-size:25rpx}.form button.tech-control{width:100%;margin-left:0;margin-right:0;background:#285e42;color:#fff;text-align:center;padding:18rpx;border-radius:14rpx;font-size:27rpx}.list-heading{padding:32rpx 28rpx 12rpx}.review{background:#fff;margin:0 24rpx 14rpx;padding:24rpx;border-radius:16rpx;display:flex;flex-direction:column;gap:12rpx}.review-top{display:flex;justify-content:space-between;font-weight:700;font-size:26rpx}.review-score{color:#b7762b}.review-comment{font-size:25rpx;line-height:1.6}.time{font-size:20rpx;color:#9aa69c}.empty{text-align:center;color:#849186;padding:46rpx}
.cover.placeholder{display:flex;align-items:center;justify-content:center;font-size:110rpx;color:#598367}

.page-refresh-scroll { height: 100vh; display: block; }

@import "../../../styles/tech-ui.wxss";

.photo-label { display:flex; align-items:center; justify-content:space-between; gap:16rpx; color:#819283; font-size:23rpx; }
.photo-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12rpx; }
.photo-item { position:relative; min-width:0; overflow:hidden; border-radius:16rpx; }
.photo-item image,.review-photo { display:block; width:100%; height:146rpx; border-radius:16rpx; background:#edf2eb; }
.form button.photo-remove { width:100%; height:44px; min-height:44px; margin:0; padding:0; line-height:44px; text-align:center; border-radius:0; background:#fff4f8; color:#9b667d; font-size:23rpx; }
.form button.photo-add { min-height:88rpx; background:#edf5ef !important; color:#618674 !important; }
.photo-error { display:block; color:#a86a7c; font-size:23rpx; line-height:1.6; }
.review-footer { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.review-footer .time { flex:1; min-width:0; word-break:break-all; }
.review button.review-like { width:auto; margin:0; padding:12rpx 18rpx; min-height:44px; flex-shrink:0; font-size:23rpx; }
.review button.review-like--active { color:#a05d85 !important; background:#fff0f7 !important; border-color:#edd0df !important; }
.review-top > text:first-child { min-width:0; word-break:break-all; }.review-score { flex-shrink:0; }.review-comment { word-break:break-word; }
.list-heading { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.review-sort,.review-actions { display:flex; align-items:center; gap:12rpx; flex-shrink:0; }
.review-sort button { width:auto; min-height:44px; margin:0; padding:10rpx 20rpx; font-size:23rpx; }
.review-sort button.review-sort--active { background:#285e42 !important; color:#fff !important; border-color:#285e42 !important; }
.review button.review-delete { width:auto; min-height:44px; margin:0; padding:12rpx 18rpx; font-size:23rpx; color:#a86a7c !important; }
.review-footer { flex-wrap:wrap; }

.review-actions { flex-wrap:wrap; justify-content:flex-end; }
.report-info { margin:0 0 24rpx; min-height:44px; padding:10rpx 16rpx; font-size:24rpx; color:#af8c9f; }
.rating-line { display:flex; align-items:center; justify-content:space-between; gap:16rpx; font-size:25rpx; color:#618674; }
.form button.rating-toggle { width:auto; flex-shrink:0; margin:0; min-height:44px; padding:10rpx 18rpx; font-size:23rpx; background:#edf5ef; color:#618674; }
.rating-hint { font-size:22rpx; color:#819283; line-height:1.6; }
.stars view { min-width:44px; min-height:44px; display:flex; align-items:center; justify-content:center; font-size:52rpx; color:#d5dbd3; }
.stars { gap:10rpx; }.review-author { display:flex; align-items:center; gap:14rpx; min-width:0; flex:1; }
.review-author text { min-width:0; word-break:break-all; }.review-avatar { display:block; width:64rpx; height:64rpx; border-radius:50%; flex-shrink:0; background:#f1f6e9; }
.avatar-empty { display:flex; align-items:center; justify-content:center; font-size:30rpx; }.review-top { align-items:center; gap:16rpx; }
.dispute-tag { align-self:flex-start; padding:6rpx 12rpx; border-radius:12rpx; background:#fff5de; color:#9d793c; font-size:21rpx; }
