<share-intro wx:if="{{__sharePublic}}" title="{{__shareTitle}}" path="{{__sharePath}}" /><block wx:else>
<mahiro-scroll id="page-refresh" class="page-refresh-scroll" bindrefresh="refreshPage">
<view class="page" wx:if="{{dish}}">
  <image wx:if="{{dish.image}}" class="cover" src="{{dish.image}}" mode="aspectFill" bindtap="preview"></image><view wx:else class="cover placeholder">🍚</view>
  <view class="info"><text class="title">{{dish.name}}</text><text class="stall">{{stall.name}} · {{stall.location}}</text><text class="price" wx:if="{{dish.price !== null}}">¥{{dish.price}}</text><text class="desc">{{dish.description}}</text><view class="score">{{count ? score + ' / 5 分' : '暂无评分'}} <text>· {{count}} 人评分 · {{reviewCount}} 条评论</text></view></view>
  <button class="report-info tech-control" data-type="dish" bindtap="report">信息不准？反馈一下</button><view class="form"><text class="heading">和同学聊聊这道菜</text>
    <view class="rating-line"><text>{{ratingLocked ? '你的评分暂不计入，仍可交流' : (myRating ? '我的最新评分：' + myRating.score + ' 分' : '吃过这道菜？也可以打分')}}</text><button wx:if="{{!ratingLocked}}" class="rating-toggle tech-control" bindtap="toggleRating" disabled="{{saving}}">{{rateWithComment ? '只发评论' : (myRating ? '修改评分' : '我要评分')}}</button></view>
    <view wx:if="{{rateWithComment && !ratingLocked}}" class="stars"><view wx:for="{{stars}}" wx:key="*this" data-score="{{item}}" bindtap="selectScore" class="{{myScore >= item ? 'on' : ''}} tap-action" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">★</view></view>
    <text class="rating-hint">每人只计算最新评分；交流可多次发布，删除评论保留评分。</text><textarea disable-default-padding="{{true}}" adjust-position="{{true}}" cursor-spacing="24" value="{{comment}}" bindinput="onComment" disabled="{{saving || !!deletingReview}}" maxlength="500" placeholder="说说口味、份量，或和同学交流一下～" placeholder-style="color:#8597ad" class="tech-input" />
    <view class="photo-label"><text>晒晒这道菜</text><text>{{images.length}} / 4 张</text></view>
    <view wx:if="{{images.length}}" class="photo-grid"><view wx:for="{{images}}" wx:for-item="image" wx:key="*this" class="photo-item"><image src="{{image}}" mode="aspectFill" data-url="{{image}}" bindtap="previewImages" /><button class="photo-remove" data-index="{{index}}" catchtap="removeImage" disabled="{{uploading || saving || !!deletingReview}}" aria-label="删除这张晒图">移除</button></view></view>
    <button wx:if="{{4 > images.length}}" class="photo-add tech-control" bindtap="chooseImages" loading="{{uploading}}" disabled="{{uploading || saving || !!deletingReview}}" hover-class="tech-pressed">{{uploading ? '正在上传照片…' : '＋ 添加晒图'}}</button><text wx:if="{{uploadError}}" class="photo-error">{{uploadError}}</text>
    <button bindtap="submit" loading="{{saving}}" disabled="{{saving || uploading || !!deletingReview}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100" class="tech-control">{{uploading ? '照片上传中…' : (rateWithComment ? '发布评论并更新评分' : '发布评论')}}</button>
  </view>
  <view class="heading list-heading"><text>同学评价</text><view class="review-sort"><button class="tech-control {{reviewSort === 'latest' ? 'review-sort--active' : ''}}" data-sort="latest" bindtap="switchReviewSort" hover-class="tech-pressed">最新</button><button class="tech-control {{reviewSort === 'hot' ? 'review-sort--active' : ''}}" data-sort="hot" bindtap="switchReviewSort" hover-class="tech-pressed">最热门</button></view></view>
  <view class="review" wx:for="{{reviews}}" wx:key="_id"><view class="review-top"><view class="review-author"><image wx:if="{{item.avatarUrl}}" class="review-avatar" src="{{item.avatarUrl}}" mode="aspectFill" /><view wx:else class="review-avatar avatar-empty">🍙</view><text>{{item.nickname}}{{item.mine ? '（我）' : ''}}</text></view><text class="review-score">{{item.score ? item.score + ' 分' + (item.latestRating ? ' · 最新' : '') : '交流'}}</text></view><text wx:if="{{item.disputed}}" class="dispute-tag">多人存疑 · 管理员核查中</text><text class="review-comment">{{item.comment}}</text>
    <view wx:if="{{item.images.length}}" class="photo-grid"><image wx:for="{{item.images}}" wx:for-item="image" wx:key="*this" class="review-photo" src="{{image}}" mode="aspectFill" data-review-id="{{item._id}}" data-url="{{image}}" bindtap="previewImages" /></view>
    <view class="review-footer"><text class="time">{{item.updatedAt}}</text><view class="review-actions"><button class="review-delete tech-control" data-type="review" data-id="{{item._id}}" bindtap="report">举报</button><button class="review-like tech-control {{item.myVote === 'up' ? 'review-like--active' : ''}}" data-id="{{item._id}}" data-vote="up" bindtap="likeReview" disabled="{{item.mine || !!likingReview || !!deletingReview}}" loading="{{likingReview === item._id}}" hover-class="tech-pressed">♡ 有用 {{item.likeCount}}</button><button class="review-delete tech-control {{item.myVote === 'down' ? 'review-like--active' : ''}}" data-id="{{item._id}}" data-vote="down" bindtap="likeReview" disabled="{{item.mine || !!likingReview || !!deletingReview}}" hover-class="tech-pressed">? 存疑 {{item.downCount || 0}}</button><button wx:if="{{item.mine}}" class="review-delete tech-control" data-id="{{item._id}}" bindtap="deleteReview" disabled="{{!!deletingReview || !!likingReview || saving || uploading}}" loading="{{deletingReview === item._id}}" hover-class="tech-pressed">删除</button></view></view>
  </view>
  <view class="empty" wx:if="{{!reviews.length}}">还没有评价，欢迎来打第一分</view>
</view>

</mahiro-scroll>

</block>
