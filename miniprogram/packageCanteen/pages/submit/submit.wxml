<mahiro-scroll id="page-refresh" class="page-refresh-scroll" bindrefresh="refreshPage">
<view class="submission-page">
  <view class="campus-heading"><view class="campus-heading-copy"><text class="campus-kicker">把好吃的分享给大家 ✦</text><text class="campus-title">我的食堂发现</text><text class="campus-subtitle">投稿审核后公开，评分请到菜品页点评</text></view><campus-sticker kind="canteen" /></view>
  <view class="submission-card">
    <text class="field-label">在哪个档口？</text><picker range="{{stallNames}}" value="{{stallIndex}}" bindchange="chooseStall"><view class="field-input">{{stallNames[stallIndex]}} ›</view></picker>
    <block wx:if="{{!form.stallId}}"><text class="field-label">档口名称</text><input class="field-input tech-input" data-field="stallName" value="{{form.stallName}}" bindinput="input" maxlength="60" placeholder="例如：一食堂香香面馆" placeholder-style="color:#8597ad" /><text class="field-label">食堂 / 楼层 / 位置</text><input class="field-input tech-input" data-field="location" value="{{form.location}}" bindinput="input" maxlength="100" placeholder="例如：一食堂二楼 3 号窗口" placeholder-style="color:#8597ad" /></block>
    <text class="field-label">菜品名称</text><input class="field-input tech-input" data-field="dishName" value="{{form.dishName}}" bindinput="input" maxlength="80" placeholder="今天发现了什么好吃的？" placeholder-style="color:#8597ad" />
    <text class="field-label">价格（选填）</text><input class="field-input tech-input" type="digit" data-field="price" value="{{form.price}}" bindinput="input" placeholder="多少元一份" placeholder-style="color:#8597ad" />
    <text class="field-label">推荐 / 避雷理由</text><textarea class="field-textarea tech-input" data-field="description" value="{{form.description}}" bindinput="input" maxlength="500" placeholder="写下口味、分量、体验，不确定的内容也可以说明" placeholder-style="color:#8597ad" />
    <button class="photo-button tech-control" bindtap="chooseImage" loading="{{uploading}}" disabled="{{saving || uploading}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100"><image wx:if="{{form.image}}" src="{{form.image}}" mode="aspectFill" /><text>{{form.image ? '更换实拍照片' : '＋ 添加实拍照片（选填）'}}</text></button>
    <button class="submit-button uiverse-sweep uiverse-sweep--tint tech-control" bindtap="submit" loading="{{saving}}" disabled="{{saving || uploading}}" hover-class="uiverse-sweep-pressed tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100"><view class="uiverse-sweep-plane" />{{saving ? '正在投递小发现…' : '投递我的发现 ✦'}}</button>
  </view>
  <view class="history-heading"><text>我的投稿</text><button bindtap="load" loading="{{loading}}" disabled="{{loading}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100" class="tech-control">刷新 ↻</button></view>
  <view class="submission-card" wx:for="{{submissions}}" wx:key="_id"><view class="history-title"><text>{{item.dishName}}</text><text class="status-tag">{{item.status === 'pending' ? '等待审核' : (item.status === 'approved' ? '已发布' : '已退回')}}</text></view><text class="history-note">{{item.reason || item.description}}</text></view>
  <view class="campus-empty" wx:if="{{!submissions.length && !loading}}"><text>还没有投稿，分享你的第一份发现吧</text></view>
</view>

</mahiro-scroll>
