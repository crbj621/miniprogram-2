<share-intro wx:if="{{__sharePublic}}" title="{{__shareTitle}}" path="{{__sharePath}}" /><block wx:else>
<mahiro-scroll id="page-refresh" class="page-refresh-scroll" bindrefresh="refreshPage">
<view class="submission-page">
  <view class="campus-heading"><view class="campus-heading-copy"><text class="campus-kicker">把好吃的分享给大家 ✦</text><text class="campus-title">{{editingId ? '修改我的投稿' : '我的食堂发现'}}</text><text class="campus-subtitle">同一档口一起完善，实拍晚点也能补上</text></view><campus-sticker kind="canteen" /></view>
  <view wx:if="{{!editingId}}" class="contribution-tabs"><button class="tech-control {{kind === 'dish' ? 'selected' : ''}}" data-kind="dish" bindtap="switchKind">投稿菜品</button><button class="tech-control {{kind === 'stall' ? 'selected' : ''}}" data-kind="stall" bindtap="switchKind">投稿档口</button><button class="tech-control {{kind === 'photo' ? 'selected' : ''}}" data-kind="photo" bindtap="switchKind">档口补图</button></view>
  <view class="submission-card" id="canteen-form-start">
    <text class="field-label">在哪个档口？</text><picker range="{{stallNames}}" value="{{stallIndex}}" bindchange="chooseStall" disabled="{{!!editingId || saving || uploading}}"><view class="field-input">{{stallNames[stallIndex]}} {{editingId ? '' : '›'}}</view></picker>
    <block wx:if="{{!form.stallId && kind !== 'photo'}}"><text class="field-label">档口名称</text><input adjust-position="{{true}}" cursor-spacing="24" class="field-input tech-input" data-field="stallName" value="{{form.stallName}}" bindinput="input" bindblur="checkStall" disabled="{{saving}}" maxlength="60" placeholder="例如：香香面馆" placeholder-style="color:#8597ad" /><text class="field-label">食堂 / 楼层 / 窗口位置</text><input adjust-position="{{true}}" cursor-spacing="24" class="field-input tech-input" data-field="location" value="{{form.location}}" bindinput="input" bindblur="checkStall" disabled="{{saving}}" maxlength="100" placeholder="例如：一食堂二楼 3 号窗口，位置越准确越好" placeholder-style="color:#8597ad" />
      <view wx:if="{{checking || checkMessage}}" class="match-note"><text>{{checking ? '正在检查已有档口…' : checkMessage}}</text><button wx:if="{{match && match.available}}" class="tech-control" data-id="{{match._id}}" bindtap="useStall">选择这个档口</button></view>
      <view wx:if="{{candidates.length}}" class="match-note"><text>名称相近，先确认是否同一个档口：</text><button wx:for="{{candidates}}" wx:key="_id" class="tech-control" data-id="{{item._id}}" bindtap="useStall">{{item.name}} · {{item.location}}</button></view>
    </block>
    <text wx:if="{{kind === 'photo'}}" class="field-help">选择已有档口再上传实拍；没有封面时自动补上，已有封面由管理员挑选。</text>
    <block wx:if="{{kind === 'dish'}}"><text class="field-label">菜品名称</text><input adjust-position="{{true}}" cursor-spacing="24" class="field-input tech-input" data-field="dishName" value="{{form.dishName}}" bindinput="input" disabled="{{saving}}" maxlength="80" placeholder="今天发现了什么好吃的？" placeholder-style="color:#8597ad" /><text class="field-label">价格（选填）</text><input adjust-position="{{true}}" cursor-spacing="24" class="field-input tech-input" type="digit" data-field="price" value="{{form.price}}" bindinput="input" disabled="{{saving}}" placeholder="多少元一份" placeholder-style="color:#8597ad" /></block>
    <block wx:if="{{kind !== 'photo'}}"><text class="field-label">供应餐次</text><picker range="{{mealOptions}}" value="{{mealIndex}}" bindchange="chooseMeal" disabled="{{saving}}"><view class="field-input">{{mealOptions[mealIndex]}} ›</view></picker><text class="field-help">午餐和晚餐共用菜品，评论与评分不分成两份。</text></block>
    <text class="field-label">{{kind === 'dish' ? '推荐 / 避雷理由' : '补充说明（选填）'}}</text><textarea disable-default-padding="{{true}}" adjust-position="{{true}}" cursor-spacing="24" class="field-textarea tech-input" data-field="description" value="{{form.description}}" bindinput="input" disabled="{{saving}}" maxlength="500" placeholder="写下你的发现，不确定的内容也可以说明" placeholder-style="color:#8597ad" />
    <text class="field-label">{{kind === 'dish' ? '菜品投稿图片' : '档口投稿图片'}}{{kind === 'photo' ? '（补图）' : ''}}</text><text class="field-help">{{kind === 'dish' ? '请上传这道菜的实拍，图片展示在菜品页。' : '请上传档口招牌、窗口或整体实拍，图片展示在档口相册。'}}</text>
    <button class="photo-button tech-control" bindtap="chooseImage" loading="{{uploading}}" disabled="{{saving || uploading}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100"><image wx:if="{{form.image}}" src="{{form.image}}" mode="aspectFill" /><text>{{form.image ? (kind === 'dish' ? '更换菜品图片' : '更换档口图片') : (kind === 'dish' ? '＋ 添加菜品图片（选填）' : (kind === 'photo' ? '＋ 添加档口图片（必填）' : '＋ 添加档口图片（选填）'))}}</text></button>
    <button class="submit-button uiverse-sweep uiverse-sweep--tint tech-control" bindtap="submit" loading="{{saving}}" disabled="{{saving || uploading || !!deleting}}" hover-class="uiverse-sweep-pressed tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100"><view class="uiverse-sweep-plane" />{{saving ? '正在保存…' : (editingId ? '保存修改 ✦' : '投递我的发现 ✦')}}</button><button wx:if="{{editingId}}" class="cancel-edit tech-control" bindtap="cancelEdit" disabled="{{saving || uploading}}">取消修改</button>
  </view>
  <view class="history-heading"><text>我的投稿</text><button bindtap="load" loading="{{loading}}" disabled="{{loading}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100" class="tech-control">刷新 ↻</button></view>
  <view class="submission-card" wx:for="{{submissions}}" wx:key="_id"><view class="history-title"><text>{{item.kind === 'photo' ? '档口实拍补图' : (item.kind === 'stall' ? item.stallName : item.dishName)}}</text><text class="status-tag">{{item.status === 'pending' ? '旧投稿待处理' : (item.status === 'approved' ? '已发布' : '已退回')}}</text></view><text class="history-note">{{item.stallName}} · {{item.location}}</text><text class="history-note">{{item.reason || item.description}}</text><block wx:if="{{item.image}}"><text class="history-note">{{item.kind === 'dish' ? '菜品投稿图片' : (item.kind === 'stall' || item.kind === 'photo' ? '档口投稿图片' : '投稿图片（旧版未分类）')}}{{item.kind === 'photo' ? ' · 补图' : ''}}</text><image class="history-image" src="{{item.image}}" mode="aspectFill" /></block><view class="history-actions"><button wx:if="{{item.status === 'approved'}}" class="tech-control" data-id="{{item._id}}" bindtap="editSubmission" disabled="{{saving || uploading || !!deleting}}">修改 / 补图片</button><button class="tech-control" data-id="{{item._id}}" bindtap="deleteSubmission" loading="{{deleting === item._id}}" disabled="{{saving || uploading || !!deleting}}">删除我的投稿</button></view></view>
  <view class="campus-empty" wx:if="{{!submissions.length && !loading}}"><text>还没有投稿，分享你的第一份发现吧</text></view>
</view>

</mahiro-scroll>

</block>
