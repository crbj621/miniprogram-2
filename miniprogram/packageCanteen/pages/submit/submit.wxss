@import "../../../styles/campus-ui.wxss";
.submission-page { padding: 0 24rpx calc(32rpx + env(safe-area-inset-bottom)); }.campus-heading { padding-left: 0; padding-right: 0; }.submission-card { margin-bottom: 24rpx; padding: 26rpx; border-radius: 28rpx; background: #fff; border: 2rpx solid #e4e7d8; box-shadow: 0 6rpx 0 #e7eadd; }.field-label { display: block; font-size: 25rpx; font-weight: 650; margin: 18rpx 0 12rpx; }.field-input,.field-textarea { width: 100%; box-sizing: border-box; background: #f5f7ef; padding: 18rpx 20rpx; border-radius: 18rpx; min-height: 84rpx; font-size: 25rpx; }.field-textarea { height: 200rpx; }.photo-button.tech-control { margin: 24rpx 0; padding: 22rpx; width: 100%; font-size: 25rpx; background: #fff9dd; color: #8d8050; border: 2rpx dashed #dfd1a2; border-radius: 22rpx; }.photo-button image { display: block; width: 100%; height: 220rpx; border-radius: 18rpx; margin-bottom: 12rpx; }.submit-button.tech-control { margin-left: 0; margin-right: 0; width: 100%; background: #7aaa71; border-radius: 22rpx; color: #fff; border-bottom: 7rpx solid #57845c; font-size: 28rpx; font-weight: 700; }.history-heading,.history-title { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }.history-heading { font-size: 29rpx; font-weight: 700; margin: 32rpx 0 22rpx; }.history-heading button.tech-control { width: auto; margin: 0; font-size: 24rpx; padding: 0 20rpx; background: #fff; border-radius: 18rpx; }.history-title { font-size: 27rpx; font-weight: 650; }.status-tag { background: #eff5e7; padding: 8rpx 14rpx; border-radius: 14rpx; color: #728166; font-size: 21rpx; white-space: nowrap; }.history-note { display: block; font-size: 24rpx; color: #889078; line-height: 1.7; margin-top: 16rpx; }

.page-refresh-scroll { height: 100vh; display: block; }
.contribution-tabs { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10rpx; margin-bottom:24rpx; }
.contribution-tabs button.tech-control { width:100%; min-width:0; margin:0; min-height:44px; padding:14rpx 4rpx; font-size:24rpx; color:#889078; background:#eef3e7; border-radius:18rpx; }
.contribution-tabs .selected { background:#e0efdc !important; color:#527d53 !important; font-weight:700; }
.field-help,.match-note { display:block; font-size:23rpx; line-height:1.7; color:#829072; margin-top:14rpx; word-break:break-word; }
.match-note { padding:18rpx; border-radius:18rpx; background:#f4f8ee; }
.match-note button.tech-control,.cancel-edit.tech-control { width:100%; margin:12rpx 0 0; padding:14rpx; min-height:44px; font-size:23rpx; color:#658960; }
.history-image { display:block; width:100%; height:240rpx; margin-top:18rpx; border-radius:18rpx; }
.history-actions { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12rpx; margin-top:20rpx; }
.history-actions button.tech-control { width:100%; min-width:0; margin:0; padding:14rpx 4rpx; min-height:44px; font-size:23rpx; color:#658960; }
.history-title > text:first-child { min-width:0; word-break:break-word; }.field-input { line-height:1.6; }
.history-heading button.tech-control { min-height:44px; }

@import "../../../styles/tech-ui.wxss";
