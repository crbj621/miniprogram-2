<view class="container">
  <view class="loading-mask" wx:if="{{autoLogging}}">
    <view class="loading-content">
      <view class="loading-icon">🔄</view>
      <view class="loading-text">正在自动登录...</view>
    </view>
  </view>

  <view class="login-card tech-card" wx:if="{{!autoLogging && !showResetPassword}}">
    <view class="header">
      <view class="icon">🏪</view>
      <view class="title">商家管理后台</view>
      <view class="subtitle">登录管理您的店铺</view>
    </view>

    <view class="form">
      <view class="input-group">
        <view class="input-icon">👤</view>
        <input type="text" placeholder="请输入账号" value="{{username}}" bindinput="onUsernameInput" placeholder-style="color:#8597ad" class="tech-input" />
      </view>
      
      <view class="input-group">
        <view class="input-icon">🔑</view>
        <input type="password" placeholder="请输入密码" value="{{password}}" bindinput="onPasswordInput" placeholder-style="color:#8597ad" class="tech-input" />
      </view>

      <view class="forgot-row">
        <view class="forgot-link tap-action" bindtap="showResetPasswordPage" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">忘记密码？</view>
      </view>

      <button class="login-btn uiverse-sweep uiverse-sweep--tint tech-control tech-primary" bindtap="login" loading="{{loading}}" hover-class="uiverse-sweep-pressed tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100"><view class="uiverse-sweep-plane" />
        {{loading ? '登录中...' : '登录'}}
      </button>
    </view>

    <view class="register-link">
      <text>还没有账号？</text>
      <view class="link tap-action" bindtap="goToRegister" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">立即入驻</view>
    </view>
  </view>

  <view class="login-card tech-card" wx:if="{{showResetPassword}}">
    <view class="header">
      <view class="icon">🔐</view>
      <view class="title">重置密码</view>
      <view class="subtitle">验证手机号后重置密码</view>
    </view>

    <view class="form">
      <view class="input-group">
        <view class="input-icon">👤</view>
        <input type="text" placeholder="请输入账号" value="{{resetForm.username}}" bindinput="onResetUsernameInput" placeholder-style="color:#8597ad" class="tech-input" />
      </view>
      
      <view class="input-group">
        <view class="input-icon">📱</view>
        <input type="number" placeholder="请输入注册手机号" value="{{resetForm.phone}}" bindinput="onResetPhoneInput" placeholder-style="color:#8597ad" class="tech-input" />
      </view>

      <view class="input-group">
        <view class="input-icon">🔑</view>
        <input type="password" placeholder="新密码（至少8位）" value="{{resetForm.newPassword}}" bindinput="onResetPasswordInput" placeholder-style="color:#8597ad" class="tech-input" />
      </view>

      <view class="btn-row">
        <button class="cancel-btn tech-control" bindtap="hideResetPassword" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">返回登录</button>
        <button class="confirm-btn tech-control tech-primary" bindtap="resetPassword" loading="{{resetting}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">{{resetting ? '重置中...' : '确认重置'}}</button>
      </view>
    </view>
  </view>
</view>
