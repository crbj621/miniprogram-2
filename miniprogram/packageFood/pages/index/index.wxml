<view class="container">
  <view class="campus-heading"><view class="campus-heading-copy"><text class="campus-kicker">校园生活 · 好好吃饭</text><text class="campus-title">校园点餐</text><text class="campus-subtitle">热乎乎的一餐，给忙碌的自己</text></view><campus-sticker kind="food" /></view>
  <view class="header-actions"><button class="action-btn tech-control" bindtap="goToOrders" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">我的订单</button><button class="action-btn tech-control" bindtap="goToMine" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">点餐中心</button><button wx:if="{{riderEnabled}}" class="action-btn tech-control" bindtap="goToRider" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">骑手入口</button></view>
  <view class="search-bar">
    <view class="search-box">
      <view class="campus-search-icon"></view>
      <tech-search class="tech-search-host"><input type="text" placeholder="搜索商家或美食" bindconfirm="onSearch" value="{{keyword}}" bindinput="onSearchInput" placeholder-style="color:#8597ad" class="tech-input" /></tech-search>
    </view>
  </view>

  <view class="ranking-note">
    <text class="ranking-title">校园人气商家榜</text>
    <text class="ranking-desc">按本月已完成订单实时排名</text>
  </view>

  <mahiro-scroll id="page-refresh" class="shop-scroll" bindrefresh="refreshPage" bindmore="loadMore">
    <view class="shop-list">
      <view class="shop-item tech-card" wx:for="{{shops}}" wx:key="_id" bindtap="goToShop" data-id="{{item._id}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
        <view class="shop-left">
          <image wx:if="{{item.logo}}" class="shop-logo" src="{{item.logo}}" mode="aspectFill" lazy-load></image>
          <view wx:else class="shop-logo-placeholder"><campus-sticker kind="food" /></view>
        </view>
        <view class="shop-right">
          <view class="shop-header-row">
            <view class="shop-name-wrap">
              <text class="rank-badge">NO.{{item.campusRank}}</text>
              <text class="shop-name">{{item.name}}</text>
            </view>
            <view class="shop-status {{item.status === 'open' ? 'open' : 'closed'}}">{{item.status === 'open' ? '营业中' : '休息中'}}</view>
          </view>
          <view class="shop-stats">
            <text class="monthly-sales">月售{{item.monthlySales || 0}}单</text>
          </view>
          <view class="shop-meta">
            <text>起送¥{{item.minPrice || 0}}</text>
            <text class="divider">|</text>
            <text wx:if="{{item.supportDelivery !== false}}">配送¥{{item.deliveryFee || 0}}</text>
            <text wx:else>仅自取</text>
          </view>
          <view class="featured-dishes" wx:if="{{item.featuredDishes && item.featuredDishes.length > 0}}">
            <view class="featured-item" wx:for="{{item.featuredDishes}}" wx:for-item="dish" wx:key="_id">
              <image wx:if="{{dish.image}}" class="featured-img" src="{{dish.image}}" mode="aspectFill"></image>
              <view wx:else class="featured-img featured-placeholder">餐</view>
              <view class="featured-info">
                <text class="featured-name">{{dish.name}}</text>
                <text class="featured-price">¥{{dish.price}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      
      <view class="empty-state" wx:if="{{shops.length === 0 && !loading}}">
        <campus-sticker kind="food" /><text class="campus-empty-title">还没有商家入驻</text><text class="campus-empty-note">商家发布后，好吃的会出现在这里</text>
      </view>
      
      <view class="loading-tip" wx:if="{{loading}}">
        <tech-loader/><text>加载中...</text>
      </view>
      
      <view class="no-more" wx:if="{{!hasMore && shops.length > 0 && !loading}}">
        <text>没有更多了</text>
      </view>
    </view>
  </mahiro-scroll>
</view>
