@import "../../../styles/campus-ui.wxss";
.container { height: 100vh; min-height: 0; display: flex; flex-direction: column; align-items: stretch; justify-content: flex-start; padding: 0 0 calc(32rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #f2f6fa; }
.campus-heading { background: #edf2ff; border-radius: 0 0 36rpx 36rpx; padding: 32rpx 28rpx; }
.header-actions { display: flex; gap: 16rpx; padding: 24rpx 28rpx 0; }.action-btn { flex: 1; min-width: 0; min-height: 88rpx; margin: 0; padding: 0 8rpx; display: flex; align-items: center; justify-content: center; background: #fff; color: #617fb1; border: 2rpx solid #dce5f4; border-radius: 24rpx; font-size: 25rpx; line-height: 1.4; }
.search-bar { padding: 24rpx 28rpx; }.search-box { display: flex; align-items: center; background: #edf3f8; border-radius: 24rpx; padding: 0 24rpx; min-height: 88rpx; color: #8299ac; }.search-box input { flex: 1; min-width: 0; height: 88rpx; font-size: 26rpx; }
.ranking-note { display: flex; flex-direction: column; padding: 0 28rpx 20rpx; gap: 8rpx; }.ranking-title { font-size: 31rpx; font-weight: 700; }.ranking-desc { font-size: 23rpx; color: #7e94a6; }.shop-list { padding: 0 28rpx; }
.shop-item { display: flex; gap: 20rpx; padding: 24rpx; margin-bottom: 20rpx; background: #fff; border: 2rpx solid #dee8f0; border-radius: 28rpx; }.shop-left { flex-shrink: 0; }.shop-logo { width: 120rpx; height: 120rpx; background: #edf2fb; border-radius: 24rpx; }.shop-right { flex: 1; min-width: 0; }.shop-header-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; }.shop-name-wrap { display: flex; align-items: center; min-width: 0; width: 100%; gap: 10rpx; }.rank-badge { padding: 5rpx 8rpx; border-radius: 8rpx; color: #617fb1; background: #edf2ff; font-size: 19rpx; flex-shrink: 0; }.shop-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 29rpx; font-weight: 700; }.shop-status { font-size: 20rpx; padding: 5rpx 12rpx; border-radius: 12rpx; }.shop-status.open { background: #edf5e9; color: #48785c; }.shop-status.closed { background: #eef2f7; color: #8e9dad; }
.shop-stats { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; margin-top: 12rpx; }.monthly-sales { font-size: 22rpx; color: #7e94a6; }.shop-meta { display: flex; flex-wrap: wrap; margin-top: 12rpx; font-size: 23rpx; color: #7e94a6; }.divider { margin: 0 10rpx; color: #c1b4a6; }
.featured-dishes { display: flex; flex-wrap: wrap; gap: 10rpx; padding-top: 18rpx; margin-top: 18rpx; border-top: 2rpx dashed #eee4d8; }.featured-item { display: flex; align-items: center; gap: 10rpx; width: 100%; min-width: 0; padding: 10rpx; border-radius: 16rpx; background: #f2f6fa; box-sizing: border-box; }.featured-img { flex-shrink: 0; width: 68rpx; height: 68rpx; border-radius: 14rpx; }.featured-info { display: flex; flex-direction: column; min-width: 0; gap: 6rpx; }.featured-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 23rpx; }.featured-price { font-size: 23rpx; color: #b35b38; font-weight: 600; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 52rpx 24rpx; background: #ffffff; border: 2rpx dashed #dee8f0; border-radius: 28rpx; text-align: center; }.loading-tip,.no-more { text-align: center; padding: 32rpx; font-size: 24rpx; color: #7e94a6; }

.shop-scroll { flex: 1; min-height: 0; height: 0; }.campus-heading,.header-actions,.search-bar,.ranking-note { flex-shrink: 0; }.shop-logo-placeholder { width: 120rpx; height: 120rpx; display: flex; align-items: center; justify-content: center; }.featured-placeholder { display: flex; align-items: center; justify-content: center; background: #ffe5cf; color: #617fb1; font-size: 26rpx; }

@import "../../../styles/tech-ui.wxss";
