.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

.shop-info {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background-color: #fff;
  margin-bottom: 20rpx;
}

.shop-logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.shop-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.type-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.type-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f8f8;
  border-radius: 12rpx;
}

.type-content {
  margin-left: 16rpx;
}

.type-name {
  font-size: 28rpx;
  color: #333;
}

.type-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #666;
}

.form-item input, .form-item textarea {
  flex: 1;
  font-size: 28rpx;
}

.form-item textarea {
  height: 100rpx;
  background-color: #f8f8f8;
  padding: 16rpx;
  border-radius: 8rpx;
}

.picker {
  font-size: 28rpx;
  color: #333;
}

.order-items {
  border-bottom: 1rpx solid #f0f0f0;
  padding-bottom: 20rpx;
}

.order-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.item-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.item-count {
  font-size: 26rpx;
  color: #999;
  margin: 0 20rpx;
}

.item-price {
  font-size: 28rpx;
  color: #333;
}

.order-total {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
}

.order-total.discount {
  color: #ff9a9e;
}

.discount-price {
  font-weight: bold;
}

.order-total.final {
  margin-top: 10rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  color: #333;
  font-size: 30rpx;
  font-weight: bold;
}

.final-price {
  color: #ff4d4f;
  font-size: 36rpx;
}

.discount-options {
  margin-bottom: 20rpx;
}

.discount-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.discount-item:last-child {
  border-bottom: none;
}

.discount-info {
  display: flex;
  flex-direction: column;
}

.discount-info .title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.discount-info .desc {
  font-size: 24rpx;
  color: #999;
}

.remark-input {
  width: 100%;
  height: 150rpx;
  background-color: #f8f8f8;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.total-info {
  flex: 1;
}

.total-label {
  font-size: 28rpx;
  color: #666;
}

.total-amount {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.submit-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
}

.submit-btn.disabled {
  opacity: 0.6;
}

@import "../../../styles/tech-ui.wxss";
