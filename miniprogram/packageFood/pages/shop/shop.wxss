.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f6f6f6;
}

.banner-swiper {
  width: 100%;
  height: 280rpx;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.shop-header {
  background-color: #fff;
  padding: 24rpx;
  display: flex;
  align-items: center;
}

.shop-bg {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background-color: #eee;
  margin-right: 20rpx;
}

.shop-info {
  flex: 1;
}

.shop-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.shop-stats-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.star {
  color: #faad14;
  font-size: 24rpx;
}

.rating {
  color: #faad14;
  font-size: 24rpx;
  margin-left: 4rpx;
  font-weight: bold;
}

.monthly {
  font-size: 22rpx;
  color: #999;
  margin-left: 20rpx;
}

.shop-notice {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-nav {
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.category-scroll {
  white-space: nowrap;
}

.category-tabs {
  display: inline-flex;
  padding: 0 20rpx;
}

.tab-item {
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #faad14;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: #faad14;
  border-radius: 2rpx;
}

.menu-content {
  flex: 1;
  background-color: #fff;
  margin-top: 20rpx;
}

.category-section {
  padding-bottom: 20rpx;
}

.category-title {
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  background-color: #fafafa;
  position: sticky;
  top: 0;
  display: flex;
  align-items: center;
}

.title-text {
  font-weight: bold;
  color: #333;
}

.title-count {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

.dish-item {
  display: flex;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.dish-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background-color: #eee;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.dish-img-wrapper {
  width: 160rpx;
  height: 160rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.dish-img-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #faad14 0%, #ff7875 100%);
  display: flex;
  justify-content: center;
  align-items: center;
}

.placeholder-text {
  font-size: 48rpx;
  color: #fff;
  font-weight: bold;
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.dish-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: flex;
  align-items: center;
}

.signature-tag {
  font-size: 20rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-left: 10rpx;
  font-weight: normal;
}

.dish-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-sales {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.dish-action {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.dish-price {
  color: #ff4d4f;
  font-size: 32rpx;
  font-weight: bold;
}

.stepper {
  display: flex;
  align-items: center;
}

.minus, .plus {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 44rpx;
  font-size: 36rpx;
}

.minus {
  border: 1rpx solid #ddd;
  color: #999;
}

.plus {
  background-color: #faad14;
  color: #fff;
}

.count {
  margin: 0 20rpx;
  font-size: 28rpx;
  min-width: 40rpx;
  text-align: center;
}

.cart-bar {
  height: 100rpx;
  background-color: #333;
  display: flex;
  align-items: center;
  z-index: 100;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
}

.cart-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  position: relative;
  margin-top: -30rpx;
  margin-left: 30rpx;
  background-color: #333;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.cart-icon-wrapper.active {
  background-color: #faad14;
}

.cart-badge {
  position: absolute;
  top: 0;
  right: 0;
  background-color: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  min-width: 30rpx;
  text-align: center;
}

.cart-icon {
  font-size: 40rpx;
}

.cart-price {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
  color: #999;
}

.total-price {
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
}

.empty-tip {
  color: #999;
  font-size: 28rpx;
}

.delivery-tip {
  font-size: 20rpx;
}

.checkout-btn {
  width: 200rpx;
  height: 100%;
  background-color: #555;
  color: #999;
  text-align: center;
  line-height: 100rpx;
  font-size: 30rpx;
  font-weight: bold;
}

.checkout-btn.active {
  background-color: #faad14;
  color: #fff;
}

.cart-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 90;
}

.modal-mask {
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 100rpx;
  width: 100%;
  background-color: #fff;
  max-height: 60%;
  border-radius: 24rpx 24rpx 0 0;
}

.modal-header {
  padding: 24rpx 30rpx;
  background-color: #f8f8f8;
  display: flex;
  justify-content: space-between;
  border-radius: 24rpx 24rpx 0 0;
}

.clear-cart {
  color: #666;
  font-size: 24rpx;
}

.cart-list {
  padding: 0 30rpx;
  max-height: 600rpx;
}

.cart-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eee;
}

.cart-name {
  flex: 1;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-item .cart-price {
  width: 120rpx;
  color: #ff4d4f;
  font-weight: bold;
  text-align: right;
}

@import "../../../styles/tech-ui.wxss";
