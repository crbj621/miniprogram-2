<view class="container" wx:if="{{shop}}">
  <swiper class="banner-swiper" indicator-dots autoplay circular interval="3000" duration="500" wx:if="{{shop.banners && shop.banners.length > 0}}">
    <swiper-item wx:for="{{shop.banners}}" wx:key="*this">
      <image class="banner-img" src="{{item}}" mode="aspectFill" lazy-load></image>
    </swiper-item>
  </swiper>

  <view class="shop-header">
    <image class="shop-bg" src="{{shop.logo}}" mode="aspectFill" lazy-load></image>
    <view class="shop-info">
      <view class="shop-name">{{shop.name}}</view>
      <view class="shop-stats-row">
        <text class="star">★</text>
        <text class="rating">{{shop.rating || 5.0}}</text>
        <text class="monthly">月售{{shop.monthlySales || 0}}单</text>
      </view>
      <view class="shop-notice" wx:if="{{shop.notice}}">公告: {{shop.notice}}</view>
    </view>
  </view>

  <view class="category-nav" scroll-x>
    <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="category-tabs">
        <view class="tab-item {{currentCategory === -1 ? 'active' : ''}}" bindtap="switchCategory" data-index="{{-1}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">全部</view>
        <view class="tab-item {{currentCategory === index ? 'active' : ''}}" wx:for="{{menu}}" wx:key="name" bindtap="switchCategory" data-index="{{index}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">{{item.name}}</view>
      </view>
    </scroll-view>
  </view>

  <scroll-view scroll-y class="menu-content" scroll-into-view="{{scrollIntoView}}" enhanced>
    <view class="category-section" wx:for="{{menu}}" wx:for-item="category" wx:for-index="catIdx" wx:key="name" id="cat-{{catIdx}}">
      <view class="category-title">
        <text class="title-text">{{category.name}}</text>
        <text class="title-count">({{category.items.length}})</text>
      </view>
      <view class="dish-item" wx:for="{{category.items}}" wx:for-item="dish" wx:key="_id">
        <view class="dish-img-wrapper">
          <image class="dish-img" src="{{dish.image}}" mode="aspectFill" lazy-load binderror="onDishImageError" data-dish="{{dish}}" wx:if="{{dish.image}}"></image>
          <view class="dish-img-placeholder" wx:else>
            <text class="placeholder-text">{{dish.name[0]}}</text>
          </view>
        </view>
        <view class="dish-info">
          <view class="dish-name">
            {{dish.name}}
            <text class="signature-tag" wx:if="{{category.name === '店长推荐' || dish.isSignature}}">荐</text>
          </view>
          <view class="dish-desc" wx:if="{{dish.description}}">{{dish.description}}</view>
          <view class="dish-sales">月售 {{dish.sales || 0}}</view>
          <view class="dish-action">
            <text class="dish-price">¥{{dish.price}}</text>
            <view class="stepper">
              <view class="minus" catchtap="updateCart" data-dish="{{dish}}" data-action="minus" wx:if="{{cart[dish._id] > 0}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">-</view>
              <view class="count" wx:if="{{cart[dish._id] > 0}}">{{cart[dish._id]}}</view>
              <view class="plus" catchtap="updateCart" data-dish="{{dish}}" data-action="plus" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">+</view>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view style="height: 140rpx;"></view>
  </scroll-view>

  <view class="cart-bar" bindtap="showCartDetail" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
    <view class="cart-icon-wrapper {{totalCount > 0 ? 'active' : ''}}">
      <text class="cart-badge" wx:if="{{totalCount > 0}}">{{totalCount}}</text>
      <view class="cart-icon">🛒</view>
    </view>
    <view class="cart-price">
      <text class="total-price" wx:if="{{totalCount > 0}}">¥{{totalPrice}}</text>
      <text class="empty-tip" wx:else>未选购商品</text>
      <text class="delivery-tip">另需配送费 ¥{{shop.deliveryFee || 0}}</text>
    </view>
    <view class="checkout-btn {{totalPrice >= (shop.minPrice || 0) ? 'active' : ''}} tech-control" catchtap="goToCheckout" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
      {{totalPrice >= (shop.minPrice || 0) ? '去结算' : '¥' + (shop.minPrice || 0) + '起送'}}
    </view>
  </view>
  
  <view class="cart-modal" wx:if="{{showCartModal}}">
    <view class="modal-mask" bindtap="hideCartDetail" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100"></view>
    <view class="modal-content tech-card">
      <view class="modal-header">
        <text>购物车</text>
        <view class="clear-cart tap-action" bindtap="clearCart" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">清空</view>
      </view>
      <scroll-view scroll-y class="cart-list">
        <block wx:for="{{cartList}}" wx:key="_id">
          <view class="cart-item">
            <view class="cart-name">{{item.name}}</view>
            <view class="cart-price">¥{{item.price * item.count}}</view>
            <view class="stepper">
              <view class="minus" catchtap="updateCart" data-dish="{{item}}" data-action="minus" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">-</view>
              <view class="count">{{item.count}}</view>
              <view class="plus" catchtap="updateCart" data-dish="{{item}}" data-action="plus" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">+</view>
            </view>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>
</view>
