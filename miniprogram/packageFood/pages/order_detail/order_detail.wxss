.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

.status-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 30rpx;
  text-align: center;
  color: #fff;
}

.status-card.status-cancelled {
  background: linear-gradient(135deg, #999 0%, #666 100%);
}

.status-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.status-text {
  font-size: 32rpx;
  font-weight: bold;
}

.pickup-code {
  margin-top: 30rpx;
  font-size: 28rpx;
}

.code {
  font-size: 48rpx;
  font-weight: bold;
  letter-spacing: 8rpx;
}

.section {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
}

.label {
  color: #999;
}

.value {
  color: #333;
  max-width: 400rpx;
  text-align: right;
}

.shop-info {
  display: flex;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 16rpx;
}

.shop-logo {
  width: 60rpx;
  height: 60rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.shop-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.order-items {
  margin-bottom: 16rpx;
}

.item-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.item-name {
  flex: 1;
  color: #666;
}

.item-count {
  color: #999;
  margin: 0 20rpx;
}

.item-price {
  color: #333;
}

.order-total {
  display: flex;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}

.total-price {
  font-weight: bold;
  color: #ff4d4f;
  font-size: 32rpx;
}

.remark {
  font-size: 26rpx;
  color: #666;
  background-color: #f8f8f8;
  padding: 16rpx;
  border-radius: 8rpx;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background-color: #fff;
  display: flex;
  justify-content: center;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.btn {
  padding: 20rpx 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
}

.btn.cancel {
  background-color: #fff1f0;
  color: #ff4d4f;
}

@import "../../../styles/tech-ui.wxss";
