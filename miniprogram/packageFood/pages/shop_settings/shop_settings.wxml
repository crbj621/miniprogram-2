<view class="container" wx:if="{{shopInfo}}">
  <view class="section">
    <view class="section-title">店铺头像</view>
    <view class="logo-section">
      <view class="logo-upload" bindtap="chooseLogo" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
        <image wx:if="{{shopInfo.logo}}" src="{{shopInfo.logo}}" mode="aspectFill" class="logo-img"></image>
        <view wx:else class="logo-placeholder">
          <text class="logo-icon">🏪</text>
          <text class="logo-text">{{uploadingLogo ? '上传中...' : '点击上传'}}</text>
        </view>
      </view>
      <text class="logo-tip">建议尺寸: 200x200px</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">基本信息</view>
    
    <view class="form-item">
      <text class="form-label">店铺名称</text>
      <input class="form-input tech-input" placeholder="请输入店铺名称" value="{{form.name}}" data-field="name" bindinput="onInputChange" placeholder-style="color:#8597ad" />
    </view>

    <view class="form-item">
      <text class="form-label">营业状态</text>
      <view class="switch-row">
        <text class="switch-label">{{form.status === 'open' ? '营业中' : '休息中'}}</text>
        <tech-switch checked="{{form.status === 'open'}}" bindchange="onStatusChange" />
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">店铺公告</text>
      <textarea class="form-textarea tech-input" placeholder="请输入店铺公告（选填）" value="{{form.notice}}" data-field="notice" bindinput="onInputChange" placeholder-style="color:#8597ad"></textarea>
    </view>
  </view>

  <view class="section">
    <view class="section-title">配送设置</view>
    
    <view class="form-item">
      <text class="form-label">是否支持配送</text>
      <view class="switch-row">
        <text class="switch-label">{{form.supportDelivery ? '支持配送' : '仅自取'}}</text>
        <tech-switch checked="{{form.supportDelivery}}" bindchange="onDeliveryChange" />
      </view>
    </view>

    <view wx:if="{{form.supportDelivery}}">
      <view class="form-item">
        <text class="form-label">起送价格</text>
        <view class="input-with-unit">
          <input class="form-input tech-input" type="digit" placeholder="0" value="{{form.minPrice}}" data-field="minPrice" bindinput="onInputChange" placeholder-style="color:#8597ad" />
          <text class="unit">元</text>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">配送费</text>
        <view class="input-with-unit">
          <input class="form-input tech-input" type="digit" placeholder="0" value="{{form.deliveryFee}}" data-field="deliveryFee" bindinput="onInputChange" placeholder-style="color:#8597ad" />
          <text class="unit">元</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">店铺信息</view>
    <view class="info-row">
      <text class="info-label">店铺ID</text>
      <text class="info-value">{{shopInfo._id}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">入驻时间</text>
      <text class="info-value">{{shopInfo.createTimeText || '-'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">店铺评分</text>
      <text class="info-value rating">{{shopInfo.rating || 5.0}} ⭐</text>
    </view>
    <view class="info-row">
      <text class="info-label">月销量</text>
      <text class="info-value">{{shopInfo.monthlySales || 0}} 单</text>
    </view>
  </view>

  <view class="save-btn {{loading ? 'disabled' : ''}} tech-control tech-primary" bindtap="saveSettings" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
    {{loading ? '保存中...' : '保存设置'}}
  </view>
</view>
