.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
}

.add-btn {
  display: flex;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.2);
  padding: 16rpx 32rpx;
  border-radius: 30rpx;
  color: #fff;
  font-size: 28rpx;
}

.featured-tip {
  display: flex;
  align-items: center;
  background-color: #fffbe6;
  padding: 20rpx 30rpx;
  margin: 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #d48806;
}

.tip-icon {
  margin-right: 10rpx;
}

.dish-list {
  flex: 1;
  padding: 20rpx;
}

.dish-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.dish-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.dish-info {
  flex: 1;
  min-width: 0;
}

.dish-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
}

.featured-tag {
  font-size: 20rpx;
  color: #ff4d4f;
  background-color: #fff1f0;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  margin-left: 10rpx;
}

.dish-meta {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.dish-price {
  color: #ff4d4f;
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.dish-category {
  font-size: 22rpx;
  color: #667eea;
  background-color: #f0f2ff;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.dish-stock {
  font-size: 22rpx;
  color: #999;
}

.dish-actions {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
  align-items: flex-end;
}

.action-btn {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  margin-bottom: 10rpx;
}

.action-btn:last-child {
  margin-bottom: 0;
}

.action-btn.on {
  background-color: #e6f7ff;
  color: #1890ff;
}

.action-btn.off {
  background-color: #fff1f0;
  color: #ff4d4f;
}

.action-btn.feature {
  background-color: #f6ffed;
  color: #52c41a;
}

.action-btn.featured {
  background-color: #fff7e6;
  color: #fa8c16;
}

.action-btn.edit {
  background-color: #e6f7ff;
  color: #1890ff;
}

.action-btn.delete {
  background-color: #fff1f0;
  color: #ff4d4f;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.modal-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  max-height: 85vh;
  background-color: #fff;
  border-radius: 24rpx;
  z-index: 101;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  flex: 1;
  padding: 30rpx;
  max-height: 60vh;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item.half {
  flex: 1;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.required {
  color: #ff4d4f;
}

.form-input {
  width: 100%;
  background-color: #f5f5f5;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-input.large {
  padding: 30rpx 24rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.form-textarea {
  width: 100%;
  height: 150rpx;
  background-color: #f5f5f5;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.input-with-unit {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding-right: 24rpx;
}

.input-with-unit .form-input {
  background-color: transparent;
  flex: 1;
}

.unit {
  color: #999;
  font-size: 26rpx;
}

.image-upload {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #f5f5f5;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.upload-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
}

.modal-footer {
  display: flex;
  padding: 30rpx;
  gap: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.cancel-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  background-color: #f5f5f5;
  color: #666;
}

.cancel-btn::after {
  border: none;
}

.confirm-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.confirm-btn::after {
  border: none;
}

@import "../../../styles/tech-ui.wxss";
