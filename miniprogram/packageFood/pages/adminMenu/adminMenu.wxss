@import "../../../styles/admin-ui.wxss";
.page {
  min-height: 100vh;
  background: #f2f6fa;
  padding: 30rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.header .add-btn {
  width: auto;
  margin: 0;
  background: #6083c7;
  color: #fff;
  padding: 16rpx 32rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.menu-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f2f6fa;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f2f6fa;
}

.menu-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.menu-name {
  overflow-wrap: break-word;
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.menu-price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.menu-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.menu-original-price {
  font-size: 24rpx;
  color: #81756c;
  text-decoration: line-through;
}

.menu-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
}

.menu-stock, .menu-sales {
  font-size: 24rpx;
  color: #81756c;
}

.menu-status {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
}

.menu-status.on {
  background: rgba(82, 196, 26, 0.1);
  color: #52c41a;
}

.menu-status.off {
  background: rgba(153, 153, 153, 0.1);
  color: #81756c;
}

.menu-actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.menu-actions .action-btn {
  width: auto;
  margin: 0;
  font-size: 26rpx;
  color: #6083c7;
}

.action-btn.delete {
  color: #ff4d4f;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
}

.empty-text {
  color: #81756c;
  font-size: 28rpx;
}

.loading {
  text-align: center;
  padding: 50rpx 0;
  color: #81756c;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.modal-wrap {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  box-sizing: border-box;
  z-index: 101;
}

.modal {
  width: 100%;
  max-width: 650rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 20rpx;
  z-index: 101;
  display: flex;
  flex-direction: column;
}

.modal-header {
  flex-shrink: 0;
  padding: 30rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  border-bottom: 1rpx solid #f2f6fa;
}

.modal-body {
  flex: 1;
  min-height: 0;
  height: 55vh;
  box-sizing: border-box;
  padding: 30rpx;
  max-height: 55vh;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item.half {
  flex: 1;
  min-width: 0;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f2f6fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  background: #f2f6fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  color: #333;
}

.form-textarea {
  width: 100%;
  height: 150rpx;
  background: #f2f6fa;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.switch-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.switch-item .form-label {
  margin-bottom: 0;
}

.modal-footer {
  flex-shrink: 0;
  display: flex;
  border-top: 1rpx solid #f2f6fa;
}

.modal-footer .modal-btn {
  width: auto;
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 30rpx;
  text-align: center;
  font-size: 30rpx;
}

.modal-btn.cancel {
  color: #81756c;
  border-right: 1rpx solid #f2f6fa;
}

.modal-btn.confirm {
  color: #6083c7;
  font-weight: bold;
}

.page-refresh-scroll { display: block; height: 100vh; }.shop-picker { margin: 20rpx 28rpx; border-radius: 24rpx; background: #fff; padding: 24rpx; font-size: 27rpx; color: #6083c7; }.dish-photo { width: 180rpx; height: 180rpx; margin-top: 16rpx; border-radius: 24rpx; }.action-btn { min-height: 72rpx; margin: 0; display: flex; align-items: center; justify-content: center; }.loading { display: flex; align-items: center; justify-content: center; gap: 16rpx; }

.form-item button.tech-control { width: 100%; margin-left: 0; margin-right: 0; }

.page { box-sizing: border-box; }.modal-btn.confirm { background: #6083c7; color: #fff; }.form-input,.form-textarea { border: 2rpx solid #e1e7f2; border-radius: 20rpx; background: #f7f9fd; }.modal-footer { padding: 12rpx; gap: 12rpx; }.modal-btn { border-radius: 20rpx; font-size: 28rpx; padding: 20rpx 12rpx; }

@import "../../../styles/tech-ui.wxss";
