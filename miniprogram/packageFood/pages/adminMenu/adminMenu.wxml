<mahiro-scroll id="page-refresh" class="page-refresh-scroll" bindrefresh="refreshPage"><view class="page">
  <view class="header"><text class="title">点餐菜品小站</text><button class="add-btn tech-control" bindtap="showAddModal" disabled="{{!shopId}}" hover-class="tap-feedback tech-pressed">＋ 添加</button></view>
  <picker range="{{shops}}" range-key="name" value="{{shopIndex}}" bindchange="chooseShop" disabled="{{saving || uploading}}"><view class="shop-picker">{{shops.length ? shops[shopIndex].name : '请先添加点餐商家'}} ▾</view></picker>
  <view class="menu-list"><view class="menu-item" wx:for="{{menus}}" wx:key="_id"><image wx:if="{{item.image}}" class="menu-image" src="{{item.image}}" mode="aspectFill" /><view wx:else class="menu-image image-placeholder">餐</view><view class="menu-info"><text class="menu-name">{{item.name}}</text><view class="menu-price-row"><text class="menu-price">￥{{item.price}}</text></view><view class="menu-meta"><text class="menu-stock">库存 {{item.stock}}</text><text class="menu-sales">销量 {{item.sales || 0}}</text></view></view><view class="menu-status {{item.isAvailable ? 'on' : 'off'}}">{{item.isAvailable ? '上架' : '下架'}}</view><view class="menu-actions"><button class="action-btn tech-control" bindtap="editMenu" data-item="{{item}}" disabled="{{saving}}" hover-class="tap-feedback tech-pressed">编辑</button><button class="action-btn delete tech-control tech-danger" bindtap="deleteMenu" data-id="{{item._id}}" disabled="{{saving}}" hover-class="tap-feedback tech-pressed">删除</button></view></view></view>
  <view class="empty" wx:if="{{!menus.length && !loading}}"><text class="empty-text">这家店还没有菜品 ✦</text></view><view class="loading" wx:if="{{loading}}"><view class="uiverse-dots"><view class="uiverse-dot" /><view class="uiverse-dot" /><view class="uiverse-dot" /></view>正在整理菜单…</view>
  <view class="modal-mask" wx:if="{{showAddModal}}" bindtap="hideModal" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100" />
  <view class="modal tech-card" wx:if="{{showAddModal}}"><view class="modal-header">{{editingId ? '编辑这道菜' : '新增一道好吃的'}}</view><scroll-view scroll-y class="modal-body">
    <view class="form-item"><text class="form-label">菜品名称 *</text><input class="form-input tech-input" value="{{formData.name}}" data-field="name" bindinput="onInputChange" placeholder="例如番茄炒蛋" placeholder-style="color:#8597ad" /></view>
    <view class="form-item"><text class="form-label">价格 *</text><input class="form-input tech-input" type="digit" value="{{formData.price}}" data-field="price" bindinput="onInputChange" placeholder="价格（元）" placeholder-style="color:#8597ad" /></view>
    <view class="form-item"><text class="form-label">分类</text><input class="form-input tech-input" value="{{formData.category}}" data-field="category" bindinput="onInputChange" placeholder="例如家常菜" placeholder-style="color:#8597ad" /></view>
    <view class="form-item"><text class="form-label">库存（0 表示售罄）</text><input class="form-input tech-input" type="number" value="{{formData.stock}}" data-field="stock" bindinput="onInputChange" placeholder-style="color:#8597ad" /></view>
    <view class="form-item"><text class="form-label">描述</text><textarea class="form-textarea tech-input" value="{{formData.description}}" data-field="description" bindinput="onInputChange" placeholder="介绍一下味道和份量" placeholder-style="color:#8597ad" /></view>
    <view class="form-item"><button bindtap="chooseImage" loading="{{uploading}}" disabled="{{uploading || saving}}" hover-class="tap-feedback tech-pressed" class="tech-control">{{formData.image ? '更换照片' : '拍摄或选择照片'}}</button><image wx:if="{{formData.image}}" class="dish-photo" src="{{formData.image}}" mode="aspectFill" /></view>
    <view class="form-item switch-item"><text class="form-label">上架给同学</text><tech-switch checked="{{formData.isAvailable}}" bindchange="onSwitchChange" /></view>
  </scroll-view><view class="modal-footer"><button class="modal-btn cancel tech-control" bindtap="hideModal" disabled="{{saving || uploading}}" hover-class="tap-feedback tech-pressed">取消</button><button class="modal-btn confirm uiverse-sweep uiverse-sweep--tint tech-control tech-primary" bindtap="submitForm" loading="{{saving}}" disabled="{{saving || uploading}}" hover-class="uiverse-sweep-pressed tap-feedback tech-pressed"><view class="uiverse-sweep-plane" />保存菜品</button></view></view>
</view></mahiro-scroll>
