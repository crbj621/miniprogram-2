@import "../../../styles/admin-ui.wxss";
.page {
  min-height: 100vh;
  background: #f2f6fa;
  padding: 30rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.filter-btn {
  background: #fff;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666;
}

.order-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.order-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f2f6fa;
}

.order-item:last-child {
  border-bottom: none;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.order-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.order-status.warning {
  background: rgba(250, 173, 20, 0.1);
  color: #faad14;
}

.order-status.success {
  background: rgba(82, 196, 26, 0.1);
  color: #52c41a;
}

.order-status.danger {
  background: rgba(255, 77, 79, 0.1);
  color: #ff4d4f;
}

.order-status.info {
  background: rgba(24, 144, 255, 0.1);
  color: #1890ff;
}

.order-info {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.info-label {
  color: #81756c;
}

.order-items {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.items-label {
  color: #81756c;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.order-time {
  font-size: 24rpx;
  color: #81756c;
}

.order-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.order-actions .action-btn {
  width: auto;
  min-width: 0;
  margin: 0;
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #6083c7;
  color: #fff;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.action-btn.cancel {
  background: #f2f6fa;
  color: #81756c;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
}

.empty-text {
  color: #81756c;
  font-size: 28rpx;
}

.loading {
  text-align: center;
  padding: 50rpx 0;
  color: #81756c;
}

.page-refresh-scroll { display: block; height: 100vh; }.shop-picker { margin: 20rpx 28rpx; border-radius: 24rpx; background: #fff; padding: 24rpx; font-size: 27rpx; color: #6083c7; }.dish-photo { width: 180rpx; height: 180rpx; margin-top: 16rpx; border-radius: 24rpx; }.action-btn { min-height: 72rpx; margin: 0; display: flex; align-items: center; justify-content: center; }.loading { display: flex; align-items: center; justify-content: center; gap: 16rpx; }

.page { box-sizing: border-box; }.modal-btn.confirm { background: #6083c7; color: #fff; }.form-input,.form-textarea { border: 2rpx solid #e1e7f2; border-radius: 20rpx; background: #f7f9fd; }.modal-footer { padding: 12rpx; gap: 12rpx; }.modal-btn { border-radius: 20rpx; font-size: 28rpx; padding: 20rpx 12rpx; }

@import "../../../styles/tech-ui.wxss";
