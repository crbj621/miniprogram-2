<share-intro wx:if="{{__sharePublic}}" title="{{__shareTitle}}" path="{{__sharePath}}" /><block wx:else>
<mahiro-scroll id="page-refresh" class="page-refresh-scroll" bindrefresh="refreshPage" bindmore="loadMore"><view class="page">
  <view class="header"><text class="title">订单处理小站</text><picker range="{{['全部状态','待接单','制作中','待取餐 / 配送','已完成','已取消']}}" value="{{statusIndex}}" bindchange="onStatusChange"><view class="filter-btn">筛选状态 ▾</view></picker></view>
  <view class="order-list"><view class="order-item" wx:for="{{orders}}" wx:key="_id">
    <view class="order-header"><text class="order-no">{{item.orderNo || item._id}}</text><text class="order-status {{item.status === 'cancelled' ? 'danger' : 'info'}}">{{item.status === 'pending' ? '待接单' : (item.status === 'processing' ? '制作中' : (item.status === 'ready' ? '待取餐 / 配送' : (item.status === 'completed' ? '已完成' : '已取消')))}}</text></view>
    <view class="order-info"><text class="info-label">同学：</text><text class="info-value">{{item.userName}} {{item.userPhone}}</text></view>
    <view class="order-items"><text class="items-value">{{item.itemsText}}</text></view><view class="order-footer"><view class="order-price">￥{{item.totalPrice}}</view><view class="order-time">{{item.createTimeText}}</view></view>
    <view class="order-actions" wx:if="{{item.status === 'pending' || item.status === 'processing'}}"><button class="action-btn tech-control" bindtap="updateOrderStatus" data-id="{{item._id}}" data-status="{{item.status === 'pending' ? 'processing' : 'ready'}}" loading="{{updating}}" disabled="{{updating}}" hover-class="tap-feedback tech-pressed">{{item.status === 'pending' ? '接单制作' : '制作完成'}}</button><button class="action-btn cancel tech-control" bindtap="updateOrderStatus" data-id="{{item._id}}" data-status="cancelled" disabled="{{updating}}" hover-class="tap-feedback tech-pressed">取消订单</button></view>
    <view class="order-actions" wx:if="{{item.status === 'ready' && item.type === 'pickup'}}"><button class="action-btn tech-control" bindtap="updateOrderStatus" data-id="{{item._id}}" data-status="completed" disabled="{{updating}}" hover-class="tap-feedback tech-pressed">确认取餐</button></view><text class="info-label" wx:if="{{item.status === 'ready' && item.type === 'delivery'}}">配送订单由骑手确认送达</text>
  </view></view><view class="empty" wx:if="{{!orders.length && !loading}}"><text class="empty-text">暂时没有这类订单 ✦</text></view><view class="loading" wx:if="{{loading}}"><view class="uiverse-dots"><view class="uiverse-dot" /><view class="uiverse-dot" /><view class="uiverse-dot" /></view>正在整理订单…</view>
</view></mahiro-scroll>

</block>
