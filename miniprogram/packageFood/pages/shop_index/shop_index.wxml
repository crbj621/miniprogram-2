<view class="container">
  <view class="header">
    <view class="header-top">
      <view class="shop-info">
        <image wx:if="{{shopInfo.logo}}" class="shop-logo" src="{{shopInfo.logo}}" mode="aspectFill"></image><view wx:else class="shop-logo image-placeholder">餐</view>
        <view class="shop-text">
          <view class="shop-name">{{shopInfo.name || '我的店铺'}}</view>
          <view class="shop-status {{shopInfo.status === 'open' ? 'open' : 'closed'}}">
            {{shopInfo.status === 'open' ? '营业中' : '休息中'}}
          </view>
        </view>
      </view>
      <view class="header-actions">
        <view class="action-item" bindtap="goToDishManage" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
          <text class="action-icon">🍽️</text>
          <text class="action-text">菜品</text>
        </view>
        <view class="action-item" bindtap="goToSettings" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
          <text class="action-icon">⚙️</text>
          <text class="action-text">设置</text>
        </view>
        <view class="action-item" bindtap="logout" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
          <text class="action-icon">🚪</text>
          <text class="action-text">退出</text>
        </view>
      </view>
    </view>
  </view>

  <view class="stats-row">
    <view class="stat-card pending tech-card">
      <view class="stat-num">{{stats.pending}}</view>
      <view class="stat-label">待处理</view>
    </view>
    <view class="stat-card processing tech-card">
      <view class="stat-num">{{stats.processing}}</view>
      <view class="stat-label">进行中</view>
    </view>
    <view class="stat-card ready tech-card">
      <view class="stat-num">{{stats.ready}}</view>
      <view class="stat-label">已出餐</view>
    </view>
    <view class="stat-card sales tech-card">
      <view class="stat-num">¥{{stats.todaySales}}</view>
      <view class="stat-label">今日营业额</view>
    </view>
  </view>

  <view class="tabs">
    <view class="tab {{currentTab === 'pending' ? 'active' : ''}}" bindtap="switchTab" data-status="pending" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
      待处理
      <view class="badge" wx:if="{{stats.pending > 0}}">{{stats.pending}}</view>
    </view>
    <view class="tab {{currentTab === 'processing' ? 'active' : ''}}" bindtap="switchTab" data-status="processing" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">进行中</view>
    <view class="tab {{currentTab === 'ready' ? 'active' : ''}}" bindtap="switchTab" data-status="ready" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">已出餐</view>
    <view class="tab {{currentTab === 'completed' ? 'active' : ''}}" bindtap="switchTab" data-status="completed" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">已完成</view>
  </view>

  <scroll-view scroll-y class="order-list">
    <view class="order-item" wx:for="{{orders}}" wx:key="_id">
      <view class="order-header">
        <view class="order-left">
          <text class="order-type {{item.type}}">{{item.type === 'pickup' ? '自提' : '外卖'}}</text>
          <text class="order-time">{{item.createTimeText}}</text>
        </view>
        <view class="order-price">¥{{item.totalPrice}}</view>
      </view>

      <view class="user-info-section">
        <image wx:if="{{item.userAvatarUrl}}" class="user-avatar" src="{{item.userAvatarUrl}}" mode="aspectFill"></image><view wx:else class="user-avatar image-placeholder">同</view>
        <view class="user-details">
          <view class="user-name">{{item.userNickName || '用户'}}</view>
          <view class="user-phone">📞 {{item.phone}}</view>
        </view>
      </view>
      
      <view class="order-info" wx:if="{{item.type === 'pickup'}}">
        <view class="pickup-code">
          <text class="code-label">取餐码</text>
          <text class="code-num">{{item.pickupCode}}</text>
        </view>
      </view>

      <view class="order-info" wx:if="{{item.type === 'delivery'}}">
        <view class="info-row">
          <text class="info-label">📍 地址：</text>
          <text>{{item.address}}</text>
        </view>
      </view>

      <view class="order-dishes">
        <view class="dish-row" wx:for="{{item.items}}" wx:for-item="dish" wx:key="_id">
          <text class="dish-name">{{dish.name}}</text>
          <text class="dish-count">x{{dish.count}}</text>
        </view>
      </view>

      <view class="order-remark" wx:if="{{item.remark}}">
        <text class="remark-label">备注：</text>
        <text>{{item.remark}}</text>
      </view>

      <view class="order-actions" wx:if="{{item.status === 'pending'}}">
        <view class="btn reject tech-control tech-danger" catchtap="rejectOrder" data-id="{{item._id}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">拒单</view>
        <view class="btn accept tech-control" catchtap="acceptOrder" data-id="{{item._id}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">接单</view>
      </view>

      <view class="order-actions" wx:if="{{item.status === 'processing'}}">
        <view class="btn primary tech-control tech-primary" catchtap="readyOrder" data-id="{{item._id}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
          {{item.type === 'pickup' ? '通知取餐' : '出餐完成，进入骑手大厅'}}
        </view>
      </view>

      <view class="order-actions" wx:if="{{item.status === 'ready' && item.type === 'pickup'}}">
        <view class="btn success tech-control" catchtap="completeOrder" data-id="{{item._id}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
          确认已取餐
        </view>
      </view>
      <view class="order-actions" wx:if="{{item.status === 'ready' && item.type === 'delivery'}}">
        <view class="delivery-waiting">
          {{item.riderOpenid ? ('骑手 ' + (item.riderName || '') + ' 正在配送') : '等待审核通过的校园骑手接单'}}
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{orders.length === 0}}">
      <view class="empty-icon">📭</view>
      <view class="empty-text">暂无订单</view>
    </view>
  </scroll-view>
</view>
