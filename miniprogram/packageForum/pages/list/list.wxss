.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 12% 20%, rgba(255, 196, 222, 0.28), transparent 26%),
    linear-gradient(180deg, #fff7fc 0%, #f8f6ff 100%);
  display: flex;
  flex-direction: column;
}

.header {
  position: relative;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100%;
  background: linear-gradient(135deg, #fff0f8 0%, #f2eeff 56%, #eaf5ff 100%);
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 24rpx 30rpx;
  padding-top: calc(60rpx + env(safe-area-inset-top));
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(82, 57, 108, 0.1);
}

.back-icon {
  font-size: 32rpx;
  color: #67577a;
}

.header-title {
  flex: 1;
  text-align: center;
}

.title-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #493257;
}

.header-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(82, 57, 108, 0.1);
}

.action-icon {
  font-size: 28rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(82, 57, 108, 0.08);
  gap: 12rpx;
}

.search-icon {
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
  color: #333333;
}

.search-placeholder {
  color: #cccccc;
}

.search-btn {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #ff7eb4 0%, #9c83ff 100%);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 600;
}

.filter-section {
  padding: 16rpx 24rpx;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  margin-top: -16rpx;
  position: relative;
  z-index: 2;
}

.filter-tabs {
  display: flex;
  gap: 20rpx;
}

.filter-tab {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  background: #f8f8f8;
  transition: all 0.3s;
}

.filter-tab.active {
  background: linear-gradient(135deg, #ff7eb4 0%, #9c83ff 100%);
}

.tab-icon {
  font-size: 26rpx;
}

.tab-name {
  font-size: 26rpx;
  color: #666666;
}

.filter-tab.active .tab-name {
  color: #ffffff;
  font-weight: 600;
}

.post-scroll {
  flex: 1;
  background: #ffffff;
}

.post-list {
  padding: 20rpx 24rpx;
}

.post-card {
  background: rgba(255, 255, 255, 0.96);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 12rpx 36rpx rgba(72, 48, 93, 0.08);
  border: 2rpx solid #f0e9f6;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.post-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  border: 4rpx solid #f1e9fa;
}

.post-author-info {
  flex: 1;
}

.post-author-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.post-time {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
}

.post-badges {
  display: flex;
  gap: 8rpx;
}

.badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.badge.top {
  background: linear-gradient(135deg, #ff6b6b 0%, #feca57 100%);
  color: #ffffff;
}

.badge.essence {
  background: linear-gradient(135deg, #f5a623 0%, #f8e71c 100%);
  color: #ffffff;
}

.post-body {
  margin-bottom: 16rpx;
}

.post-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.post-content {
  display: block;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-images {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  position: relative;
}

.post-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.post-img.single {
  width: 320rpx;
  height: 240rpx;
}

.img-more {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 200rpx;
  height: 200rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 32rpx;
}

.post-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 2rpx dashed #eee5f4;
}

.post-category-tag {
  background: #faf5ff;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #765f83;
}

.post-stats {
  display: flex;
  gap: 24rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.stat-icon {
  font-size: 26rpx;
}

.stat-num {
  font-size: 24rpx;
  color: #999999;
}

.load-status {
  text-align: center;
  padding: 30rpx;
  color: #999999;
  font-size: 26rpx;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.loading-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid #eee9f8;
  border-top-color: #8b7cff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666666;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #999999;
}

.fab-btn {
  position: fixed;
  right: 30rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #ff6fae 0%, #8b7cff 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 34rpx rgba(139, 124, 255, 0.34);
  z-index: 100;
}

.fab-icon {
  font-size: 44rpx;
}

.comment-card {
  border-color: #eadffc;
  background: linear-gradient(155deg, #ffffff 0%, #fff8fc 100%);
}

.comment-kicker {
  width: fit-content;
  padding: 6rpx 14rpx;
  margin-bottom: 10rpx;
  border-radius: 999rpx;
  color: #7a65d8;
  background: #f0ebff;
  font-size: 21rpx;
  font-weight: 700;
}

.comment-link {
  color: #8b7cff;
  font-size: 24rpx;
  font-weight: 700;
}

.comment-link.disabled {
  color: #aaa0b1;
}

@import "../../../styles/tech-ui.wxss";
