<share-intro wx:if="{{__sharePublic}}" title="{{__shareTitle}}" path="{{__sharePath}}" /><block wx:else>
<view class="page">
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="header-top">
        <view class="back-btn tech-control" bindtap="goBack" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
          <text class="back-icon">←</text>
        </view>
        <view class="header-title">
          <text class="title-text">消息通知</text>
        </view>
        <view class="header-actions">
          <view class="action-btn tech-control" bindtap="markAllRead" wx:if="{{unreadCount > 0}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
            <text class="action-text">全部已读</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="notification-list">
    <view class="notification-item {{item.isRead ? 'read' : 'unread'}}" 
      wx:for="{{notifications}}" 
      wx:key="_id" 
      bindtap="goToPost" 
      data-id="{{item.postId}}"
      data-notification-id="{{item._id}}"
     hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
      <view class="notification-icon">
        <text wx:if="{{item.type === 'comment'}}">💬</text>
        <text wx:else>↩️</text>
      </view>
      <view class="notification-content">
        <view class="notification-title">
          <text wx:if="{{item.type === 'comment'}}">有人评论了你的动态</text>
          <text wx:else>有人回复了你的评论</text>
        </view>
        <view class="notification-post">《{{item.postTitle}}》</view>
        <view class="notification-preview">{{item.commentContent}}...</view>
        <view class="notification-time">{{item.createTimeText}}</view>
      </view>
      <view class="notification-dot" wx:if="{{!item.isRead}}"></view>
    </view>

    <view class="empty-state" wx:if="{{notifications.length === 0 && !loading}}">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无消息通知</text>
      <text class="empty-tip">有人回复你时会在这里提醒</text>
    </view>

    <view class="loading-state" wx:if="{{loading}}">
      <text class="loading-text">加载中...</text>
    </view>

    <view class="no-more" wx:if="{{!hasMore && notifications.length > 0}}">
      <text>— 没有更多了 —</text>
    </view>
  </view>
</view>

</block>
