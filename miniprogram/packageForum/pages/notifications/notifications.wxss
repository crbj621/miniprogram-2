.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff5f5 0%, #fffaf0 50%, #f5fffa 100%);
  display: flex;
  flex-direction: column;
}

.header {
  position: relative;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100%;
  background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
}

.header-content {
  position: relative;
  z-index: 1;
  padding: 24rpx 30rpx;
  padding-top: calc(60rpx + env(safe-area-inset-top));
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(139, 69, 19, 0.15);
}

.back-icon {
  font-size: 32rpx;
  color: #8b4513;
}

.header-title {
  flex: 1;
  text-align: center;
}

.title-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #8b4513;
}

.header-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(139, 69, 19, 0.15);
}

.action-text {
  font-size: 24rpx;
  color: #8b4513;
}

.notification-list {
  flex: 1;
  padding: 20rpx 24rpx;
}

.notification-item {
  display: flex;
  align-items: flex-start;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(139, 69, 19, 0.08);
  border: 1rpx solid #f5e6d3;
  position: relative;
}

.notification-item.unread {
  background: #fffaf5;
  border-left: 6rpx solid #f5a623;
}

.notification-icon {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.notification-content {
  flex: 1;
  min-width: 0;
}

.notification-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.notification-post {
  font-size: 26rpx;
  color: #8b4513;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notification-preview {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.notification-time {
  font-size: 22rpx;
  color: #999999;
}

.notification-dot {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 16rpx;
  height: 16rpx;
  background: #ff6b6b;
  border-radius: 50%;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666666;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #999999;
}

.loading-state {
  text-align: center;
  padding: 40rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}

.no-more {
  text-align: center;
  padding: 30rpx;
  color: #999999;
  font-size: 26rpx;
}

@import "../../../styles/tech-ui.wxss";
