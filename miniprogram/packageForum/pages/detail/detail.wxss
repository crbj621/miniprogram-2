page { height: 100%; overflow: hidden; }

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, #FFF5F5 0%, #FFFAF0 100%);
}

.header {
  position: relative;
  flex-shrink: 0;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 280rpx;
  background: linear-gradient(135deg, #FFB6C1 0%, #FFDAB9 50%, #FFE4E1 100%);
  border-radius: 0 0 60rpx 60rpx;
}

.header-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 30rpx 30rpx;
  padding-top: calc(60rpx + env(safe-area-inset-top));
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(255, 182, 193, 0.3);
}

.back-icon {
  font-size: 36rpx;
  color: #8B4513;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 2rpx 8rpx rgba(139, 69, 19, 0.2);
}

.header-right {
  width: 72rpx;
}

.scroll-area {
  flex: 1;
  height: 0;
  min-height: 0;
  margin-top: -40rpx;
}

.post-card {
  margin: 0 24rpx 20rpx;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 182, 193, 0.2);
}

.author-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx dashed rgba(255, 182, 193, 0.3);
}

.author-avatar {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: linear-gradient(135deg, #FFE4E1 0%, #FFDAB9 100%);
  border: 4rpx solid rgba(255, 182, 193, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(255, 182, 193, 0.2);
}

.author-info {
  flex: 1;
  min-width: 0;
}

.author-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #8B4513;
  margin-bottom: 6rpx;
  overflow-wrap: break-word;
}

.post-time {
  display: block;
  font-size: 24rpx;
  color: #CD853F;
}

.post-badges {
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  gap: 12rpx;
}

.badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.badge.top {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 107, 0.3);
}

.badge.essence {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(255, 165, 0, 0.3);
}

.post-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #8B4513;
  line-height: 1.5;
  margin-bottom: 20rpx;
  overflow-wrap: break-word;
}

.post-content {
  font-size: 30rpx;
  color: #A0522D;
  line-height: 1.9;
  margin-bottom: 24rpx;
  overflow-wrap: break-word;
}

.post-images {
  margin-bottom: 24rpx;
}

.post-img {
  width: 100%;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 182, 193, 0.2);
}

.post-category {
  margin-bottom: 24rpx;
}

.category-tag {
  font-size: 24rpx;
  color: #D2691E;
  background: linear-gradient(135deg, rgba(255, 182, 193, 0.3) 0%, rgba(255, 218, 185, 0.3) 100%);
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 182, 193, 0.5);
}

.post-actions {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 0;
  border-top: 2rpx dashed rgba(255, 182, 193, 0.3);
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 32rpx;
  border-radius: 24rpx;
  transition: all 0.3s ease;
}

.action-btn.active {
  background: linear-gradient(135deg, rgba(255, 182, 193, 0.3) 0%, rgba(255, 218, 185, 0.3) 100%);
}

.action-icon {
  font-size: 40rpx;
  margin-bottom: 6rpx;
}

.action-num {
  font-size: 24rpx;
  color: #CD853F;
  font-weight: 500;
}

.owner-actions {
  display: flex;
  justify-content: center;
  padding-top: 20rpx;
  margin-top: 20rpx;
  border-top: 2rpx dashed rgba(255, 182, 193, 0.3);
}

.delete-btn {
  font-size: 26rpx;
  color: #FFFFFF;
  padding: 14rpx 36rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.3);
}

.comment-section {
  margin: 0 24rpx 20rpx;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 182, 193, 0.2);
}

.section-header {
  display: flex;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 2rpx dashed rgba(255, 182, 193, 0.3);
  margin-bottom: 20rpx;
}

.section-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #8B4513;
}

.comment-list {
  
}

.comment-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 2rpx dashed rgba(255, 182, 193, 0.2);
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: linear-gradient(135deg, #FFE4E1 0%, #FFDAB9 100%);
  flex-shrink: 0;
  border: 3rpx solid rgba(255, 182, 193, 0.3);
}

.comment-main {
  flex: 1;
  min-width: 0;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
  gap: 12rpx;
}

.comment-author {
  flex: 1;
  min-width: 0;
  overflow-wrap: break-word;
  font-size: 28rpx;
  font-weight: 600;
  color: #8B4513;
}

.comment-floor {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #CD853F;
  background: rgba(255, 182, 193, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.comment-content {
  font-size: 28rpx;
  color: #A0522D;
  line-height: 1.7;
  word-break: break-all;
}

.reply-tag {
  color: #D2691E;
  margin-right: 8rpx;
  font-weight: 500;
}

.comment-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
  gap: 12rpx;
  flex-wrap: wrap;
}

.comment-time {
  font-size: 22rpx;
  color: #CD853F;
}

.comment-actions {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.comment-action {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #A0522D;
  padding: 6rpx 12rpx;
  background: rgba(255, 182, 193, 0.15);
  border-radius: 16rpx;
}

.action-emoji {
  margin-right: 4rpx;
}

.comment-action.delete {
  color: #FF6B6B;
  background: rgba(255, 107, 107, 0.1);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #8B4513;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #CD853F;
}

.bottom-space {
  height: 32rpx;
}

.input-bar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -4rpx 20rpx rgba(255, 182, 193, 0.2);
  gap: 16rpx;
  box-sizing: border-box;
}

.input-wrapper {
  flex: 1;
  min-width: 0;
  background: linear-gradient(135deg, rgba(255, 228, 225, 0.5) 0%, rgba(255, 218, 185, 0.5) 100%);
  border-radius: 40rpx;
  padding: 4rpx;
  box-sizing: border-box;
}

.comment-input {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  height: 76rpx;
  padding: 0 28rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #8B4513;
}

.send-btn {
  height: 96rpx;
  display: flex;
  flex-shrink: 0;
  align-items: center;
  padding: 0 24rpx;
  background: #E8E8E8;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #999999;
  white-space: nowrap;
}

.send-btn.active {
  background: linear-gradient(135deg, #FFB6C1 0%, #FFDAB9 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(255, 182, 193, 0.4);
}

.send-icon {
  margin-right: 6rpx;
}

.keyboard-open .input-bar { padding-bottom: 16rpx; }

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(139, 69, 19, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-box {
  width: 85%;
  max-height: 85vh;
  overflow-y: auto;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(255, 182, 193, 0.3);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  background: linear-gradient(135deg, #FFB6C1 0%, #FFDAB9 100%);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.modal-close {
  font-size: 44rpx;
  color: #FFFFFF;
  line-height: 1;
}

.modal-body {
  padding: 28rpx;
}

.report-input {
  width: 100%;
  height: 220rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, rgba(255, 228, 225, 0.3) 0%, rgba(255, 218, 185, 0.3) 100%);
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #8B4513;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 182, 193, 0.3);
}

.modal-footer {
  display: flex;
  padding: 20rpx 28rpx 28rpx;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  padding: 22rpx 0;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.modal-btn.cancel {
  background: rgba(255, 182, 193, 0.2);
  color: #8B4513;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #FFB6C1 0%, #FFDAB9 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(255, 182, 193, 0.3);
}

@import "../../../styles/tech-ui.wxss";
