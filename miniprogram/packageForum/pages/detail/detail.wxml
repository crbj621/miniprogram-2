<view class="page">
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="back-btn tech-control" bindtap="goBack" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
        <text class="back-icon">←</text>
      </view>
      <text class="header-title">动态详情</text>
      <view class="header-right"></view>
    </view>
  </view>

  <scroll-view scroll-y class="scroll-area">
    <view class="post-card tech-card">
      <view class="author-row" bindtap="onAvatarTap" data-openid="{{post.authorInfo.openid}}" data-name="{{post.authorInfo.nickname}}" data-avatar="{{post.authorInfo.avatar}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
        <image wx:if="{{post.authorInfo.avatar}}" class="author-avatar" src="{{post.authorInfo.avatar}}" mode="aspectFill"></image><view wx:else class="author-avatar image-placeholder">同</view>
        <view class="author-info">
          <text class="author-name">{{post.authorInfo.nickname || '匿名用户'}}</text>
          <text class="post-time">{{post.createTimeText}}</text>
        </view>
        <view class="post-badges">
          <text class="badge top" wx:if="{{post.isTop}}">置顶</text>
          <text class="badge essence" wx:if="{{post.isEssence}}">精华</text>
        </view>
      </view>
      
      <view class="post-title">{{post.title}}</view>
      <view class="post-content">{{post.content}}</view>
      
      <view class="post-images" wx:if="{{post.imgList.length > 0}}">
        <image class="post-img" wx:for="{{post.imgList}}" wx:key="*this" src="{{item}}" mode="widthFix" bindtap="onPreviewImage" data-url="{{item}}"></image>
      </view>
      
      <view class="post-category">
        <text class="category-tag">{{post.categoryName}}</text>
      </view>
      
      <view class="post-actions">
        <view class="action-btn {{post.isLiked ? 'active' : ''}} tech-control" bindtap="onLikePost" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
          <text class="action-icon">{{post.isLiked ? '❤️' : '🤍'}}</text>
          <text class="action-num">{{post.likeCount}}</text>
        </view>
        <view class="action-btn {{post.isCollected ? 'active' : ''}} tech-control" bindtap="onCollectPost" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
          <text class="action-icon">{{post.isCollected ? '⭐' : '☆'}}</text>
          <text class="action-num">{{post.collectCount}}</text>
        </view>
        <view class="action-btn tech-control" bindtap="onShowReport" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
          <text class="action-icon">🚨</text>
          <text class="action-num">举报</text>
        </view>
      </view>
      
      <view class="owner-actions" wx:if="{{post.isOwner}}">
        <view class="delete-btn tech-control" bindtap="onDeletePost" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">删除动态</view>
      </view>
    </view>
    
    <view class="comment-section">
      <view class="section-header">
        <text class="section-icon">💬</text>
        <text class="section-title">评论 {{post.commentCount}}</text>
      </view>
      
      <view class="comment-list">
        <view class="comment-item" wx:for="{{comments}}" wx:key="_id">
          <image wx:if="{{item.authorInfo.avatar}}" class="comment-avatar" bindtap="onAvatarTap" data-openid="{{item.authorInfo.openid}}" data-name="{{item.authorInfo.nickname}}" data-avatar="{{item.authorInfo.avatar}}" src="{{item.authorInfo.avatar}}" mode="aspectFill"></image><view wx:else class="comment-avatar image-placeholder" bindtap="onAvatarTap" data-openid="{{item.authorInfo.openid}}" data-name="{{item.authorInfo.nickname}}" data-avatar="{{item.authorInfo.avatar}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">同</view>
          <view class="comment-main">
            <view class="comment-header">
              <text class="comment-author">{{item.authorInfo.nickname || '匿名用户'}}</text>
              <text class="comment-floor">#{{index + 1}}</text>
            </view>
            <view class="comment-content">
              <text class="reply-tag" wx:if="{{item.replyToInfo}}">回复 @{{item.replyToInfo.nickname}}</text>
              {{item.content}}
            </view>
            <view class="comment-footer">
              <text class="comment-time">{{item.createTimeText}}</text>
              <view class="comment-actions">
                <view class="comment-action {{item.isLiked ? 'active' : ''}}" bindtap="onLikeComment" data-id="{{item._id}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
                  <text class="action-emoji">👍</text>
                  <text>{{item.likeCount}}</text>
                </view>
                <view class="comment-action" bindtap="onReplyComment" data-id="{{item._id}}" data-nickname="{{item.authorInfo.nickname}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
                  <text class="action-emoji">💬</text>
                  <text>回复</text>
                </view>
                <view class="comment-action delete" wx:if="{{item._openid === currentOpenid}}" bindtap="onDeleteComment" data-id="{{item._id}}" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
                  <text class="action-emoji">🗑️</text>
                  <text>删除</text>
                </view>
              </view>
            </view>
          </view>
        </view>
        
        <view class="empty-state" wx:if="{{comments.length === 0}}">
          <text class="empty-icon">💭</text>
          <text class="empty-text">暂无评论</text>
          <text class="empty-tip">快来抢沙发吧~</text>
        </view>
      </view>
    </view>
    
    <view class="bottom-space"></view>
  </scroll-view>
  
  <view class="input-bar">
    <view class="input-wrapper">
      <input class="comment-input tech-input" placeholder="{{replyTo ? '回复 @' + replyToName : '写评论...'}}" value="{{commentContent}}" bindinput="onCommentInput" bindconfirm="onSubmitComment" placeholder-style="color:#8597ad" />
    </view>
    <view class="send-btn {{commentContent && !commentSubmitting ? 'active' : ''}} tech-control tech-primary" bindtap="onSubmitComment" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
      <text class="send-icon">✈️</text>
      <text>{{commentSubmitting ? '发送中' : '发送'}}</text>
    </view>
  </view>
</view>

<view class="modal-mask" wx:if="{{showReportModal}}" bindtap="onHideReport" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
  <view class="modal-box tech-card" catchtap="" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
    <view class="modal-header">
      <text class="modal-title">🚨 举报动态</text>
      <view class="modal-close tap-action" bindtap="onHideReport" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">×</view>
    </view>
    <view class="modal-body">
      <textarea class="report-input tech-input" placeholder="请输入举报理由..." value="{{reportReason}}" bindinput="onReportInput" maxlength="200" placeholder-style="color:#8597ad"></textarea>
    </view>
    <view class="modal-footer">
      <view class="modal-btn cancel tech-control" bindtap="onHideReport" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">取消</view>
      <view class="modal-btn confirm tech-control tech-primary" bindtap="onSubmitReport" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">提交</view>
    </view>
  </view>
</view>
