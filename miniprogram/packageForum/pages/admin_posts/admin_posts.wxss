@import "../../../styles/admin-ui.wxss";
.container {
  min-height: 100vh;
  background-color: #fffbf5;
  display: flex;
  flex-direction: column;
}

.filter-bar {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background-color: #fff;
}

.picker-btn {
  padding: 16rpx 24rpx;
  background-color: #fffbf5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.post-list {
  flex: 1;
  padding: 20rpx;
}

.post-item {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.post-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.post-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
}

.post-status {
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 16rpx;
}

.post-status.normal {
  background-color: #f0fff0;
  color: #52c41a;
}

.post-status.deleted {
  background-color: #fff0f0;
  color: #ff4d4f;
}

.post-info {
  display: flex;
  gap: 20rpx;
  font-size: 24rpx;
  color: #81756c;
  margin-bottom: 12rpx;
}

.post-author {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.post-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  padding: 12rpx 24rpx;
  background-color: #fffbf5;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.loading, .no-more, .empty {
  text-align: center;
  padding: 30rpx;
  color: #81756c;
  font-size: 26rpx;
}

@import "../../../styles/tech-ui.wxss";
