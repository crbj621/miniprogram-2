@import "../../../styles/admin-ui.wxss";
.container {
  min-height: 100vh;
  background-color: #fffbf5;
  display: flex;
  flex-direction: column;
}

.search-bar {
  display: flex;
  gap: 16rpx;
  padding: 20rpx;
  background-color: #fff;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background-color: #fffbf5;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.search-btn {
  width: 120rpx;
  height: 72rpx;
  background: #62866c;
  color: #fff;
  border-radius: 36rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
}

.filter-bar {
  padding: 0 20rpx 20rpx;
  background-color: #fff;
}

.picker-btn {
  padding: 16rpx 24rpx;
  background-color: #fffbf5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
  display: inline-block;
}

.user-list {
  flex: 1;
  padding: 20rpx;
}

.user-item {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.user-meta {
  display: flex;
  gap: 16rpx;
  font-size: 24rpx;
  color: #81756c;
}

.user-status {
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.user-status.normal {
  background-color: #f0fff0;
  color: #52c41a;
}

.user-status.banned {
  background-color: #fff0f0;
  color: #ff4d4f;
}

.action-btn {
  padding: 12rpx 24rpx;
  background-color: #fffbf5;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.loading, .no-more, .empty {
  text-align: center;
  padding: 30rpx;
  color: #81756c;
  font-size: 26rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  width: 80%;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.picker-value {
  height: 72rpx;
  background-color: #fffbf5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
}

.form-input {
  width: 100%;
  height: 72rpx;
  background-color: #fffbf5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 30rpx;
}

.modal-btn.cancel {
  background-color: #fffbf5;
  color: #666;
}

.modal-btn.confirm {
  background: #62866c;
  color: #fff;
}

@import "../../../styles/tech-ui.wxss";
