<view class="container">
  <view class="search-bar">
    <tech-search class="tech-search-host"><input class="search-input tech-input" placeholder="搜索用户昵称" value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="onSearch" placeholder-style="color:#8597ad" /></tech-search>
    <view class="search-btn tech-control" bindtap="onSearch" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">搜索</view>
  </view>

  <view class="filter-bar">
    <picker mode="selector" range="{{statusList}}" range-key="name" value="{{statusIndex}}" bindchange="onStatusChange">
      <view class="picker-btn">{{statusList[statusIndex].name}} ▼</view>
    </picker>
  </view>

  <scroll-view scroll-y class="user-list" bindscrolltolower="loadMore">
    <view class="user-item" wx:for="{{users}}" wx:key="_id">
      <view class="user-info">
        <image wx:if="{{item.avatarUrl}}" class="user-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image><view wx:else class="user-avatar image-placeholder">同</view>
        <view class="user-detail">
          <view class="user-name">{{item.nickName || '微信用户'}}</view>
          <view class="user-meta">
            <text>{{item.createTimeText}}</text>
            <text class="user-status {{item.status}}">{{item.status === 'normal' ? '正常' : '禁言'}}</text>
          </view>
        </view>
      </view>
      <view class="user-actions">
        <view class="action-btn tech-control" wx:if="{{item.status === 'normal'}}" bindtap="updateUserStatus" data-id="{{item._id}}" data-status="banned" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">禁言</view>
        <view class="action-btn tech-control" wx:else bindtap="updateUserStatus" data-id="{{item._id}}" data-status="normal" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">解除禁言</view>
      </view>
    </view>

    <view class="loading" wx:if="{{loading}}"><view class="uiverse-dots"><view class="uiverse-dot" /><view class="uiverse-dot" /><view class="uiverse-dot" /></view>加载中...</view>
    <view class="no-more" wx:if="{{!hasMore && users.length > 0}}">没有更多了</view>
    <view class="empty" wx:if="{{!loading && users.length === 0}}">暂无用户</view>
  </scroll-view>
</view>
