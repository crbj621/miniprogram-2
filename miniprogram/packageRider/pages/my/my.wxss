.container {
  min-height: 100vh;
  background: #f8f9fb;
  padding-bottom: 40rpx;
}

.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.02);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #ff9a9e;
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
  border-radius: 4rpx;
}

.list {
  padding: 24rpx;
}

.item {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 154, 158, 0.08);
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.shop {
  font-size: 34rpx;
  font-weight: 800;
  color: #333;
}

.state {
  font-size: 26rpx;
  color: #ff9a9e;
  font-weight: bold;
  background: rgba(255, 154, 158, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.sub {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.bottom {
  margin-top: 30rpx;
  margin-bottom: 0;
  padding-top: 24rpx;
  border-top: 2rpx dashed #f0f0f0;
}

.hint {
  font-size: 24rpx;
  color: #999;
}

.btn {
  margin: 0;
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  padding: 0 40rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 10rpx rgba(255, 154, 158, 0.3);
}

.btn::after {
  border: none;
}

.empty, .loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}


@import "../../../styles/tech-ui.wxss";
