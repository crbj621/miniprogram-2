<share-intro wx:if="{{__sharePublic}}" title="{{__shareTitle}}" path="{{__sharePath}}" /><block wx:else>
<view class="container">
  <view class="tabs">
    <view class="tab {{status==='all'?'active':''}}" data-status="all" bindtap="switchTab" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">全部</view>
    <view class="tab {{status==='accepted'?'active':''}}" data-status="accepted" bindtap="switchTab" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">已接单</view>
    <view class="tab {{status==='picking'?'active':''}}" data-status="picking" bindtap="switchTab" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">取餐中</view>
    <view class="tab {{status==='delivering'?'active':''}}" data-status="delivering" bindtap="switchTab" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">配送中</view>
    <view class="tab {{status==='delivered'?'active':''}}" data-status="delivered" bindtap="switchTab" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">已送达</view>
  </view>

  <view class="list" wx:if="{{list.length}}">
    <view class="item" wx:for="{{list}}" wx:key="_id">
      <view class="row">
        <view class="shop">{{item.shopName}}</view>
        <view class="state">{{item.deliveryStatusText}}</view>
      </view>
      <view class="sub">地址：{{item.address}}</view>
      <view class="sub">电话：{{item.phone}}</view>
      <view class="sub">金额：￥{{item.totalPrice}}　下单：{{item.createTimeText}}</view>

      <view class="row bottom">
        <view class="hint">订单状态：{{item.status}}</view>
        <button class="btn tech-control" size="mini" wx:if="{{item.nextDeliveryStatus}}" data-id="{{item._id}}" data-next="{{item.nextDeliveryStatus}}" bindtap="nextStep" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">
          {{item.nextActionLabel}}
        </button>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !list.length}}">
    <text>暂无订单</text>
  </view>

  <view class="loading" wx:if="{{loading}}"><view class="uiverse-dots"><view class="uiverse-dot" /><view class="uiverse-dot" /><view class="uiverse-dot" /></view>
    <text>加载中...</text>
  </view>
</view>

</block>
