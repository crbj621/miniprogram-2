<share-intro wx:if="{{__sharePublic}}" title="{{__shareTitle}}" path="{{__sharePath}}" /><block wx:else>
<view class="container">
  <view class="topbar">
    <view class="title">可接单（待配送）</view>
    <view class="actions">
      <view class="btn-link" bindtap="goMy" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">我的订单</view>
      <view class="btn-link" bindtap="refresh" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">刷新</view>
    </view>
  </view>

  <view class="list" wx:if="{{list.length}}">
    <view class="item" wx:for="{{list}}" wx:key="_id">
      <view class="row">
        <view class="shop">{{item.shopName}}</view>
        <view class="price">￥{{item.totalPrice}}</view>
      </view>
      <view class="sub">下单时间：{{item.createTimeText}}</view>
      <view class="sub">配送地址：{{item.address}}</view>
      <view class="sub">联系电话：{{item.phone}}</view>
      <view class="row bottom">
        <view class="tag">已出餐</view>
        <button class="btn tech-control" size="mini" data-id="{{item._id}}" bindtap="accept" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">接单</button>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !list.length}}">
    <text>暂无可接订单</text>
  </view>

  <view class="loading" wx:if="{{loading}}"><view class="uiverse-dots"><view class="uiverse-dot" /><view class="uiverse-dot" /><view class="uiverse-dot" /></view>
    <text>加载中...</text>
  </view>
</view>


</block>
