.container {
  min-height: 100vh;
  background: #f6f7fb;
  padding: 30rpx;
}

.card {
  background: #fff;
  border-radius: 18rpx;
  padding: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
}

.desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #888;
}

.field {
  margin-top: 26rpx;
}

.label {
  font-size: 26rpx;
  color: #555;
  margin-bottom: 10rpx;
}

.input {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 18rpx 18rpx;
  font-size: 28rpx;
}

.btn {
  margin-top: 34rpx;
  background: #667eea;
  color: #fff;
  border-radius: 14rpx;
}


@import "../../../styles/tech-ui.wxss";
