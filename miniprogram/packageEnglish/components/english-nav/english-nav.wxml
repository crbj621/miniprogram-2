<view class="english-nav">
  <button wx:for="{{items}}" wx:key="id" class="nav-item {{current === item.id ? 'is-current' : ''}}" data-id="{{item.id}}" bindtap="switchSection" hover-class="nav-pressed" aria-label="{{item.label}}分区" aria-current="{{current === item.id ? 'page' : ''}}"><view class="nav-indicator"></view><text class="nav-label">{{item.label}}</text></button>
</view>
