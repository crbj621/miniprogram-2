<share-intro wx:if="{{__sharePublic}}" title="{{__shareTitle}}" path="{{__sharePath}}" /><block wx:else>
<view class="english-page english-section-page" style="{{theme.style}}">
  <view class="hero"><text class="kicker">DAILY CHALLENGE</text><text class="title">{{attemptId ? '挑战记录' : '挑战'}}</text><text class="subtitle">同等级同题目，每天一次正式成绩。</text></view>
  <view wx:if="{{!challenge && !attemptId}}" class="tabs"><button class="tab tech-control {{level === 'CET4' ? 'selected' : ''}}" data-level="CET4" bindtap="switchLevel" disabled="{{loading || busy}}">四级</button><button class="tab tech-control {{level === 'CET6' ? 'selected' : ''}}" data-level="CET6" bindtap="switchLevel" disabled="{{loading || busy}}">六级</button></view>
  <view wx:if="{{error}}" class="error">{{error}}<button wx:if="{{challenge && (expired || !question)}}" class="action tech-control" bindtap="finishChallenge" disabled="{{busy}}">重新同步成绩</button><button wx:else class="action tech-control" bindtap="beginChallenge" disabled="{{busy || loading}}">重试 / 同步进度</button></view>
  <view wx:if="{{!challenge && !loading}}" class="card"><text class="card-title">准备好再开始</text><view class="notice">同一等级每天只有一次正式成绩。开始后倒计时持续，退出页面和切到后台也不会暂停。正式答题期间不展示答案，提示不开放。</view><text class="muted">计时与判分以服务器为准；网络失败可重新同步已经保存的进度。</text><button class="action tech-control tech-primary" bindtap="beginChallenge" disabled="{{loading}}" hover-class="tech-pressed">开始 / 继续今日挑战</button></view>
  <view wx:if="{{loading}}" class="card muted">正在同步今日挑战…</view>
  <block wx:if="{{challenge && !result}}"><view class="card"><view class="row between"><text class="muted">已答 {{challenge.completed}} / {{challenge.total}} 题</text><text class="timer {{urgent ? 'urgent' : ''}}">{{remainingText}}</text></view><view wx:if="{{question}}"><text class="section-label">第 {{challenge.index + 1}} 题</text><view class="question-text">{{question.prompt}}</view><button wx:for="{{question.options}}" wx:key="id" class="option tech-control {{chosen === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseAnswer" disabled="{{busy || loading || expired}}" hover-class="tech-pressed"><text class="option-label">{{item.id}}.</text><text class="option-copy">{{item.text}}</text></button></view><view wx:else class="notice">{{busy ? '正在生成正式成绩…' : '答题已保存，请同步正式成绩。'}}</view><text class="muted" style="margin-top:24rpx">点击选项即提交，成绩由服务器统一判定。</text></view><button wx:if="{{expired || !question}}" class="action tech-control tech-primary" bindtap="finishChallenge" loading="{{busy}}" disabled="{{busy}}" hover-class="tech-pressed">同步挑战成绩</button><button wx:else class="action tech-control" bindtap="finishChallenge" disabled="{{busy || loading}}" hover-class="tech-pressed">提前结束并交卷</button></block>
  <view wx:if="{{result}}" class="card"><text class="card-title">正式成绩已保存</text><view class="grid"><view class="stat"><text class="stat-number">{{result.correctCount}} / {{result.total}}</text><text class="stat-label">答对题数</text></view><view class="stat"><text class="stat-number">{{result.myRank || '—'}}</text><text class="stat-label">服务器确认名次</text></view></view><view class="notice">已答 {{result.answeredCount}} 题 · {{result.date}} · {{result.level}}<text class="muted">相同等级今日不可重新刷正式成绩。</text><text wx:if="{{result.answersAvailableText}}" class="muted">答案开放时间：{{result.answersAvailableText}}</text></view><view class="notice success">本次领取 {{result.coinsEarned || 0}} 金币<text class="muted">每天首次达成有效挑战任务领取；重复查看不会重复发奖。</text></view><button class="action tech-control tech-primary" bindtap="openRank" hover-class="tech-pressed">查看今日挑战榜</button><button class="action tech-control" bindtap="goHome" hover-class="tech-pressed">返回学习小屋</button></view>
  <view wx:for="{{review}}" wx:key="questionId" class="card"><text class="card-title">第 {{item.question.number}} 题 · {{item.statusText}}</text><view wx:if="{{item.question.passage}}" class="passage">{{item.question.passage}}</view><view class="question-text">{{item.question.prompt}}</view><view wx:for="{{item.question.options}}" wx:for-item="option" wx:key="id" class="passage">{{option.id}}. {{option.text}}</view><view class="notice">我的答案：{{item.answerText}}<text class="muted">正确答案：{{item.feedback.answerText}}</text></view><view wx:if="{{item.feedback.explanation}}" class="question-text">{{item.feedback.explanation}}</view><view wx:if="{{item.feedback.listeningTranscript}}" class="passage">听力原文：{{item.feedback.listeningTranscript}}</view></view>
  <english-nav current="challenge" level="{{level}}" />
</view>

</block>
