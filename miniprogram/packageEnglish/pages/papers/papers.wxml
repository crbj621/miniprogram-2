<share-intro wx:if="{{__sharePublic}}" title="{{__shareTitle}}" path="{{__sharePath}}" /><block wx:else>
<view class="english-page english-section-page" style="{{theme.style}}">
  <view class="hero"><text class="kicker">PAST EXAMS</text><text class="title">{{view === 'history' ? '作答历史' : view === 'wrong' ? '我的错题' : '真题'}}</text><text class="subtitle">{{view === 'papers' ? '整套作答：作文、阅读、翻译，不含听力。' : '继续作答，或回顾需要巩固的题目。'}}</text></view>
  <view class="tabs"><button class="tab tech-control {{level === 'CET4' ? 'selected' : ''}}" data-level="CET4" bindtap="switchLevel" hover-class="tech-pressed">四级</button><button class="tab tech-control {{level === 'CET6' ? 'selected' : ''}}" data-level="CET6" bindtap="switchLevel" hover-class="tech-pressed">六级</button></view>
  <view class="tabs"><button class="tab tech-control {{view === 'papers' ? 'selected' : ''}}" data-view="papers" bindtap="selectView">真题</button><button class="tab tech-control {{view === 'history' ? 'selected' : ''}}" data-view="history" bindtap="selectView">历史</button><button class="tab tech-control {{view === 'wrong' ? 'selected' : ''}}" data-view="wrong" bindtap="selectView">错题</button></view>
  <view wx:if="{{view === 'papers'}}" class="filters"><picker class="picker" range="{{years}}" value="{{yearIndex}}" bindchange="selectYear">{{years[yearIndex]}} ▾</picker><button class="small tech-control {{kind === 'full' ? 'selected' : ''}}" data-kind="full" bindtap="selectKind">整卷真题</button><button class="small tech-control {{kind === 'resource' ? 'selected' : ''}}" data-kind="resource" bindtap="selectKind">资料来源</button></view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="action tech-control" bindtap="loadPapers" disabled="{{loading}}">重试</button></view>
  <view wx:if="{{loading}}" class="card muted">正在读取题库与来源…</view>
  <block wx:if="{{view === 'papers'}}">
  <view wx:if="{{coverageText}}" class="notice">{{coverageText}}</view>
  <view wx:if="{{!loading && !error && !visiblePapers.length}}" class="card"><text class="card-title">{{kind === 'full' ? '该筛选暂无可作答整卷' : '该筛选暂无资料'}}</text><text class="muted">可切换等级或年份；资料来源只展示范围和链接。</text></view>
  <view wx:for="{{visiblePapers}}" wx:key="id" class="card"><text class="badge">{{item.badgeText}}</text><view class="paper-title">{{item.title}}</view><text class="muted">{{item.level}}{{item.year ? ' · ' + item.year + '年' : ''}}{{item.questionCount ? ' · ' + item.questionCount + '题' : ''}}{{item.durationMinutes ? ' · ' + item.durationMinutes + '分钟' : ''}}</text><text wx:if="{{item.description}}" class="muted">{{item.description}}</text><view wx:if="{{item.coverageText}}" class="notice">{{item.isFullPaper ? '整卷范围：' : '资料范围：'}}{{item.coverageText}}</view><view wx:if="{{item.availabilityNote}}" class="notice">{{item.availabilityNote}}</view><view wx:if="{{item.isFullPaper}}" class="row paper-actions"><button class="tab tech-control tech-primary" data-id="{{item.id}}" data-mode="practice" bindtap="openAttempt" hover-class="tech-pressed">整卷逐题练习</button><button class="tab tech-control" data-id="{{item.id}}" data-mode="exam" bindtap="openAttempt" hover-class="tech-pressed">整卷考试</button></view><block wx:for="{{item.resources}}" wx:for-item="resource" wx:key="id"><button class="action tech-control" data-paper-id="{{item.id}}" data-resource-id="{{resource.id}}" bindtap="openResource" loading="{{openingId === resource.id}}" disabled="{{!!openingId}}" hover-class="tech-pressed">{{resource.downloadUrl ? '打开资料：' : '复制来源：'}}{{resource.title}}</button><button wx:if="{{resource.downloadUrl && resource.url}}" class="source-link" data-url="{{resource.url}}" bindtap="copySource">复制原始来源</button></block></view>
  <text class="muted catalog-note">{{kind === 'full' ? '每套32题，统一交卷。写作与翻译对照范文自评。参考答案与解析来源见每套卷标注。' : '资料范围以标注为准；缺题或缺答案的卷不标成完整整卷。'}}</text>
  </block>
  <block wx:if="{{view === 'history'}}"><view class="tabs"><button class="tab tech-control {{historyType === 'exam' ? 'selected' : ''}}" data-type="exam" bindtap="selectHistoryType">试卷与练习</button><button class="tab tech-control {{historyType === 'challenge' ? 'selected' : ''}}" data-type="challenge" bindtap="selectHistoryType">每日挑战</button></view><view wx:if="{{!loading && !error && !history.length}}" class="card muted">还没有作答记录，完成练习或挑战后会显示在这里。</view><view wx:for="{{history}}" wx:key="attemptId" class="card"><text class="card-title">{{item.paper ? item.paper.title : item.date + ' 每日挑战'}}</text><text class="muted">{{item.dateText}} · {{item.active ? '尚未交卷' : '成绩已保存'}}</text><view class="notice">{{item.active ? '已作答 ' + item.completed + ' / ' + item.total + ' 题' : '答对 ' + item.correctCount + ' / ' + (item.objectiveCount || item.total) + ' 题'}}<text wx:if="{{item.selfCheckPendingCount}}" class="muted">待自评 {{item.selfCheckPendingCount}} 题</text></view><button class="action tech-control tech-primary" data-id="{{item.attemptId}}" bindtap="openHistory">{{item.active ? '继续作答' : '查看成绩与解析'}}</button></view></block>
  <block wx:if="{{view === 'wrong'}}"><view class="notice">这里收录待复习题目，可逐题或分批重新练习。</view><button wx:if="{{wrong.length}}" class="action tech-control tech-primary" bindtap="practiceWrong">重练前 {{wrong.length > 20 ? 20 : wrong.length}} 道错题</button><view wx:if="{{!loading && !error && !wrong.length}}" class="card muted">当前没有待复习错题。</view><view wx:for="{{wrong}}" wx:key="id" class="card"><text wx:if="{{item.question.section}}" class="badge">{{item.question.section}}</text><view class="question-text">{{item.question.prompt}}</view><button class="action tech-control" data-id="{{item.question.id}}" bindtap="practiceWrong">重做这一题</button></view></block>
  <english-nav current="papers" level="{{level}}" />
</view>

</block>
