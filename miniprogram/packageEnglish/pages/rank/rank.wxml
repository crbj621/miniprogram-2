<share-intro wx:if="{{__sharePublic}}" title="{{__shareTitle}}" path="{{__sharePath}}" /><block wx:else>
<view class="english-page english-section-page" style="{{theme.style}}">
  <view class="hero"><text class="kicker">LEARNING TOGETHER</text><text class="title">榜单</text><text class="subtitle">{{pageCopy.subtitle}}</text></view>
  <view class="tabs"><button class="tab tech-control {{level === 'CET4' ? 'selected' : ''}}" data-field="level" data-value="CET4" bindtap="chooseFilter">四级</button><button class="tab tech-control {{level === 'CET6' ? 'selected' : ''}}" data-field="level" data-value="CET6" bindtap="chooseFilter">六级</button></view>
  <view class="tabs"><button class="tab tech-control {{type === 'study' ? 'selected' : ''}}" data-field="type" data-value="study" bindtap="chooseFilter">学习</button><button class="tab tech-control {{type === 'challenge' ? 'selected' : ''}}" data-field="type" data-value="challenge" bindtap="chooseFilter">挑战</button><button class="tab tech-control {{type === 'exam' ? 'selected' : ''}}" data-field="type" data-value="exam" bindtap="chooseFilter">练习考试</button></view>
  <view class="filters"><button class="small tech-control {{period === 'day' ? 'selected' : ''}}" data-field="period" data-value="day" bindtap="chooseFilter">今日</button><button class="small tech-control {{period === 'week' ? 'selected' : ''}}" data-field="period" data-value="week" bindtap="chooseFilter">本周</button><button class="small tech-control {{period === 'all' ? 'selected' : ''}}" data-field="period" data-value="all" bindtap="chooseFilter">全部</button></view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="action tech-control" bindtap="loadRank" disabled="{{loading}}">重新加载</button></view>
  <view wx:if="{{loading}}" class="card muted">正在同步榜单…</view>
  <block wx:if="{{!loading && !error}}">
    <view class="card"><text class="card-title">我的位置</text><view class="row between"><view><text class="stat-number">{{myRank ? '第 ' + myRank + ' 名' : '暂未上榜'}}</text><text class="muted">{{scoreLabel}} {{myScore}}</text></view><text class="badge">{{period === 'day' ? '今日' : period === 'week' ? '本周' : '累计'}}记录</text></view></view>
    <view wx:if="{{topThree.length}}" class="podium"><view wx:for="{{topThree}}" wx:key="openid" class="podium-card"><text class="podium-medal">{{item.medal}}</text><image wx:if="{{item.avatarUrl}}" class="avatar" src="{{item.avatarUrl}}" mode="aspectFill" /><text class="podium-name">{{item.nickName}}{{item.isMine ? ' · 我' : ''}}</text><text class="podium-score">{{item.score}}</text><text class="muted">{{scoreLabel}}</text><text wx:if="{{type === 'study'}}" class="muted">新词 {{item.newCount || 0}}<text> · 复习 {{item.reviewCount || 0}}</text></text><text wx:if="{{type === 'study'}}" class="muted">{{item.checkedTime}}</text><text wx:if="{{type === 'study'}}" class="muted">连续 {{item.streak || 0}} 天 · 累计 {{item.totalCheckins || 0}} 天</text></view></view>
    <view wx:if="{{rows.length}}" class="card"><view wx:for="{{rows}}" wx:key="openid" class="rank-row"><text class="rank-place">{{item.rank}}</text><image wx:if="{{item.avatarUrl}}" class="avatar" src="{{item.avatarUrl}}" mode="aspectFill" /><view class="grow"><text class="rank-name">{{item.nickName}}{{item.isMine ? ' · 我' : ''}}</text><text wx:if="{{type === 'study'}}" class="muted">新词 {{item.newCount || 0}} · 复习 {{item.reviewCount || 0}} · {{item.studyMinutes}}分钟</text><text wx:if="{{type === 'study'}}" class="muted">{{period === 'day' ? '打卡' : '最近打卡'}}：{{item.checkedTime}}</text><text wx:if="{{type === 'study'}}" class="muted">连续 {{item.streak || 0}} 天 · 累计 {{item.totalCheckins || 0}} 天</text><text wx:if="{{type === 'challenge'}}" class="muted">正式挑战答对 {{item.correctCount || item.score}} 题</text></view><text class="rank-score">{{item.score}}</text></view></view>
    <view wx:if="{{!topThree.length && !rows.length}}" class="card"><text class="card-title">这个榜单还没有记录</text><text class="muted">完成学习目标或提交练习、挑战后，再来看自己的进度。</text></view>
    <view class="notice">{{type === 'study' ? '词数与打卡时间按服务器实际学习记录统计。' : type === 'challenge' ? '同等级每日一次正式成绩，结束前不公布答案。' : '题数按结构化练习的客观题答对记录统计，主观题需自行对照范文。'}}</view>
  </block>
  <english-nav current="rank" level="{{level}}" />
</view>

</block>
