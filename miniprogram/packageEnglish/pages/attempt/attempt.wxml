<share-intro wx:if="{{__sharePublic}}" title="{{__shareTitle}}" path="{{__sharePath}}" /><block wx:else>
<view class="english-page attempt-page {{attempt && !result ? 'has-actions' : ''}}" style="{{theme.style}}">
  <view class="attempt-header"><text class="attempt-title">{{attempt ? attempt.paper.title : '准备题目…'}}</text><text class="attempt-mode">{{level}} · {{mode === 'exam' ? '考试' : '练习'}}</text></view>
  <view wx:if="{{error}}" class="error">{{error}}<button wx:if="{{!attempt}}" class="action tech-control" bindtap="loadAttempt" disabled="{{loading}}">重试</button></view>
  <view wx:if="{{loading}}" class="card muted">正在加载题目与已保存进度…</view>
  <block wx:if="{{attempt && !result}}">
    <view class="attempt-progress"><text class="muted">已作答 {{attempt.completed}} / {{attempt.total}}</text><text wx:if="{{remainingText}}" class="timer {{expired ? 'urgent' : ''}}">{{remainingText}}</text><button class="small tech-control" bindtap="toggleNavigation">{{navigationExpanded ? '收起题号' : '题号'}}</button></view>
    <view wx:if="{{expired}}" class="notice">考试时间已结束，请交卷查看服务器确认的结果。</view>
    <view wx:if="{{savedNote}}" class="notice success">{{savedNote}}</view>
    <view wx:if="{{navigationExpanded}}" class="card question-navigation"><view wx:for="{{navigationGroups}}" wx:key="section" class="navigation-section"><text class="navigation-label">{{item.section}}</text><view class="navigation-grid"><button wx:for="{{item.questions}}" wx:for-item="questionItem" wx:key="id" class="small tech-control {{question && question.id === questionItem.id ? 'selected' : ''}}" data-id="{{questionItem.id}}" bindtap="chooseQuestion" disabled="{{busy || draftSaving}}">{{questionItem.number}}{{questionItem.checked ? ' ✓' : ''}}</button></view></view></view>
    <view wx:if="{{question}}" class="card">
      <view class="question-heading"><text wx:if="{{question.section}}" class="section-label">{{question.section}}</text><text class="badge">{{question.numberLabel}}</text></view>
      <view class="question-text">{{question.prompt}}</view>
      <block wx:if="{{question.passage || question.materialImages.length}}"><button class="action tech-control" bindtap="toggleMaterial">{{materialExpanded ? '收起题目材料' : '展开题目材料'}}{{question.materialTitle ? ' · ' + question.materialTitle : ''}}</button><view wx:if="{{materialExpanded}}" class="material-body"><view wx:for="{{question.materialImages}}" wx:for-item="chart" wx:key="url" class="material-chart-wrap"><image class="material-chart" src="{{chart.url}}" mode="widthFix" data-url="{{chart.url}}" bindtap="previewMaterial"/><text class="muted">{{chart.caption}} · 点击放大</text></view><view wx:if="{{question.passage}}" class="passage">{{question.passage}}</view></view></block>
      <button wx:if="{{question.audioUrl}}" class="action tech-control" bindtap="playAudio" hover-class="tech-pressed">🔊 播放题目音频</button><view wx:if="{{question.guidance}}" class="notice">{{question.guidance}}</view>
      <block wx:if="{{question.options.length}}"><button wx:for="{{question.options}}" wx:key="id" class="option tech-control {{answer === item.id ? 'selected' : ''}} {{feedback && item.id === feedback.correctAnswer ? 'correct' : ''}} {{feedback && feedback.correct === false && answer === item.id ? 'incorrect' : ''}}" data-id="{{item.id}}" bindtap="chooseAnswer" disabled="{{busy || !!feedback || expired}}" hover-class="tech-pressed"><text class="option-label">{{item.id}}.</text><text class="option-copy">{{item.text}}</text></button></block>
      <block wx:else><text class="field-label">我的回答</text><textarea class="tech-input" value="{{answer}}" bindinput="inputAnswer" adjust-position="{{true}}" cursor-spacing="24" maxlength="6000" disabled="{{busy || !!feedback || expired}}" placeholder="写下你的答案，支持保存草稿" /></block>
      <block wx:if="{{!feedback}}"><view class="question-tools"><button wx:if="{{question.hasHint}}" class="small tech-control" bindtap="showHint" loading="{{hintLoading}}" disabled="{{hintLoading || busy || expired}}" hover-class="tech-pressed">{{hint ? '查看提示' : '提示'}}</button><button class="small tech-control" bindtap="saveDraft" loading="{{draftSaving}}" disabled="{{busy || draftSaving || expired}}" hover-class="tech-pressed">保存草稿</button></view><view wx:if="{{hint}}" class="notice">{{hint}}</view></block>
      <view wx:if="{{feedback}}" class="analysis">
        <text class="card-title">{{feedback.correct === null ? '参考范文与自评' : feedback.correct ? '回答正确 ✨' : '看看解题思路'}}</text><view wx:if="{{feedback.correct !== null}}">参考答案：{{feedback.answerText}}</view>
        <text wx:if="{{feedback.explanation}}" class="section-label">详细解析</text><view wx:if="{{feedback.explanation}}" class="notice">{{feedback.explanation}}</view><text wx:if="{{feedback.listeningTranscript}}" class="section-label">听力原文</text><view wx:if="{{feedback.listeningTranscript}}" class="passage">{{feedback.listeningTranscript}}</view>
        <text wx:if="{{feedback.modelAnswer || feedback.referenceAnswer}}" class="section-label">范文 / 参考译文</text><view class="question-text">{{feedback.modelAnswer || feedback.referenceAnswer}}</view><view wx:if="{{feedback.rubricText}}" class="notice">{{feedback.rubricText}}</view>
        <block wx:if="{{feedback.correct === null}}"><text class="muted">请按范文检查内容、结构与语言，完成主观题自评。</text><view class="row" style="margin-top:20rpx"><button class="tab tech-control {{selfAssessment === 'mastered' ? 'selected' : ''}}" data-value="mastered" bindtap="markSelf" disabled="{{busy}}">自评：已掌握</button><button class="tab tech-control {{selfAssessment === 'review' ? 'selected' : ''}}" data-value="review" bindtap="markSelf" disabled="{{busy}}">自评：需复习</button></view></block>
      </view>
    </view>
    <view wx:else class="card"><text class="card-title">{{mode === 'exam' ? '答题已保存' : '本轮练习已完成'}}</text><text class="muted">提交后查看全部解析。</text></view>
    <view class="attempt-actions"><button wx:if="{{question}}" class="tab tech-control" bindtap="finishAttempt" disabled="{{busy || draftSaving}}" hover-class="tech-pressed">{{mode === 'exam' ? '交卷' : '结束练习'}}</button><button wx:if="{{question && !feedback}}" class="tab tech-control tech-primary" bindtap="submitAnswer" loading="{{busy}}" disabled="{{busy || draftSaving || !answer || expired}}" hover-class="tech-pressed">{{mode === 'exam' ? '保存并下一题' : '提交查看解析'}}</button><button wx:elif="{{question && feedback}}" class="tab tech-control tech-primary" bindtap="continueAttempt" disabled="{{busy}}" hover-class="tech-pressed">下一题</button><button wx:else class="tab tech-control tech-primary" bindtap="finishAttempt" disabled="{{busy || draftSaving}}" loading="{{busy}}" hover-class="tech-pressed">{{mode === 'exam' ? '交卷并查看结果' : '查看结果'}}</button></view>
  </block>
  <block wx:if="{{result}}">
    <view class="card"><text class="card-title">本次结果已保存 🎉</text><view class="grid"><view class="stat"><text class="stat-number">{{result.correctCount}} / {{result.objectiveCount}}</text><text class="stat-label">客观题答对</text></view><view class="stat"><text class="stat-number">{{result.objectiveScore}} / {{result.objectiveMaxScore}}</text><text class="stat-label">本卷客观题分数</text></view></view><view class="notice">待自评主观题 {{result.selfCheckPendingCount}} 题。此处为当前题目范围的练习结果，非官方考试分数。</view></view>
    <view wx:for="{{review}}" wx:key="questionId" class="card">
      <text wx:if="{{item.question.section}}" class="section-label">{{item.question.section}}</text><view class="row between"><text class="card-title">{{item.question.numberLabel}}解析</text><text class="badge">{{item.statusText}}</text></view>
      <block wx:if="{{item.question.passage || item.question.materialImages.length}}"><button class="action tech-control" data-index="{{index}}" bindtap="toggleReviewMaterial">{{item.materialExpanded ? '收起原文材料' : '展开原文材料'}}</button><view wx:if="{{item.materialExpanded}}" class="material-body"><view wx:if="{{item.question.passage}}" class="passage">{{item.question.passage}}</view><view wx:for="{{item.question.materialImages}}" wx:for-item="chart" wx:key="url" class="material-chart-wrap"><image class="material-chart" src="{{chart.url}}" mode="widthFix" data-url="{{chart.url}}" bindtap="previewMaterial"/><text class="muted">{{chart.caption}} · 点击放大</text></view></view></block>
      <view class="question-text">{{item.question.prompt}}</view><button wx:if="{{item.question.audioUrl}}" class="action tech-control" data-url="{{item.question.audioUrl}}" bindtap="playAudio">🔊 回听题目音频</button>
      <view wx:for="{{item.question.options}}" wx:for-item="option" wx:key="id" class="review-option {{option.id === item.feedback.correctAnswer ? 'answer-correct' : ''}} {{option.id === item.answer && item.feedback.correct === false ? 'answer-wrong' : ''}}">{{option.id}}. {{option.text}}{{option.id === item.answer ? '（我的选择）' : ''}}{{option.id === item.feedback.correctAnswer ? '（正确选项）' : ''}}</view>
      <text class="section-label">我的答案</text><view class="question-text">{{item.answerText}}</view><text class="section-label">参考答案 / 范文</text><view class="question-text">{{item.feedback.modelAnswer || item.feedback.referenceAnswer || item.feedback.answerText}}</view>
      <text wx:if="{{item.feedback.explanation}}" class="section-label">详细解析</text><view wx:if="{{item.feedback.explanation}}" class="notice">{{item.feedback.explanation}}</view><text wx:if="{{item.feedback.listeningTranscript}}" class="section-label">听力原文</text><view wx:if="{{item.feedback.listeningTranscript}}" class="passage">{{item.feedback.listeningTranscript}}</view><view wx:if="{{item.feedback.rubricText}}" class="notice">{{item.feedback.rubricText}}</view>
      <view wx:if="{{item.subjective}}" class="row" style="margin-top:20rpx"><button class="tab tech-control {{item.feedback.selfAssessment === 'mastered' ? 'selected' : ''}}" data-id="{{item.questionId}}" data-value="mastered" bindtap="markSelf" disabled="{{busy}}">自评：已掌握</button><button class="tab tech-control {{item.feedback.selfAssessment === 'review' ? 'selected' : ''}}" data-id="{{item.questionId}}" data-value="review" bindtap="markSelf" disabled="{{busy}}">自评：需复习</button></view>
    </view><button class="action tech-control tech-primary" bindtap="goHome" hover-class="tech-pressed">返回题库</button>
  </block>
</view>

</block>
