<share-intro wx:if="{{__sharePublic}}" title="{{__shareTitle}}" path="{{__sharePath}}" /><block wx:else>
<view class="gift-page view-page background-{{site.background}} {{backgroundPoster ? 'scenic-view' : ''}}"><image wx:if="{{backgroundPoster}}" class="view-scene" src="{{backgroundPoster}}" mode="aspectFill" /><view wx:if="{{backgroundPoster}}" class="view-scene-shade" /><view wx:if="{{loading}}" class="notice">正在拆开小惊喜…</view><view wx:if="{{error}}" class="error">{{error}}<button class="tech-control" bindtap="load">重新加载</button></view><block wx:if="{{site}}"><view wx:if="{{backgroundVideoUrl}}" class="card native-video-card"><text class="card-title">动态背景预览</text>
      <video wx:for="{{videoPlayers}}" wx:key="id" id="{{item.id}}" class="native-background-video" src="{{item.src}}" poster="{{item.poster}}" data-player="{{item.id}}" data-src="{{item.src}}" autoplay="{{videoAutoplay}}" muted="{{true}}" loop="{{true}}" controls="{{true}}" show-mute-btn="{{false}}" show-fullscreen-btn="{{false}}" object-fit="contain" bindplay="onBackgroundVideoPlay" bindpause="onBackgroundVideoPause" bindwaiting="onBackgroundVideoWaiting" bindtimeupdate="onBackgroundVideoTime" binderror="onBackgroundVideoError" />
      <image wx:if="{{!videoPlayers.length && backgroundVideoPoster && !backgroundVideoPosterError}}" class="native-video-cover" src="{{backgroundVideoPoster}}" mode="aspectFill" data-source="{{backgroundVideoUrl}}" binderror="onBackgroundPosterError" />
      <text class="muted video-status">{{videoError || (videoState === 'playing' ? '正在静音循环播放' : videoState === 'paused' ? '已暂停，点击播放继续预览' : '视频加载中；若未自动播放，请点击播放')}}</text><text wx:if="{{backgroundVideoPosterError}}" class="error">视频封面也未能加载，请检查网络后重试播放。</text>
      <view class="row video-actions"><button class="tech-control" bindtap="toggleBackgroundVideo">{{videoState === 'error' ? '重试播放' : videoState === 'playing' ? '暂停视频' : '播放视频'}}</button></view>
    </view>
<text wx:if="{{site.preview}}" class="notice">免费临时预览 · 内容自动同步，离开编辑器2分钟后回收</text><text class="gift-kicker">A LITTLE GIFT FOR YOU</text><view class="gift-seal">{{site.templateId === 'birthday' ? '🎂' : site.templateId === 'stars' ? '🌙' : demoIcon}}</view><text class="gift-title">{{site.title}}</text><text class="recipient">给 {{site.recipient}}</text><button wx:if="{{!opened}}" class="tech-control tech-primary" bindtap="open">打开这份小惊喜 ✨</button><view wx:else class="card letter"><view wx:if="{{site.templateId === 'birthday'}}" class="cake" bindtap="blow"><view class="candle"><view wx:if="{{candleLit}}" class="flame" /></view><view class="cake-top" /><view class="cake-base" /><text class="muted">{{candleLit ? '许个愿，点一下吹灭蜡烛' : '蜡烛熄灭啦，愿望已收藏 ✦'}}</text></view><view wx:if="{{site.layout}}" class="gift-canvas-preview" style="padding-top:{{canvasPadding}}%"><view wx:for="{{canvasElements}}" wx:key="id" class="gift-canvas-element" style="left:{{item.x}}%;top:{{item.y}}%;width:{{item.width}}%;font-size:{{item.fontSize * canvasFontScale}}px;color:{{item.color}}"><image wx:if="{{item.type === 'image'}}" src="{{item.value}}" mode="widthFix" /><text wx:else>{{item.text}}</text></view></view><block wx:else><text class="muted">Dear {{site.recipient}}</text><text class="letter-message">{{site.message}}</text><text class="sender">{{site.sender || '一个在乎你的人'}}</text></block></view><view wx:if="{{opened && id}}" class="card guestbook"><text class="card-title">朋友们的祝福</text><view wx:for="{{messages}}" wx:key="id" class="guest-note"><text class="card-title">{{item.name}}</text><text class="muted">{{item.message}}</text></view><text wx:if="{{!messages.length}}" class="muted">第一份祝福，就由你送来吧。</text><text class="label">留下一份心意</text><input wx:if="{{!anonymous}}" value="{{messageName}}" data-field="messageName" bindinput="messageInput" maxlength="20" placeholder="你的署名（可不填）" adjust-position="{{true}}" cursor-spacing="24" /><textarea value="{{messageText}}" data-field="messageText" bindinput="messageInput" maxlength="200" placeholder="生日快乐、愿望成真，或者你想对TA说的话…" adjust-position="{{true}}" cursor-spacing="24" /><view class="row"><text class="muted sharing-copy">匿名送出，不显示署名</text><switch checked="{{anonymous}}" color="#b29bd4" bindchange="anonymousChange" /></view><text wx:if="{{messageError}}" class="error">{{messageError}}</text><button class="tech-control tech-primary" bindtap="sendMessage" loading="{{sending}}" disabled="{{sending || !messageText}}">送出祝福 ✦</button></view><text class="muted preview-note">动态背景可在上方静音循环预览；完整网页特效可复制链接在浏览器查看。</text><view class="row"><button class="tech-control" bindtap="copy">复制网站链接</button><button wx:if="{{id}}" class="tech-control tech-primary" open-type="share">分享给朋友</button></view><text wx:if="{{expiresText}}" class="muted">心意保留至 {{expiresText}}</text></block><button class="tech-control home" bindtap="home">我也制作一份 ↗</button></view>

</block>

