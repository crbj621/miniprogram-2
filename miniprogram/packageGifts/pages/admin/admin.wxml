<share-intro wx:if="{{__sharePublic}}" title="{{__shareTitle}}" path="{{__sharePath}}" /><block wx:else>
<view class="gift-page"><view class="gift-header"><text class="gift-title">祝福网站与金币管理</text><button class="tech-control" bindtap="load" loading="{{loading}}">刷新</button></view><view class="notice">用户创建后自动上线；每人最多3个。违规网站可下架，到期自动清理。</view><view wx:if="{{isSuper}}" class="card"><text class="card-title">给同学分发金币 ✦</text><text class="muted">使用校园共享钱包。确认接收人和数量，每笔发放会记录流水与管理员日志。</text><input value="{{keyword}}" data-field="keyword" bindinput="grantInput" placeholder="搜索同学昵称，留空显示最近用户" disabled="{{granting}}" adjust-position="{{true}}" cursor-spacing="24" /><button class="tech-control" bindtap="searchUsers" loading="{{searching}}" disabled="{{searching || granting}}">查找接收同学</button><scroll-view wx:if="{{users.length}}" scroll-y class="user-options"><button wx:for="{{users}}" wx:key="_id" class="tech-control {{selectedUser._id === item._id ? 'selected' : ''}}" data-id="{{item._id}}" bindtap="chooseUser" disabled="{{granting}}">{{item.nickName || '同学'}} · 尾号{{item.shortId}}</button></scroll-view><text wx:if="{{selectedUser}}" class="label">接收人：{{selectedUser.nickName}} · 尾号{{selectedUser.shortId}}</text><text class="label">金币数量</text><input type="number" value="{{amount}}" data-field="amount" bindinput="grantInput" placeholder="1至1000000的整数" maxlength="7" disabled="{{granting}}" adjust-position="{{true}}" cursor-spacing="24" /><text class="label">发放说明（可不填）</text><input value="{{reason}}" data-field="reason" bindinput="grantInput" placeholder="如活动奖励、生日礼物" maxlength="120" disabled="{{granting}}" adjust-position="{{true}}" cursor-spacing="24" /><text wx:if="{{grantError}}" class="error">{{grantError}}</text><text wx:if="{{grantResult}}" class="notice">{{grantResult}}</text><button class="tech-control tech-primary" bindtap="grant" loading="{{granting}}" disabled="{{granting || !selectedUser || !amount}}">确认发放金币</button></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{!loading && !error && !sites.length}}" class="card muted">暂无上线的网站。</view><view wx:for="{{sites}}" wx:key="id" class="card"><text class="card-title">{{item.title}} · {{item.recipient}}</text><text class="muted">{{item.message}}</text><view class="row"><button class="tech-control" data-url="{{item.url}}" bindtap="copy">复制链接</button><button class="tech-control" data-id="{{item.id}}" bindtap="hide">下架</button></view></view></view>

</block>
