<share-intro wx:if="{{__sharePublic}}" title="{{__shareTitle}}" path="{{__sharePath}}" /><block wx:else>
<view class="gift-page"><view class="gift-header"><view><text class="gift-kicker">MADE WITH LOVE</text><text class="gift-title">{{id ? '修改这份心意' : '给 TA 的小惊喜'}}</text></view><button class="back tech-control" bindtap="back">‹ 返回</button></view>
  <view wx:if="{{loading}}" class="notice">正在准备模板…</view><view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{published}}" class="card"><text class="card-title">祝福已经上线 ✨</text><text class="muted">{{published.url}}</text><view class="row"><button class="tech-control" bindtap="copy">复制网站链接</button><button class="tech-control tech-primary" bindtap="view">查看 / 微信分享</button></view></view>
  <block wx:elif="{{catalog && !loading}}">
    <view wx:if="{{backgroundVideoUrl}}" class="card native-video-card"><text class="card-title">动态背景预览</text>
      <video wx:for="{{videoPlayers}}" wx:key="id" id="{{item.id}}" class="native-background-video" src="{{item.src}}" poster="{{item.poster}}" data-player="{{item.id}}" data-src="{{item.src}}" autoplay="{{videoAutoplay}}" muted="{{true}}" loop="{{true}}" controls="{{true}}" show-mute-btn="{{false}}" show-fullscreen-btn="{{false}}" object-fit="contain" bindplay="onBackgroundVideoPlay" bindpause="onBackgroundVideoPause" bindwaiting="onBackgroundVideoWaiting" bindtimeupdate="onBackgroundVideoTime" binderror="onBackgroundVideoError" />
      <image wx:if="{{!videoPlayers.length && backgroundVideoPoster && !backgroundVideoPosterError}}" class="native-video-cover" src="{{backgroundVideoPoster}}" mode="aspectFill" data-source="{{backgroundVideoUrl}}" binderror="onBackgroundPosterError" />
      <text class="muted video-status">{{videoError || (videoState === 'playing' ? '正在静音循环播放' : videoState === 'paused' ? '已暂停，点击播放继续预览' : '视频加载中；若未自动播放，请点击播放')}}</text><text wx:if="{{backgroundVideoPosterError}}" class="error">视频封面也未能加载，请检查网络后重试播放。</text>
      <view class="row video-actions"><button class="tech-control" bindtap="toggleBackgroundVideo">{{videoState === 'error' ? '重试播放' : videoState === 'playing' ? '暂停视频' : '播放视频'}}</button></view>
    </view>
    <view class="card"><text class="label">收件人姓名</text><input value="{{recipient}}" data-field="recipient" bindinput="input" maxlength="24" placeholder="想把祝福送给谁？" adjust-position="{{true}}" cursor-spacing="24" /><text class="label">网站标题</text><input value="{{title}}" data-field="title" bindinput="input" maxlength="40" adjust-position="{{true}}" cursor-spacing="24" /><text class="label">想说的话</text><button class="tech-control" bindtap="recommend">选一段推荐祝福语 ✦</button><textarea value="{{message}}" data-field="message" bindinput="input" maxlength="1200" adjust-position="{{true}}" cursor-spacing="24" /><text class="label">你的署名（可不填）</text><input value="{{sender}}" data-field="sender" bindinput="input" maxlength="24" adjust-position="{{true}}" cursor-spacing="24" /></view>
    <view class="card"><text class="card-title">背景与特效</text><text class="muted">所有效果都能免费预览。首次2小时体验全免费；长期网站只在你确认上线时按选择计费。</text><text class="label">静态背景 · 免费</text><view class="choices"><button wx:for="{{staticBackgrounds}}" wx:key="id" class="tech-control {{background === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseBackground">{{item.name}}</button></view><text class="label">动态背景 · 持续播放的视频</text><view class="choices landscape-choices"><button wx:for="{{dynamicBackgrounds}}" wx:key="id" class="tech-control {{background === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseBackground"><image wx:if="{{item.posterUrl}}" class="landscape-thumbnail" src="{{item.posterUrl}}" mode="aspectFill" /><text class="landscape-name">{{item.name}}</text><text class="effect-price">{{trial ? '体验免费' : item.purchased ? '本网站已购' : '+' + item.price + ' 金币'}}</text></button></view><view wx:if="{{backgroundPoster && !selectedBackgroundVideo}}" class="landscape-preview"><image src="{{backgroundPoster}}" mode="aspectFill" /><view><text class="card-title">{{backgroundDescription}}</text><text class="muted">静态风景图片，不包含背景动画</text></view></view><text class="label">点选特效，可搭配多个</text><view class="choices"><button wx:for="{{effectOptions}}" wx:key="id" class="tech-control {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseEffect">{{item.selected ? '✓ ' : ''}}{{item.name}}<text class="effect-price">{{trial ? '体验免费' : item.purchased ? '本网站已购' : item.price ? '+' + item.price + ' 金币' : '免费效果'}}</text></button></view></view>
    
    <view class="card"><text class="card-title">自由排版</text><text class="muted">拆信后的内容可以拖动排列，也能添加文字、贴纸、照片；最多12个元素。长文可增加画布高度。</text><button class="tech-control" bindtap="toggleLayout">{{layout ? '恢复自动排版' : '启用自由排版 ✦'}}</button>
      <block wx:if="{{layout}}"><view class="row"><button class="tech-control" data-type="text" bindtap="addElement">＋ 文字</button><button class="tech-control" data-type="sticker" bindtap="addElement">＋ 贴纸</button><button class="tech-control" data-type="image" bindtap="addElement" loading="{{uploading}}" disabled="{{uploading}}">＋ 图片</button></view><text class="label">画布高度 {{layout.height}}</text><slider min="500" max="1600" step="50" value="{{layout.height}}" bindchange="canvasHeight" activeColor="#bd93cb" />
        <movable-area id="gift-canvas" class="editor-canvas canvas-background-{{background}}" style="height:{{canvasHeight}}px"><movable-view wx:for="{{canvasElements}}" wx:key="id" direction="all" x="{{item.px}}" y="{{item.py}}" inertia="{{false}}" animation="{{false}}" data-id="{{item.id}}" bindchange="moveElement" bindtap="selectElement" class="canvas-item {{selectedId === item.id ? 'canvas-selected' : ''}}" style="width:{{item.width}}%;font-size:{{item.size}}px;color:{{item.color}}"><image wx:if="{{item.type === 'image'}}" src="{{item.value}}" mode="widthFix" /><text wx:else>{{item.text}}</text></movable-view></movable-area>
        <view wx:if="{{selectedElement}}" class="element-controls"><text class="label">编辑选中元素</text><textarea wx:if="{{selectedElement.type === 'text' || selectedElement.type === 'sticker'}}" value="{{selectedElement.value}}" data-field="value" bindinput="changeElement" maxlength="300" adjust-position="{{true}}" cursor-spacing="24" /><text wx:else class="muted">标题、姓名、正文、署名使用上面填写的内容。拖动可改变位置。</text><text class="label">文字大小 {{selectedElement.fontSize}}</text><slider min="12" max="48" value="{{selectedElement.fontSize}}" data-field="fontSize" bindchange="changeElement" activeColor="#bd93cb" /><text class="label">元素宽度 {{selectedElement.width}}%</text><slider min="10" max="100" value="{{selectedElement.width}}" data-field="width" bindchange="changeElement" activeColor="#bd93cb" /><view class="choices"><button data-field="color" data-color="#906489" bindtap="changeElement">香芋</button><button data-field="color" data-color="#d782a2" bindtap="changeElement">桃粉</button><button data-field="color" data-color="#458c95" bindtap="changeElement">湖蓝</button><button data-field="color" data-color="#574f65" bindtap="changeElement">墨色</button></view><button class="tech-control" bindtap="removeElement">移除这个元素</button></view>
      </block>
    </view>
<view wx:if="{{!id}}" class="card"><text class="card-title">选择保留多久</text><view class="choices"><button wx:if="{{catalog.trialAvailable}}" class="tech-control {{trial ? 'selected' : ''}}" bindtap="chooseTrial">首次免费 · 2小时全特效</button><button wx:for="{{catalog.durations}}" wx:key="id" class="tech-control {{!trial && durationId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseDuration">{{item.name}}<text class="effect-price">{{item.price ? item.price + ' 金币' : '基础版免费'}}</text></button></view><text class="muted">最长1个月；背景、特效、自定义域名另计。到期后链接失效，内容自动清理。</text><block wx:if="{{!trial}}"><text class="label">自定义子域名（另加5金币，可不填）</text><input value="{{domainLabel}}" data-field="domainLabel" bindinput="input" maxlength="32" placeholder="如 xiaoyu，得到 xiaoyu.crbuj.icu" adjust-position="{{true}}" cursor-spacing="24" /><text class="muted">3—32位英文、数字或短横线，字母开头。默认随机地址免费。</text></block><text wx:else class="muted">首次2小时体验使用随机域名，全部背景和特效免费开放。</text></view>
    <view class="card"><view class="row"><view class="sharing-copy"><text class="card-title">公示到祝福广场</text><text class="muted">关闭则不列出，拿到链接的朋友仍可查看、署名或匿名留言。</text></view><switch checked="{{listed}}" color="#b29bd4" bindchange="chooseListed" /></view></view><view class="card preview-panel"><text class="card-title">先预览，满意再上线</text><text class="muted">画布实时显示；网页同步姓名、布局和效果。编辑中自动续期，离开2分钟后回收临时网站。</text><text wx:if="{{preview}}" class="preview-url">{{preview.url}}</text><text wx:if="{{preview}}" class="sync-state">{{previewSyncing ? '正在同步到网页…' : previewError ? previewError : '✓ 已同步，预览不收费'}}</text><view class="row"><button class="tech-control" bindtap="previewWebsite" loading="{{previewSyncing}}">{{preview ? '更新免费预览' : '生成免费预览'}}</button><button wx:if="{{preview}}" class="tech-control" bindtap="copyPreview">复制网页预览链接</button></view></view><view class="notice">本次 {{price}} 金币 · 当前 {{catalog.coins}} 金币<text class="muted">姓名、文案、排版、静态背景与已购效果免费修改。预览不扣金币、不占用免费体验资格。</text></view><button class="tech-control tech-primary publish" bindtap="submit" loading="{{saving}}" disabled="{{saving || uploading || price > catalog.coins}}">{{saving ? '正在上线…' : id ? '保存修改 ✦' : '预览满意，确认上线 ✦'}}</button>
  </block>
</view>

</block>
