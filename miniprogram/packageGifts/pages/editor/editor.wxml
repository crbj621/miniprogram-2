<share-intro wx:if="{{__sharePublic}}" title="{{__shareTitle}}" path="{{__sharePath}}" /><block wx:else>
<view class="gift-page editor-page">
  <view class="gift-header"><view><text class="gift-kicker">LITTLE WISHES · 校园小站</text><text class="gift-title">{{id ? '修改这份心意' : '三步，送出小惊喜'}}</text></view><button class="back tech-control" bindtap="back">‹ 返回</button></view>
  <view wx:if="{{loading}}" class="notice">正在准备模板…</view>
  <view wx:if="{{error}}" class="error">{{error}}<button wx:if="{{!catalog && !loading}}" class="tech-control" bindtap="load">重新加载</button></view>
  <view wx:if="{{published}}" class="card"><text class="card-title">祝福已经上线 ✨</text><text class="preview-url">{{published.url}}</text><view class="row"><button class="tech-control" bindtap="copy">复制网站链接</button><button class="tech-control tech-primary" bindtap="view">查看 / 微信分享</button></view></view>
  <block wx:elif="{{catalog && !loading}}">
    <view class="editor-steps">
      <button class="step-button {{editorStep === 1 ? 'step-active' : ''}}" data-step="1" bindtap="goToStep" disabled="{{!!id || saving || uploading}}"><text class="step-number">1</text><text>选模板</text></button>
      <button class="step-button {{editorStep === 2 ? 'step-active' : ''}}" data-step="2" bindtap="goToStep" disabled="{{saving || uploading}}"><text class="step-number">2</text><text>写祝福</text></button>
      <button class="step-button {{editorStep === 3 ? 'step-active' : ''}}" data-step="3" bindtap="goToStep" disabled="{{saving || uploading || previewSyncing}}"><text class="step-number">3</text><text>预览发布</text></button>
    </view>
    <view wx:if="{{editorStep === 1}}" class="card">
      <text class="card-title">挑一个喜欢的故事 ✿</text><text class="muted">标题和祝福语已替你准备好，下一步可以改成自己的话。</text>
      <view class="template-grid"><button wx:for="{{catalog.templates}}" wx:key="id" class="template-option tech-control {{templateId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseTemplate"><text class="template-icon">{{item.icon}}</text><text class="template-name">{{item.name}}</text><text class="template-description">{{item.description}}</text><text class="template-check">{{templateId === item.id ? '✓ 已选择' : '选择这个'}}</text></button></view>
    </view>
    <view wx:if="{{editorStep === 2}}" class="card simple-form">
      <view class="section-row"><text class="card-title">把心意写下来</text><text class="small-tag">{{templateName}}</text></view>
      <text class="label">送给谁？</text><input value="{{recipient}}" data-field="recipient" bindinput="input" maxlength="24" placeholder="填写收件人的名字" adjust-position="{{true}}" cursor-spacing="24" />
      <view class="section-row message-heading"><text class="label">想对 TA 说</text><button class="suggestion-button tech-control" bindtap="recommend">帮我选一句 ✦</button></view>
      <textarea class="wish-input" value="{{message}}" data-field="message" bindinput="input" maxlength="1200" placeholder="写下你的祝福…" disable-default-padding="{{true}}" adjust-position="{{true}}" cursor-spacing="24" />
    </view>
    <view class="card scene-card">
      <view class="section-row"><text class="card-title">{{editorStep === 3 ? '这份心意的背景' : '背景预览'}}</text><text class="small-tag">{{selectedBackgroundVideo ? '循环视频' : '静态背景'}}</text></view>
      <view class="scene-preview canvas-background-{{background}}">
        <block wx:if="{{backgroundVideoUrl}}">
          <video wx:for="{{videoPlayers}}" wx:key="id" id="{{item.id}}" class="scene-media native-background-video" src="{{item.src}}" poster="{{item.poster}}" data-player="{{item.id}}" data-src="{{item.src}}" autoplay="{{videoAutoplay}}" muted="{{true}}" loop="{{true}}" controls="{{true}}" show-mute-btn="{{false}}" show-fullscreen-btn="{{false}}" object-fit="cover" bindplay="onBackgroundVideoPlay" bindpause="onBackgroundVideoPause" bindwaiting="onBackgroundVideoWaiting" bindtimeupdate="onBackgroundVideoTime" binderror="onBackgroundVideoError" />
          <image wx:if="{{!videoPlayers.length && backgroundVideoPoster && !backgroundVideoPosterError}}" class="scene-media native-video-cover" src="{{backgroundVideoPoster}}" mode="aspectFill" data-source="{{backgroundVideoUrl}}" binderror="onBackgroundPosterError" />
          <view wx:if="{{!videoPlayers.length && (!backgroundVideoPoster || backgroundVideoPosterError)}}" class="scene-empty"><text class="scene-flower">✿</text><text>视频暂未播放，点击下方重试</text></view>
        </block>
        <image wx:elif="{{backgroundPoster && !backgroundPosterError}}" class="scene-media" src="{{backgroundPoster}}" mode="aspectFill" data-background="{{background}}" binderror="onSceneImageError" />
        <view wx:else class="scene-empty"><text class="scene-flower">✿</text><text>{{backgroundPosterError ? '图片未能加载，请检查网络' : backgroundName}}</text></view>
      </view>
      <view class="scene-footer"><text class="scene-name">{{backgroundName}}</text><button wx:if="{{backgroundVideoUrl}}" class="scene-play tech-control" bindtap="toggleBackgroundVideo">{{videoState === 'error' ? '重试播放' : videoState === 'playing' ? '暂停视频' : '播放视频'}}</button><button wx:elif="{{backgroundPosterError}}" class="scene-play tech-control" bindtap="retrySceneImage">重试图片</button></view>
      <text wx:if="{{backgroundVideoUrl}}" class="muted video-status">{{videoError || (videoState === 'playing' ? '正在静音循环播放' : videoState === 'paused' ? '已暂停，点击播放继续' : '视频加载中；若未自动播放，请点击播放')}}</text>
      <text wx:if="{{editorStep === 3}}" class="muted">拆信、蛋糕和完整特效，请打开下方的免费网页预览链接体验。</text>
    </view>
    <block wx:if="{{editorStep === 2}}">
      <button class="advanced-toggle tech-control" bindtap="toggleAdvanced" aria-expanded="{{advancedOpen}}"><view><text class="advanced-title">更多设置 <text class="optional">选填</text></text><text class="advanced-description">标题、署名、背景、特效、自由排版</text></view><text>{{advancedOpen ? '收起 ⌃' : '展开 ⌄'}}</text></button>
      <block wx:if="{{advancedOpen}}">
        <view class="card"><text class="card-title">添一点你的风格</text><text class="label">网站标题</text><input value="{{title}}" data-field="title" bindinput="input" maxlength="40" adjust-position="{{true}}" cursor-spacing="24" /><text class="label">你的署名（可不填）</text><input value="{{sender}}" data-field="sender" bindinput="input" maxlength="24" placeholder="留下你的名字" adjust-position="{{true}}" cursor-spacing="24" /></view>
        <view class="card"><text class="card-title">换个背景</text><text class="muted">选中后，上方同一个预览框会切换。预览免费，确认上线时才计费。</text><text class="label">静态背景 · 免费</text>
          <view class="choices landscape-choices"><button wx:for="{{staticBackgrounds}}" wx:key="id" class="tech-control {{background === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseBackground"><image wx:if="{{item.posterUrl}}" class="landscape-thumbnail" src="{{item.posterUrl}}" mode="aspectFill" /><view wx:else class="background-swatch canvas-background-{{item.id}}">✿</view><text class="landscape-name">{{item.name}}</text><text class="effect-price">免费背景</text></button></view>
          <text class="label">动态背景 · 持续播放的视频</text><view class="choices landscape-choices"><button wx:for="{{dynamicBackgrounds}}" wx:key="id" class="tech-control {{background === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseBackground"><image class="landscape-thumbnail" src="{{item.posterUrl}}" mode="aspectFill" /><text class="landscape-name">▶ {{item.name}}</text><text class="effect-price">{{trial ? '体验免费' : item.purchased ? '本网站已购' : '+' + item.price + ' 金币'}}</text></button></view>
        </view>
        <view class="card"><text class="card-title">点亮小特效</text><text class="muted">可搭配多个，完整效果在免费网页预览中展示。</text><view class="choices effect-choices"><button wx:for="{{effectOptions}}" wx:key="id" class="tech-control {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseEffect">{{item.selected ? '✓ ' : ''}}{{item.name}}<text class="effect-price">{{trial ? '体验免费' : item.purchased ? '本网站已购' : item.price ? '+' + item.price + ' 金币' : '免费效果'}}</text></button></view></view>
        <view class="card"><text class="card-title">自由排版</text><text class="muted">默认自动排版。想自己摆放时再开启，可拖动文字、贴纸、照片，最多12个元素。</text><button class="tech-control layout-toggle" bindtap="toggleLayout">{{layout ? '恢复自动排版' : '启用自由排版 ✦'}}</button>
          <block wx:if="{{layout}}">
            <view class="row"><button class="tech-control" data-type="text" bindtap="addElement">＋ 文字</button><button class="tech-control" data-type="sticker" bindtap="addElement">＋ 贴纸</button><button class="tech-control" data-type="image" bindtap="addElement" loading="{{uploading}}" disabled="{{uploading}}">＋ 图片</button></view>
            <text class="label">画布高度 {{layout.height}}</text><slider min="500" max="1600" step="50" value="{{layout.height}}" bindchange="canvasHeight" activeColor="#bd93cb" />
            <movable-area id="gift-canvas" class="editor-canvas canvas-background-{{background}}" style="height:{{canvasHeight}}px"><movable-view wx:for="{{canvasElements}}" wx:key="id" direction="all" x="{{item.px}}" y="{{item.py}}" inertia="{{false}}" animation="{{false}}" data-id="{{item.id}}" bindchange="moveElement" bindtap="selectElement" class="canvas-item {{selectedId === item.id ? 'canvas-selected' : ''}}" style="width:{{item.width}}%;font-size:{{item.size}}px;color:{{item.color}}"><image wx:if="{{item.type === 'image'}}" src="{{item.value}}" mode="widthFix" /><text wx:else>{{item.text}}</text></movable-view></movable-area>
            <view wx:if="{{selectedElement}}" class="element-controls"><text class="label">编辑选中元素</text><textarea wx:if="{{selectedElement.type === 'text' || selectedElement.type === 'sticker'}}" value="{{selectedElement.value}}" data-field="value" bindinput="changeElement" maxlength="300" disable-default-padding="{{true}}" adjust-position="{{true}}" cursor-spacing="24" /><text wx:else class="muted">标题、姓名、正文、署名使用填写的内容。拖动可改变位置。</text>
              <text class="label">文字大小 {{selectedElement.fontSize}}</text><slider min="12" max="48" value="{{selectedElement.fontSize}}" data-field="fontSize" bindchange="changeElement" activeColor="#bd93cb" /><text class="label">元素宽度 {{selectedElement.width}}%</text><slider min="10" max="100" value="{{selectedElement.width}}" data-field="width" bindchange="changeElement" activeColor="#bd93cb" /><view class="choices"><button data-field="color" data-color="#906489" bindtap="changeElement">香芋</button><button data-field="color" data-color="#d782a2" bindtap="changeElement">桃粉</button><button data-field="color" data-color="#458c95" bindtap="changeElement">湖蓝</button><button data-field="color" data-color="#574f65" bindtap="changeElement">墨色</button></view><button class="tech-control" bindtap="removeElement">移除这个元素</button>
            </view>
          </block>
        </view>
      </block>
    </block>
    <block wx:if="{{editorStep === 3}}">
      <view class="card preview-panel"><text class="card-title">先免费试看，再决定上线</text><view class="wish-summary"><text class="wish-summary-title">{{title}}</text><text class="muted">送给 {{recipient}}</text><text class="wish-summary-message">{{message}}</text><text wx:if="{{sender}}" class="wish-summary-sender">—— {{sender}}</text></view><text class="muted">{{templateName}} · {{layout ? '自由排版' : '自动排版'}}</text>
        <text class="sync-state {{previewError ? 'sync-error' : ''}}">{{previewSyncing ? '正在同步到网页…' : previewError ? previewError : preview ? '✓ 已同步，预览不收费' : '免费预览尚未准备好'}}</text><text wx:if="{{preview}}" class="preview-url">{{preview.url}}</text>
        <view class="row"><button class="tech-control" bindtap="previewWebsite" loading="{{previewSyncing}}" disabled="{{previewSyncing || saving}}">{{previewError ? '重试免费预览' : '更新免费预览'}}</button><button class="tech-control" bindtap="copyPreview" disabled="{{!preview || previewSyncing || !!previewError}}">复制网站预览链接</button></view>
        <text class="muted preview-help">复制后用浏览器打开。编辑中自动续期，离开2分钟后临时预览回收。</text>
      </view>
      <view wx:if="{{!id}}" class="card"><text class="card-title">想让心意保留多久？</text><button wx:if="{{catalog.trialAvailable}}" class="trial-choice tech-control {{trial ? 'selected' : ''}}" bindtap="chooseTrial">首次免费 · 2小时全特效体验</button><view class="choices"><button wx:for="{{catalog.durations}}" wx:key="id" class="tech-control {{!trial && durationId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseDuration">{{item.name}}<text class="effect-price">{{item.price ? item.price + ' 金币' : '基础版免费'}}</text></button></view><text class="muted duration-help">最长1个月。正式网站到期后链接失效，内容自动清理。</text></view>
      <view class="card price-card"><view class="section-row"><text class="card-title">确认这份心意</text><text class="total-price">{{price}} <text>金币</text></text></view>
        <view wx:for="{{priceBreakdown}}" wx:key="name" class="price-line"><text>{{item.name}}</text><text>{{item.price}} 金币</text></view><text wx:if="{{!priceBreakdown.length}}" class="muted">{{trial ? '首次体验：全部背景与特效免费' : '当前选择无需支付金币'}}</text>
        <text class="muted">保留 {{durationText}} · 当前余额 {{catalog.coins}} 金币</text><text wx:if="{{price > catalog.coins}}" class="error">还差 {{price - catalog.coins}} 金币，可以返回调整背景和特效。</text><text class="muted">预览不会扣金币；点击发布后，还会让你确认一次。</text>
      </view>
      <button class="advanced-toggle tech-control" bindtap="toggleAdvanced" aria-expanded="{{advancedOpen}}"><view><text class="advanced-title">分享设置 <text class="optional">选填</text></text><text class="advanced-description">广场公示、自定义子域名</text></view><text>{{advancedOpen ? '收起 ⌃' : '展开 ⌄'}}</text></button>
      <view wx:if="{{advancedOpen}}" class="card"><view class="row sharing-row"><view class="sharing-copy"><text class="card-title">公示到祝福广场</text><text class="muted">关闭则不列出，拿到链接的朋友仍可查看、署名或匿名留言。</text></view><switch checked="{{listed}}" color="#b29bd4" bindchange="chooseListed" /></view>
        <block wx:if="{{!id && !trial}}"><text class="label">自定义子域名（另加{{catalog.customDomainPrice}}金币，可不填）</text><input value="{{domainLabel}}" data-field="domainLabel" bindinput="input" maxlength="32" placeholder="如 xiaoyu，得到 xiaoyu.crbuj.icu" adjust-position="{{true}}" cursor-spacing="24" /><text class="muted">3—32位英文、数字或短横线，字母开头。默认随机地址免费。</text></block><text wx:elif="{{trial}}" class="muted">首次体验使用随机域名。</text>
      </view>
    </block>
    <view class="editor-actions row">
      <button wx:if="{{editorStep > 1 && !id}}" class="tech-control" data-step="{{editorStep - 1}}" bindtap="goToStep" disabled="{{saving || uploading}}">上一步</button><button wx:elif="{{id && editorStep === 3}}" class="tech-control" data-step="2" bindtap="goToStep" disabled="{{saving || uploading}}">修改内容</button>
      <button wx:if="{{editorStep < 3}}" class="tech-control tech-primary" data-step="{{editorStep + 1}}" bindtap="goToStep" loading="{{previewSyncing}}" disabled="{{saving || uploading || previewSyncing}}">{{editorStep === 1 ? '下一步 · 写祝福' : '下一步 · 免费预览'}}</button><button wx:else class="tech-control tech-primary" bindtap="submit" loading="{{saving}}" disabled="{{saving || uploading || previewSyncing || !preview || !!previewError || price > catalog.coins}}">{{saving ? '正在上线…' : id ? '确认保存 · ' + price + '金币' : '确认发布 · ' + price + '金币'}}</button>
    </view>
    <text class="muted action-help">{{editorStep === 3 ? '发布前会再次确认费用和有效期' : '这一步不收费，返回修改不会丢失内容'}}</text>
  </block>
</view>
</block>
