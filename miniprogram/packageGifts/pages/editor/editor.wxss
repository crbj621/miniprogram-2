@import "../../styles/gifts.wxss";
.editor-page .gift-header { margin-bottom:20rpx; }
.editor-page .gift-title { font-size:34rpx; }
.editor-steps { display:flex; gap:12rpx; padding:12rpx; border-radius:28rpx; background:#ffffffa8; border:2rpx solid #fff; }
.editor-page .step-button { flex:1; width:0; min-width:0; min-height:112rpx; padding:14rpx 4rpx; background:transparent; font-size:22rpx; color:#ab91a7; }
.step-button > text { display:block; }
.step-number { width:38rpx; height:38rpx; line-height:38rpx; margin:0 auto 8rpx; border-radius:50%; background:#eee8f1; font-weight:700; }
.editor-page .step-active { background:linear-gradient(145deg,#f1e6ff,#ffe9f0); color:#80588e; box-shadow:0 6rpx 14rpx #ad8bcb16; }
.step-active .step-number { background:#b58acb; color:#fff; }
.template-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18rpx; margin-top:22rpx; }
.editor-page .template-option { display:flex; flex-direction:column; align-items:flex-start; text-align:left; padding:24rpx 20rpx; border:2rpx solid #eee4ef; background:#fffcfe; }
.editor-page .template-option.selected,.editor-page .trial-choice.selected { border-color:#cba8da; background:#f1e6fb; color:#8e5999; }
.template-icon { font-size:42rpx; line-height:1.4; margin-bottom:10rpx; }
.template-name { font-size:27rpx; font-weight:700; }
.template-description { font-size:21rpx; color:#aa8fa6; line-height:1.8; margin-top:8rpx; }
.template-check { font-size:21rpx; color:#9b76aa; margin-top:auto; padding-top:18rpx; }
.section-row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; min-width:0; }
.section-row .card-title { margin-bottom:0; flex:1; min-width:0; }
.small-tag { max-width:44%; flex-shrink:0; font-size:20rpx; padding:8rpx 14rpx; border-radius:14rpx; background:#f2ebfa; color:#a085b0; text-align:center; }
.simple-form .label { margin-top:22rpx; }
.message-heading { margin:22rpx 0 12rpx; }
.message-heading .label { margin:0; }
.editor-page .suggestion-button { width:auto; min-height:68rpx; padding:12rpx 16rpx; font-size:21rpx; }
.editor-page .wish-input { height:210rpx; }
.scene-preview { position:relative; height:310rpx; overflow:hidden; border-radius:22rpx; margin-top:20rpx; }
.editor-page .scene-media { display:block; width:100%; height:100%; border-radius:0; }
.scene-empty { width:100%; height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16rpx; color:#a27fa7; font-size:23rpx; text-align:center; padding:20rpx; box-sizing:border-box; }
.scene-flower { font-size:82rpx; color:#d2afcf; text-shadow:0 8rpx 24rpx #e0a9c866; }
.scene-footer { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-top:16rpx; }
.scene-name { font-size:25rpx; font-weight:650; flex:1; min-width:0; }
.editor-page .scene-play { width:auto; flex-shrink:0; min-height:76rpx; padding:14rpx 18rpx; font-size:22rpx; }
.editor-page .advanced-toggle { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding:24rpx; text-align:left; background:#ffffffb8; border:2rpx dashed #e0cee8; }
.advanced-toggle > view { flex:1; min-width:0; }
.advanced-toggle > text { font-size:22rpx; flex-shrink:0; }
.advanced-title { display:block; font-size:26rpx; font-weight:650; }
.optional { font-size:19rpx; font-weight:400; margin-left:8rpx; color:#b59bb6; }
.advanced-description { display:block; font-size:21rpx; line-height:1.8; color:#ad93a6; margin-top:4rpx; }
.editor-page .landscape-thumbnail,.background-swatch { height:136rpx; }
.background-swatch { display:flex; align-items:center; justify-content:center; font-size:52rpx; color:#c8a5cb; }
.effect-choices { margin-top:20rpx; }
.layout-toggle { margin-top:16rpx !important; }
.wish-summary { margin:22rpx 0; padding:24rpx; background:#ffffffa8; border-radius:20rpx; }
.wish-summary-title { display:block; font-size:28rpx; font-weight:700; line-height:1.7; margin-bottom:10rpx; }
.wish-summary-message { display:-webkit-box; -webkit-line-clamp:4; -webkit-box-orient:vertical; overflow:hidden; font-size:25rpx; line-height:1.9; white-space:pre-wrap; word-break:break-all; margin-top:18rpx; }
.wish-summary-sender { display:block; text-align:right; font-size:23rpx; margin-top:18rpx; }
.sync-error { color:#b36a84; }
.preview-help,.duration-help { margin-top:18rpx; }
.editor-page .trial-choice { margin:20rpx 0 16rpx; border:2rpx solid #eee4ef; }
.total-price { font-size:42rpx; font-weight:750; color:#9e76b3; flex-shrink:0; }
.total-price text { font-size:22rpx; font-weight:400; }
.price-line { display:flex; align-items:center; justify-content:space-between; gap:16rpx; font-size:24rpx; line-height:1.8; padding:10rpx 0; border-bottom:2rpx dashed #f0e8f0; }
.price-card > .muted { margin-top:16rpx; }
.sharing-row { margin-top:0; align-items:center; }
.editor-actions { margin-top:26rpx; }
.editor-actions button { min-height:90rpx; padding:22rpx 12rpx; font-size:24rpx; }
.action-help { font-size:21rpx; text-align:center; margin-top:16rpx; }
