<share-intro wx:if="{{__sharePublic}}" title="{{__shareTitle}}" path="{{__sharePath}}" /><block wx:else>
<view class="rank-page">
  <view class="rank-header"><view><text class="rank-kicker">CAMPUS / HALL OF FAME</text><text class="rank-title">{{activeTab === 'couple' ? pairCopy.title : pageCopy.title}}</text><text class="rank-subtitle">{{pageCopy.subtitle}}</text></view><button class="refresh-btn tech-control" bindtap="refreshPage" loading="{{isLoading}}" disabled="{{isLoading}}" hover-class="tap-feedback tech-pressed">↻</button></view>
  <view class="rank-tabs"><button class="{{activeTab === 'daily' ? 'active' : ''}} tech-control" data-tab="daily" bindtap="switchTab" hover-class="tap-feedback tech-pressed">今日</button><button class="{{activeTab === 'monthly' ? 'active' : ''}} tech-control" data-tab="monthly" bindtap="switchTab" hover-class="tap-feedback tech-pressed">本月</button><button class="pair-tab {{activeTab === 'couple' ? 'active' : ''}} tech-control" data-tab="couple" bindtap="switchTab" hover-class="tap-feedback tech-pressed">搭子和情侣</button><button class="{{activeTab === 'god' ? 'active' : ''}} tech-control" data-tab="god" bindtap="switchTab" hover-class="tap-feedback tech-pressed">单次最佳</button></view>
  <view class="rank-rule">{{activeTab === 'daily' ? '北京时间今日累计里程 · 前 100 名' : (activeTab === 'monthly' ? '北京时间本月累计里程 · 前 100 名' : (activeTab === 'couple' ? '双人搭子 / 情侣 · 同一对成员组队期间的累计里程 · 前 100 对' : '历史单次跑步距离 · 前 10 条'))}}</view>
  <mahiro-scroll id="page-refresh" class="rank-scroll" bindrefresh="refreshPage">
    <view class="competition-banner" wx:if="{{activeTab === 'couple'}}"><text class="competition-symbol">✦</text><view><text class="competition-title">双人成绩，双倍荣光</text><text class="competition-note">{{pairCopy.subtitle}}</text></view></view>
    <view class="podium" wx:if="{{rankList.length}}"><block wx:for="{{rankList}}" wx:key="_id"><view wx:if="{{index < 3}}" class="podium-card podium-card--{{index}} tech-card"><text class="podium-crown">{{index === 0 ? '♛' : '✦'}}</text><text class="podium-medal">{{item.medal}}</text><text class="podium-number">NO.0{{index + 1}}</text><view class="podium-avatar"><image wx:if="{{activeTab !== 'couple' && item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" /><text wx:else>{{activeTab === 'couple' ? '双' : '跑'}}</text></view><text class="podium-name">{{activeTab === 'couple' ? item.name1 + ' × ' + item.name2 : item.nickName}}</text><text class="podium-distance">{{item.distance}}<text> 米</text></text><text class="podium-level">{{index === 0 ? (activeTab === 'couple' ? '这一刻，全场为你们喝彩' : '这一刻，全场为你喝彩') : (index === 1 ? '再向前一步，就到顶峰' : (activeTab === 'couple' ? '站上领奖台，超棒的你们' : '站上领奖台，超棒的你'))}}</text><text class="podium-gap">{{item.gapText}}</text></view></block></view>
    <view class="my-rank tech-card" wx:if="{{isLoggedIn}}"><text class="my-rank-label">{{activeTab === 'couple' ? '我们的战绩' : '我的高光'}}</text><text wx:if="{{myRank}}">第 {{myRank.position}} 名 · {{myRank.distance}} 米</text><text wx:else>完成并保存运动，来争一席之位</text><text class="my-rank-gap" wx:if="{{myRank}}">{{myRank.gapText}}</text></view>
    <view class="rank-list"><block wx:for="{{rankList}}" wx:key="_id"><view wx:if="{{index >= 3}}" class="rank-row {{item.isMine ? 'rank-row--mine' : ''}} tech-card"><text class="row-rank">{{index + 1}}</text><view class="row-avatar"><image wx:if="{{activeTab !== 'couple' && item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" /><text wx:else>{{activeTab === 'couple' ? '双' : '跑'}}</text></view><view class="row-info"><text class="row-name">{{activeTab === 'couple' ? item.name1 + ' × ' + item.name2 : item.nickName}}</text><text class="row-detail">{{item.gapText}}</text><text class="row-detail" wx:if="{{activeTab === 'god'}}">{{item.date}} · 单次成绩</text></view><view class="row-distance"><text>{{item.distance}}</text><text class="row-unit">米</text></view></view></block></view>
    <view wx:if="{{!rankList.length}}" class="rank-empty"><tech-loader wx:if="{{isLoading}}"/><text class="empty-symbol" wx:else>◎</text><text class="empty-title">{{isLoading ? '正在整理运动成绩…' : (loadError ? '成绩暂时没有加载成功' : '等待第一位校园跑者')}}</text><text class="empty-note">{{loadError ? '下拉刷新或点击右上角重试' : '完成运动并保存后，成绩会出现在这里'}}</text></view>
  </mahiro-scroll><run-tabbar selected="{{1}}" />
</view>

</block>
