@import "../../styles/campus-ui.wxss";
page { height: 100%; background: #f0f5fa; color: #203c53; }.rank-page { height: 100vh; display: flex; flex-direction: column; padding-bottom: calc(128rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }.rank-header { padding: 32rpx 28rpx; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; background: #fff; }.rank-header > view { flex: 1; min-width: 0; }.rank-kicker,.rank-title,.rank-subtitle { display: block; }.rank-kicker { font-size: 18rpx; letter-spacing: 3rpx; color: #6097b6; }.rank-title { font-size: 34rpx; font-weight: 800; margin-top: 12rpx; }.rank-subtitle { font-size: 23rpx; color: #8c9fae; margin-top: 10rpx; }.refresh-btn { width: 76rpx; min-width: 76rpx; height: 76rpx; padding: 0; margin: 0; font-size: 38rpx; color: #4b92bc; background: #edf7ff; border-radius: 24rpx; line-height: 76rpx; }.rank-tabs { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 10rpx; padding: 24rpx 28rpx 16rpx; }.rank-tabs button { margin: 0; padding: 0 8rpx; height: 82rpx; line-height: 82rpx; border-radius: 22rpx; background: #e3ecf3; color: #7491a6; font-size: 25rpx; }.rank-tabs .active { background: linear-gradient(120deg,#348fca,#35b0c3); color: #fff; box-shadow: 0 8rpx 20rpx #399ac32b; }.rank-rule { margin: 0 28rpx 18rpx; color: #8a9eae; font-size: 21rpx; line-height: 1.5; }.rank-scroll { flex: 1; min-height: 0; height: 0; }.podium { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12rpx; padding: 8rpx 28rpx 24rpx; }.podium-card { position: relative; display: flex; align-items: center; flex-direction: column; padding: 22rpx 14rpx; border: 2rpx solid #dbe7f0; border-radius: 28rpx; background: #fff; min-width: 0; }.podium-number { font-size: 24rpx; font-weight: 800; color: #9fb6c9; align-self: flex-start; }.podium-avatar,.row-avatar { background: #edf5fa; color: #6a97b3; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 700; overflow: hidden; }.podium-avatar { width: 80rpx; height: 80rpx; margin: 8rpx 0 18rpx; }.podium-avatar image,.row-avatar image { width: 100%; height: 100%; }.podium-name { width: 100%; height: 72rpx; text-align: center; font-size: 23rpx; line-height: 1.5; overflow: hidden; }.podium-distance { font-size: 31rpx; font-weight: 800; margin-top: 12rpx; font-variant-numeric: tabular-nums; }.podium-distance text { font-size: 19rpx; font-weight: 400; }.podium-level { font-size: 19rpx; color: #95a9b9; margin-top: 10rpx; }.rank-list { margin: 0 28rpx; }.rank-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 14rpx; padding: 24rpx 18rpx; border-radius: 26rpx; background: #fff; border: 2rpx solid #e1eaf1; }.row-rank { width: 36rpx; text-align: center; font-size: 25rpx; color: #a0b4c4; font-weight: 800; }.row-avatar { width: 74rpx; height: 74rpx; flex-shrink: 0; }.row-info { flex: 1; min-width: 0; }.row-name,.row-detail { display: block; }.row-name { font-size: 27rpx; font-weight: 650; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.row-detail { margin-top: 8rpx; font-size: 20rpx; color: #96a9b7; }.row-distance { text-align: right; font-size: 30rpx; font-weight: 750; color: #4b8bae; }.row-unit { display: block; font-size: 19rpx; font-weight: 400; color: #9cafbd; margin-top: 5rpx; }.rank-empty { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 20rpx; padding: 100rpx 28rpx; }.empty-symbol { color: #88b2ca; font-size: 90rpx; }.empty-title { font-size: 29rpx; font-weight: 650; }.empty-note { color: #97abba; font-size: 23rpx; line-height: 1.6; }

.rank-title { font-size: 33rpx; line-height: 1.45; }
.rank-tabs button.pair-tab { font-size: 23rpx; line-height: 1.3; display: flex; align-items: center; justify-content: center; padding: 0 5rpx; }
.competition-banner { margin: 4rpx 28rpx 24rpx; padding: 22rpx; border-radius: 24rpx; display: flex; align-items: center; gap: 18rpx; background: linear-gradient(110deg,#ede8ff,#fceaf1); color: #7e63a0; }
.competition-symbol { font-size: 50rpx; }.competition-title,.competition-note { display: block; }.competition-title { font-size: 27rpx; font-weight: 750; }.competition-note { font-size: 21rpx; line-height: 1.5; margin-top: 7rpx; }
.podium { align-items: start; padding-top: 14rpx; gap: 10rpx; }
.podium-card { padding: 16rpx 10rpx 22rpx; min-height: 368rpx; box-sizing: border-box; }
.podium-card--0 { order: 2; border-color: #edd18b; background: linear-gradient(160deg,#fffaf0,#ffe9b4); box-shadow: 0 10rpx 30rpx #d9ad452e; color: #725426; }
.podium-card--1 { order: 1; margin-top: 32rpx; border-color: #cddcec; background: linear-gradient(160deg,#fff,#edf4ff); color: #5d789b; }
.podium-card--2 { order: 3; margin-top: 50rpx; border-color: #e9c9b9; background: linear-gradient(160deg,#fff8f1,#f9e5dc); color: #a07763; }
.podium-crown { font-size: 43rpx; line-height: 1.2; }.podium-card--0 .podium-crown { color: #dca537; font-size: 52rpx; }
.podium-medal { font-size: 30rpx; font-weight: 800; margin-top: 6rpx; }.podium-number { align-self: center; font-size: 19rpx; margin-top: 5rpx; color: inherit; opacity: .65; }
.podium-avatar { width: 66rpx; height: 66rpx; margin: 12rpx 0; border-radius: 50%; border: 4rpx solid #ffffffbb; }
.podium-name { font-size: 22rpx; height: 66rpx; }.podium-distance { font-size: 29rpx; margin-top: 8rpx; }.podium-level { font-size: 18rpx; line-height: 1.5; text-align: center; color: inherit; opacity: .8; min-height: 52rpx; }
.podium-gap { font-size: 18rpx; text-align: center; margin-top: 14rpx; line-height: 1.5; font-weight: 700; }
.my-rank { margin: 0 28rpx 24rpx; border: 2rpx solid #c1dcef; border-radius: 24rpx; padding: 22rpx; background: #e7f3fc; color: #4a81a6; font-size: 24rpx; display: flex; flex-direction: column; gap: 8rpx; }.my-rank-label { font-size: 21rpx; color: #86a9c1; }.my-rank-gap { font-size: 22rpx; }.rank-row--mine { border-color: #94c4e3; background: #f3faff; }.row-rank { font-size: 35rpx; color: #7299b3; }

@import "../../styles/tech-ui.wxss";
