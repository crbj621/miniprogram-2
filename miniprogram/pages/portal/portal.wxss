@import "../../styles/campus-ui.wxss";
.portal-page { min-height: 100vh; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
button { margin: 0; padding: 0; text-align: left; line-height: normal; background: transparent; color: inherit; }
.portal-page button.tech-control { margin-left: 0; margin-right: 0; }
.hero { padding: 16rpx 32rpx 16rpx; background: #fff; border-bottom: 2rpx solid #e1e8e1; }
.hero-top,.brand,.welcome-row { display: flex; align-items: center; justify-content: space-between; }
.brand { gap: 10rpx; }.brand-flower { color: #be7056; font-size: 36rpx; }.brand-name { font-size: 23rpx; font-weight: 650; color: #71665e; }
.portal-page .admin-entry { width: auto; flex-shrink: 0; min-height: 88rpx; display: flex; align-items: center; padding: 0 16rpx; color: #796a5d; font-size: 24rpx; }
.welcome-row { gap: 16rpx; margin-top: 8rpx; }.welcome-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.eyebrow { font-size: 24rpx; color: #796e64; }.hero-title { font-size: 39rpx; font-weight: 750; line-height: 1.4; margin-top: 10rpx; }.hero-subtitle { font-size: 23rpx; line-height: 1.5; color: #847568; margin-top: 14rpx; }
.user-avatar { flex-shrink: 0; width: 88rpx; height: 88rpx; border-radius: 50%; overflow: hidden; }.user-avatar image { width: 100%; height: 100%; }
.portal-content { padding: 28rpx; }.section-heading { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; margin: 6rpx 0 22rpx; }.section-title { font-size: 31rpx; font-weight: 700; }.section-note { font-size: 21rpx; color: #7e94a6; }
.service-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 20rpx; }
.portal-page .service-card { display: flex; flex-direction: column; width: 100%; min-width: 0; min-height: 316rpx; border-radius: 30rpx; padding: 24rpx; border: 2rpx solid #dbe7f1; box-shadow: 0 10rpx 28rpx #1831490b; color: #193449; position: relative; overflow: hidden; }
.service-card--run { background: #e9f5fc; }.service-card--food { background: #edf2ff; }.service-card--canteen { background: #eaf7f5; }.service-card--forum { background: #f2effb; }
.service-top { display: flex; align-items: flex-start; justify-content: space-between; width: 100%; }.service-tag { font-size: 19rpx; line-height: 1.5; color: #6d8ba2; padding: 8rpx 12rpx; background: #ffffffb3; border-radius: 16rpx; white-space: nowrap; }
.service-title { font-size: 34rpx; font-weight: 800; line-height: 1.4; margin-top: 18rpx; }.service-desc { font-size: 23rpx; color: #758da0; line-height: 1.6; margin-top: 8rpx; min-height: 74rpx; }
.service-footer { display: flex; align-items: center; justify-content: space-between; width: 100%; margin-top: auto; padding-top: 18rpx; font-size: 23rpx; font-weight: 600; }.service-arrow { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; border-radius: 50%; background: rgba(255,255,255,.7); font-size: 28rpx; }
.portal-page .profile-card { display: flex; align-items: center; width: 100%; gap: 20rpx; padding: 24rpx; border-radius: 28rpx; background: #fff; border: 2rpx solid #dee8f0; margin-top: 24rpx; }.profile-symbol { display: flex; align-items: center; justify-content: center; width: 74rpx; height: 74rpx; border-radius: 24rpx; background: #f4ede4; color: #8a7159; font-size: 27rpx; font-weight: 700; }.profile-info { flex: 1; min-width: 0; }.profile-title { display: block; font-size: 28rpx; font-weight: 650; }.profile-desc { display: block; margin-top: 7rpx; color: #7e94a6; font-size: 23rpx; }.profile-arrow { font-size: 34rpx; color: #a39182; }
.portal-page .logout-btn { width: 100%; min-height: 88rpx; text-align: center; padding: 28rpx; font-size: 23rpx; color: #8e7f71; }.module-status { padding: 32rpx; background: #fff; border-radius: 28rpx; font-size: 26rpx; line-height: 1.6; text-align: center; }.module-retry { min-height: 88rpx; text-align: center; color: #48785c; }

.page-refresh-scroll { height: 100vh; display: block; }

@import "../../styles/uiverse.wxss";

.service-card .uiverse-card-content { width: 100%; min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 12rpx; }
.service-top campus-sticker,.service-tag,.profile-symbol { flex-shrink: 0; }
.welcome-copy .eyebrow,.profile-desc { word-break: break-all; }

@import "../../styles/tech-ui.wxss";

.welcome-copy .eyebrow,.welcome-copy .hero-subtitle { color:inherit; }
.user-avatar.tech-control { width:88rpx; height:88rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; }
.user-avatar image { display:block; border-radius:50%; }

.welcome-row { align-items:flex-start; }
.welcome-copy { padding-top:12rpx; }
.welcome-copy .hero-title,.welcome-copy .hero-subtitle { word-break:break-all; }
.welcome-aside { width:220rpx; flex-shrink:0; display:flex; flex-direction:column; align-items:center; }
.welcome-identities { width:100%; display:flex; align-items:center; justify-content:center; gap:12rpx; }
.welcome-companion { width:120rpx; height:160rpx; flex-shrink:0; transition:transform .16s; }
.companion-pressed { transform:scale(.97); }
.portal-page .companion-entry { width:100%; min-height:88rpx; margin-top:8rpx; padding:0 12rpx; font-size:21rpx; display:flex; align-items:center; justify-content:center; }
.portal-page .hero { background:linear-gradient(145deg,#fff,var(--campus-theme-soft)); border-bottom-color:var(--campus-theme-line); }
.portal-page .tech-control { border-color:var(--campus-theme-line) !important; }
.portal-page .companion-entry,.portal-page .admin-entry,.portal-page .module-retry { color:var(--campus-theme-accent) !important; background:var(--campus-theme-button) !important; }
.portal-page .service-card--english { background:var(--campus-theme-button) !important; }
.english-symbol { width:110rpx; height:110rpx; display:flex; align-items:center; justify-content:center; border-radius:28rpx; background:#ffffffb3; color:var(--campus-theme-accent); font-size:42rpx; font-weight:750; }
@media (max-width:340px) { .welcome-identities { gap:8rpx; }.user-avatar.tech-control { width:44px; height:44px; }.welcome-companion { width:44px; height:150rpx; }.portal-page .admin-entry,.portal-page .companion-entry { min-height:44px; }.welcome-copy .hero-title { font-size:37rpx; }.section-heading { align-items:flex-start; flex-wrap:wrap; } }
@media (prefers-reduced-motion:reduce) { .welcome-companion { transition:none; }.companion-pressed { transform:none; } }

.server-status-card { position:relative; overflow:hidden; margin-top:24rpx; padding:24rpx; border:2rpx solid #dce8ee; border-radius:28rpx; background:linear-gradient(135deg,#edf7f6,#f8f4fd 58%,#f0f6ff); box-shadow:0 8rpx 24rpx #59758b0a; color:#3b596d; }
.server-card-star { position:absolute; pointer-events:none; color:#a4b9d3; font-size:30rpx; opacity:.55; }.server-card-star--left { top:8rpx; left:46%; }.server-card-star--right { bottom:15rpx; right:32%; font-size:22rpx; }
.server-status-heading,.server-status-title,.server-state,.server-status-footer { display:flex; align-items:center; }.server-status-heading { justify-content:space-between; gap:16rpx; }.server-status-title { gap:14rpx; min-width:0; }
.server-symbol { width:56rpx; height:56rpx; flex-shrink:0; display:flex; flex-direction:column; justify-content:center; gap:7rpx; padding:9rpx; box-sizing:border-box; border:2rpx solid #c7d9e4; border-radius:16rpx; background:#ffffffa6; box-shadow:0 4rpx 0 #c7d9e426; }.server-symbol-row { display:flex; align-items:center; gap:4rpx; height:12rpx; padding:0 4rpx; border-radius:5rpx; background:#dce9ee; }.server-symbol-row view { width:4rpx; height:4rpx; border-radius:50%; background:#91adba; }.server-symbol-row view:first-child { margin-right:auto; width:12rpx; border-radius:2rpx; }
.server-title,.server-subtitle { display:block; }.server-title { font-size:25rpx; font-weight:700; line-height:1.5; }.server-subtitle { margin-top:2rpx; font-size:15rpx; letter-spacing:2rpx; color:#91a3b6; }
.server-state { flex-shrink:0; gap:9rpx; padding:10rpx 16rpx; border:1rpx solid #dce4ef; border-radius:24rpx; background:#ffffffb3; color:#7f8fa6; font-size:21rpx; font-weight:650; }.server-state-dot { width:10rpx; height:10rpx; border-radius:50%; background:currentColor; }.server-status-card--online .server-state { color:#3d8a72; border-color:#c8e6db; }.server-status-card--error .server-state { color:#b37b68; border-color:#edd9cd; }.server-status-card--loading .server-state { color:#718ec2; }
.server-status-metrics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); margin:22rpx 0 12rpx; padding:18rpx 0; border-top:1rpx solid #ffffffcc; border-bottom:1rpx solid #ffffffcc; }.server-metric { min-width:0; text-align:center; }.server-metric + .server-metric { border-left:1rpx solid #dce5ef; }.server-metric-label,.server-metric-value { display:block; }.server-metric-label { font-size:18rpx; color:#8496ab; }.server-metric-value { margin-top:9rpx; font-size:23rpx; font-weight:650; line-height:1.4; white-space:nowrap; }
.server-status-footer { justify-content:space-between; gap:12rpx; }.server-status-note { flex:1; min-width:0; font-size:18rpx; line-height:1.6; color:#7d90a5; }.portal-page .server-check { width:auto; flex-shrink:0; min-height:88rpx; padding:0 16rpx; display:flex; align-items:center; justify-content:center; gap:8rpx; border-radius:20rpx; font-size:20rpx; color:#6689ae !important; background:linear-gradient(120deg,#ffffffdf,#eaf3ff) !important; }.server-check text { font-size:27rpx; }.portal-page .server-check[disabled] { opacity:.65; }
@media (max-width:340px) { .server-status-card { padding:20rpx; }.portal-page .server-check { min-height:44px; }.server-status-note { font-size:19rpx; }.server-metric-value { font-size:22rpx; } }

.server-network-heading { margin-top:16rpx; color:#8496ab; font-size:18rpx; }.server-network { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12rpx; margin-top:10rpx; }.server-network-item { min-width:0; display:flex; align-items:center; gap:9rpx; padding:12rpx 16rpx; border-radius:16rpx; background:#ffffff9c; color:#8594a8; font-size:20rpx; }.server-network-name { margin-right:auto; color:#526c84; font-weight:650; }.server-network-item--reachable { color:#3d8a72; }.server-network-item--unreachable { color:#b37b68; }.server-network-item--restricted { color:#a28a54; }.server-network-item .server-state-dot { flex-shrink:0; width:8rpx; height:8rpx; }
.server-uptime-note { display:block; text-align:center; color:#8196b0; font-size:18rpx; line-height:1.6; }.server-network-item { flex-direction:column; align-items:stretch; gap:8rpx; }.server-network-line { display:flex; align-items:center; gap:9rpx; }.server-network-time { color:#93a0b2; font-size:16rpx; line-height:1.5; }
.server-storage { margin-top:18rpx; padding:16rpx; border-radius:18rpx; background:#ffffff87; }.server-storage-heading,.server-storage-footer { display:flex; justify-content:space-between; gap:12rpx; font-size:18rpx; line-height:1.6; color:#7d90a5; }.server-storage-heading text:last-child { color:#617d94; font-weight:650; text-align:right; }.server-storage-bar { height:10rpx; margin:12rpx 0; overflow:hidden; border-radius:12rpx; background:#dce8ef; }.server-storage-fill { height:100%; border-radius:inherit; background:linear-gradient(90deg,#9fcdbf,#a4b9e2); }.server-storage-bar--unconfirmed { background:repeating-linear-gradient(135deg,#e1e9ef,#e1e9ef 8rpx,#f2f6f9 8rpx,#f2f6f9 16rpx); }.server-storage-footer { color:#8c9cb0; }
.server-sites-summary { display:flex; flex-wrap:wrap; justify-content:space-between; gap:10rpx; margin:16rpx 0 4rpx; color:#7d90a5; font-size:19rpx; }
.portal-page .server-details-toggle { position:relative; overflow:hidden; width:100%; min-height:144rpx; display:flex; align-items:center; justify-content:space-between; gap:10rpx; margin-top:14rpx; padding:8rpx 14rpx; border:1rpx solid #ffffffc9; border-radius:24rpx; color:#708eaa; background:linear-gradient(110deg,#fff9fdd9,#edf4ffb3); font-size:20rpx; line-height:1.6; text-align:left; }.server-details-toggle::after { border:0; }.server-welcome { position:relative; z-index:1; flex:1; min-width:0; }.server-welcome-title { display:block; max-width:360rpx; color:#8c81a6; font-size:23rpx; font-weight:600; line-height:1.6; }.server-toggle-label { display:inline-flex; align-items:center; gap:16rpx; margin-top:12rpx; padding:6rpx 14rpx; border:1rpx solid #ccdcf4; border-radius:22rpx; background:linear-gradient(100deg,#fcf9ff,#e8f2ff); box-shadow:0 3rpx 10rpx #acbdd91a; color:#768cad; font-size:19rpx; }.server-toggle-label text { font-size:27rpx; line-height:1; }.server-mascot { position:relative; z-index:1; flex-shrink:0; width:104rpx; height:134rpx; transform-origin:center bottom; animation:server-mascot-float 3.8s ease-in-out infinite; }.server-mascot-halo { position:absolute; right:10rpx; bottom:3rpx; width:124rpx; height:98rpx; border-radius:50%; background:radial-gradient(ellipse,#ddd5fda3,#f5e2fa52 60%,transparent 73%); }.server-mascot-cloud { position:absolute; left:-24rpx; bottom:-30rpx; width:220rpx; height:60rpx; border-radius:50%; box-shadow:100rpx 10rpx 0 #ffffff70; background:#ffffff8c; }.server-status-expanded { animation:server-details-appear .2s ease both; }.server-details { margin-top:18rpx; padding-top:14rpx; border-top:1rpx solid #dce5ef; }.server-status-metrics--details { margin:0 0 14rpx; border-top:0; }.server-status-metrics--details .server-metric-value { font-size:21rpx; }
@keyframes server-mascot-float { 0%,100% { transform:translateY(0) rotate(-1deg); } 50% { transform:translateY(-4rpx) rotate(1deg); } }
@keyframes server-details-appear { from { opacity:0; transform:translateY(-6rpx); } to { opacity:1; transform:translateY(0); } }
@media (prefers-reduced-motion:reduce) { .server-mascot,.server-status-expanded { animation:none; } }
.server-detail-row { display:flex; justify-content:space-between; gap:12rpx; margin:12rpx 0; color:#7d90a5; font-size:19rpx; line-height:1.5; }.server-detail-row text:last-child { text-align:right; }.server-detail-note { display:block; margin-top:14rpx; font-size:18rpx; line-height:1.7; color:#8b9cae; }
.friend-links-card { display:flex; align-items:center; justify-content:space-between; gap:14rpx; margin-top:20rpx; padding:20rpx 24rpx; border:2rpx solid #e4e7ef; border-radius:26rpx; background:#ffffffb3; }.friend-links-card > view { flex:1; min-width:0; }.friend-links-title,.friend-links-note { display:block; }.friend-links-title { color:#77839c; font-size:23rpx; font-weight:650; }.friend-links-note { margin-top:7rpx; color:#94a1b3; font-size:18rpx; line-height:1.6; }.portal-page .friend-link-button { flex-shrink:0; width:auto; min-height:88rpx; padding:0 14rpx; display:flex; align-items:center; justify-content:center; font-size:20rpx; border-radius:18rpx; color:#8c85b4 !important; background:linear-gradient(120deg,#faf6ff,#f0f5ff) !important; }
@media (max-width:340px) { .server-network-item { padding:12rpx; font-size:20rpx; }.server-details-toggle { min-height:44px !important; }.friend-links-card { padding:20rpx; }.portal-page .friend-link-button { min-height:44px; } }
