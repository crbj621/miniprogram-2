<mahiro-scroll id="page-refresh" class="page-refresh-scroll" bindrefresh="refreshPage">
<view class="portal-page">
  <view class="hero">
    <view class="hero-top"><view class="brand"><text class="brand-flower">✿</text><text class="brand-name">校园生活手册</text></view><button class="admin-entry tech-control" bindtap="goToAdminLogin" hover-class="campus-pressed tap-feedback tech-pressed">管理端 ›</button></view>
    <view class="welcome-row"><view class="welcome-copy" style="color:{{daily.color}}"><text class="eyebrow">你好，{{userInfo.nickName || '同学'}} ✦</text><text class="hero-title">{{daily.title}}</text><text class="hero-subtitle">{{daily.subtitle}}</text></view><button class="user-avatar tech-control" bindtap="goToProfile" aria-label="进入个人中心" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100"><image wx:if="{{userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image><campus-sticker wx:else kind="forum" /></button></view>
  </view>
  <view class="portal-content">
    <view class="section-heading"><text class="section-title">你的校园小站</text><text class="section-note">把日常安排得刚刚好</text></view>
    <view class="module-status" wx:if="{{modulesState === 'loading'}}"><tech-loader/>正在加载校园服务…</view>
    <view class="module-status" wx:elif="{{modulesState === 'error'}}"><text>校园服务暂时无法加载</text><button class="module-retry tech-control" bindtap="loadModules" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">重新加载</button></view>
    <view class="module-status" wx:elif="{{!hasOpenModules}}">暂无开放的校园服务</view>
    <view class="service-grid" wx:if="{{modulesState === 'ready'}}">
      <button wx:if="{{modules.running}}" class="uiverse-blob-card service-card service-card--run tech-control tech-card" bindtap="goToRun" hover-class="campus-pressed tap-feedback tech-pressed" aria-label="进入校园跑"><view class="uiverse-blob uiverse-blob--one" /><view class="uiverse-blob uiverse-blob--two" /><view class="uiverse-blob uiverse-blob--three" /><view class="uiverse-blob uiverse-blob--four" /><view class="uiverse-card-glaze" /><view class="uiverse-card-content"><view class="service-top"><campus-sticker kind="run" /><text class="service-tag">动一动</text></view><text class="service-title">校园跑</text><text class="service-desc">记录每一步，和朋友一起开跑</text><view class="service-footer"><text>开始运动</text><text class="service-arrow">↗</text></view></view></button>
      <button wx:if="{{modules.food}}" class="uiverse-blob-card service-card service-card--food tech-control tech-card" bindtap="goToFood" hover-class="campus-pressed tap-feedback tech-pressed" aria-label="进入校园点餐"><view class="uiverse-blob uiverse-blob--one" /><view class="uiverse-blob uiverse-blob--two" /><view class="uiverse-blob uiverse-blob--three" /><view class="uiverse-blob uiverse-blob--four" /><view class="uiverse-card-glaze" /><view class="uiverse-card-content"><view class="service-top"><campus-sticker kind="food" /><text class="service-tag">好好吃饭</text></view><text class="service-title">校园点餐</text><text class="service-desc">挑一份喜欢的，安排今天的饭</text><view class="service-footer"><text>去点餐</text><text class="service-arrow">↗</text></view></view></button>
      <button wx:if="{{modules.canteen}}" class="uiverse-blob-card service-card service-card--canteen tech-control tech-card" bindtap="goToCanteen" hover-class="campus-pressed tap-feedback tech-pressed" aria-label="进入食堂饭菜评价"><view class="uiverse-blob uiverse-blob--one" /><view class="uiverse-blob uiverse-blob--two" /><view class="uiverse-blob uiverse-blob--three" /><view class="uiverse-blob uiverse-blob--four" /><view class="uiverse-card-glaze" /><view class="uiverse-card-content"><view class="service-top"><campus-sticker kind="canteen" /><text class="service-tag">吃前看看</text></view><text class="service-title">食堂评分</text><text class="service-desc">看看真实评价，发现值得吃的菜</text><view class="service-footer"><text>找点好吃的</text><text class="service-arrow">↗</text></view></view></button>
      <button wx:if="{{modules.forum}}" class="uiverse-blob-card service-card service-card--forum tech-control tech-card" bindtap="goToForum" hover-class="campus-pressed tap-feedback tech-pressed" aria-label="进入校园动态"><view class="uiverse-blob uiverse-blob--one" /><view class="uiverse-blob uiverse-blob--two" /><view class="uiverse-blob uiverse-blob--three" /><view class="uiverse-blob uiverse-blob--four" /><view class="uiverse-card-glaze" /><view class="uiverse-card-content"><view class="service-top"><campus-sticker kind="forum" /><text class="service-tag">小日常</text></view><text class="service-title">校园动态</text><text class="service-desc">分享新鲜事，也遇见同频的朋友</text><view class="service-footer"><text>逛逛广场</text><text class="service-arrow">↗</text></view></view></button>
    </view>
    <button class="profile-card tech-control tech-card" bindtap="goToProfile" hover-class="campus-pressed tap-feedback tech-pressed"><view class="profile-symbol">我</view><view class="profile-info"><text class="profile-title">个人中心</text><text class="profile-desc">账号与已开放的服务</text></view><text class="profile-arrow">›</text></button>
    <view class="logout-section" wx:if="{{isLoggedIn}}"><button class="logout-btn tech-control" bindtap="logout" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">退出当前账号</button></view>
  </view>
</view>

</mahiro-scroll>
