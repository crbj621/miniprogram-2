<share-intro wx:if="{{__sharePublic}}" title="{{__shareTitle}}" path="{{__sharePath}}" /><block wx:else>
<mahiro-scroll id="page-refresh" class="page-refresh-scroll" bindrefresh="refreshPage">
<view class="portal-page" style="{{theme.style}}">
  <view class="hero">
    <view class="hero-top"><view class="brand"><text class="brand-flower">✿</text><text class="brand-name">校园生活手册</text></view><button class="admin-entry tech-control" bindtap="goToAdminLogin" hover-class="campus-pressed tap-feedback tech-pressed">管理端 ›</button></view>
    <view class="welcome-row">
      <view class="welcome-copy" style="color:{{daily.color}}"><text class="eyebrow">{{pageCopy.greeting}}，{{userInfo.nickName || '同学'}} ✦</text><text class="hero-title">{{pageCopy.title}}</text><text class="hero-subtitle">{{pageCopy.subtitle}}</text></view>
      <view class="welcome-aside">
        <view class="welcome-identities">
        <view class="welcome-companion" aria-label="点击与伙伴互动" hover-class="companion-pressed"><campus-companion id="portal-companion" image="{{companion.image}}" outfit="{{companion.outfit}}" accessory="{{companion.accessory}}" shoes="{{companion.shoes}}" accessory-style="{{companion.accessoryStyle}}" shoes-style="{{companion.shoesStyle}}" character="{{companion.character}}" bindimageerror="onCompanionImageError" /></view>
        <button class="user-avatar tech-control" bindtap="goToProfile" aria-label="进入个人中心" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100"><image wx:if="{{userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image><campus-sticker wx:else kind="forum" /></button>
        </view>
        <button wx:if="{{companionState === 'error'}}" class="companion-entry tech-control" bindtap="loadCompanion" hover-class="tech-pressed">伙伴加载重试</button>
        <button wx:else class="companion-entry tech-control" bindtap="goToWardrobe" hover-class="tech-pressed">{{companionState === 'guest' ? '登录选伙伴' : '伙伴换装'}} ✦</button>
      </view>
    </view>
  </view>
  <view class="portal-content">
    <view class="section-heading"><text class="section-title">{{sectionCopy.title}}</text><text class="section-note">{{sectionCopy.subtitle}}</text></view>
    <view class="module-status" wx:if="{{modulesState === 'loading'}}"><tech-loader/>正在加载校园服务…</view>
    <view class="module-status" wx:elif="{{modulesState === 'error'}}"><text>校园服务暂时无法加载</text><button class="module-retry tech-control" bindtap="loadModules" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">重新加载</button></view>
    <view class="module-status" wx:elif="{{!hasOpenModules}}">暂无开放的校园服务</view>
    <view class="service-grid" wx:if="{{modulesState === 'ready'}}">
      <button wx:if="{{modules.running}}" class="uiverse-blob-card service-card service-card--run tech-control tech-card" bindtap="goToRun" hover-class="campus-pressed tap-feedback tech-pressed" aria-label="进入校园跑"><view class="uiverse-blob uiverse-blob--one" /><view class="uiverse-blob uiverse-blob--two" /><view class="uiverse-blob uiverse-blob--three" /><view class="uiverse-blob uiverse-blob--four" /><view class="uiverse-card-glaze" /><view class="uiverse-card-content"><view class="service-top"><campus-sticker kind="run" /><text class="service-tag">动一动</text></view><text class="service-title">校园跑</text><text class="service-desc">{{moduleCopy.running.subtitle}}</text><view class="service-footer"><text>开始运动</text><text class="service-arrow">↗</text></view></view></button>

      <button wx:if="{{modules.canteen}}" class="uiverse-blob-card service-card service-card--canteen tech-control tech-card" bindtap="goToCanteen" hover-class="campus-pressed tap-feedback tech-pressed" aria-label="进入食堂饭菜评价"><view class="uiverse-blob uiverse-blob--one" /><view class="uiverse-blob uiverse-blob--two" /><view class="uiverse-blob uiverse-blob--three" /><view class="uiverse-blob uiverse-blob--four" /><view class="uiverse-card-glaze" /><view class="uiverse-card-content"><view class="service-top"><campus-sticker kind="canteen" /><text class="service-tag">吃前看看</text></view><text class="service-title">食堂评分</text><text class="service-desc">{{moduleCopy.canteen.subtitle}}</text><view class="service-footer"><text>找点好吃的</text><text class="service-arrow">↗</text></view></view></button>
      <button wx:if="{{modules.forum}}" class="uiverse-blob-card service-card service-card--forum tech-control tech-card" bindtap="goToForum" hover-class="campus-pressed tap-feedback tech-pressed" aria-label="进入校园动态"><view class="uiverse-blob uiverse-blob--one" /><view class="uiverse-blob uiverse-blob--two" /><view class="uiverse-blob uiverse-blob--three" /><view class="uiverse-blob uiverse-blob--four" /><view class="uiverse-card-glaze" /><view class="uiverse-card-content"><view class="service-top"><campus-sticker kind="forum" /><text class="service-tag">小日常</text></view><text class="service-title">校园动态</text><text class="service-desc">{{moduleCopy.forum.subtitle}}</text><view class="service-footer"><text>逛逛广场</text><text class="service-arrow">↗</text></view></view></button>
      <button wx:if="{{modules.english}}" class="uiverse-blob-card service-card service-card--english tech-control tech-card" bindtap="goToEnglish" hover-class="campus-pressed tap-feedback tech-pressed" aria-label="进入四六级英语学习"><view class="uiverse-blob uiverse-blob--one" /><view class="uiverse-blob uiverse-blob--two" /><view class="uiverse-blob uiverse-blob--three" /><view class="uiverse-blob uiverse-blob--four" /><view class="uiverse-card-glaze" /><view class="uiverse-card-content"><view class="service-top"><text class="english-symbol">Aa</text><text class="service-tag">每天一点</text></view><text class="service-title">四六级英语</text><text class="service-desc">{{moduleCopy.english.subtitle}}</text><view class="service-footer"><text>开始学习</text><text class="service-arrow">↗</text></view></view></button>
      <button wx:if="{{modules.gifts}}" class="uiverse-blob-card service-card service-card--english tech-control tech-card" bindtap="goToGifts" hover-class="campus-pressed tap-feedback tech-pressed"><view class="uiverse-blob uiverse-blob--one" /><view class="uiverse-card-glaze" /><view class="uiverse-card-content"><view class="service-top"><text class="english-symbol">💌</text><text class="service-tag">兑换心意</text></view><text class="service-title">祝福小站</text><text class="service-desc">{{moduleCopy.gifts.subtitle}}</text><view class="service-footer"><text>制作礼物</text><text class="service-arrow">↗</text></view></view></button>
    </view>
    <button class="profile-card tech-control tech-card" bindtap="goToProfile" hover-class="campus-pressed tap-feedback tech-pressed"><view class="profile-symbol">我</view><view class="profile-info"><text class="profile-title">个人中心</text><text class="profile-desc">账号与已开放的服务</text></view><text class="profile-arrow">›</text></button>
    <view class="logout-section" wx:if="{{isLoggedIn}}"><button class="logout-btn tech-control" bindtap="logout" hover-class="tap-feedback tech-pressed" hover-start-time="0" hover-stay-time="100">退出当前账号</button></view>
    <view class="server-status-card server-status-card--{{serverHealth.state}}">
      <view class="server-card-star server-card-star--left" aria-hidden="true">✧</view><view class="server-card-star server-card-star--right" aria-hidden="true">✦</view>
      <view class="server-status-heading">
        <view class="server-status-title"><view class="server-symbol" aria-hidden="true"><view class="server-symbol-row"><view /><view /><view /></view><view class="server-symbol-row"><view /><view /><view /></view></view><view><text class="server-title">校园守护站</text><text class="server-subtitle">服务器状态 · CAMPUS CLOUD</text></view></view>
        <view class="server-state"><view class="server-state-dot" /><text>{{serverHealth.label}}</text></view>
      </view>
      <button class="server-details-toggle tech-control" bindtap="toggleServerDetails" aria-expanded="{{serverDetailsExpanded}}" aria-label="{{serverDetailsExpanded ? '收起服务器状态' : '展开服务器状态'}}" hover-class="tap-feedback tech-pressed">
        <view class="server-mascot-cloud" aria-hidden="true" /><view class="server-mascot-halo" aria-hidden="true" />
        <view class="server-welcome"><text class="server-welcome-title">今天也陪你，把日常过成小欢喜 ✧</text><view class="server-toggle-label">{{serverDetailsExpanded ? '收起小站状态' : '点开看看小站状态'}}<text>{{serverDetailsExpanded ? '⌃' : '⌄'}}</text></view></view>
        <image class="server-mascot" src="{{serverMascotImage}}" mode="aspectFit" aria-hidden="true" />
      </button>
      <view wx:if="{{serverDetailsExpanded}}" class="server-status-expanded">
      <view class="server-status-metrics">
        <view class="server-metric"><text class="server-metric-label">CPU 占用</text><text class="server-metric-value">{{serverHealth.cpu}}</text></view>
        <view class="server-metric"><text class="server-metric-label">整机内存</text><text class="server-metric-value">{{serverHealth.memory}}</text></view>
        <view class="server-metric"><text class="server-metric-label">开机时长</text><text class="server-metric-value">{{serverHealth.uptime}}</text></view>
      </view>
      <text class="server-uptime-note">{{serverHealth.uptimeDetail ? '小站已连续守护 ' + serverHealth.uptimeDetail : '连续守护时间暂未确认'}} ✧</text>
      <view class="server-storage"><view class="server-storage-heading"><text>硬盘 · 已用 / 总容量</text><text>{{serverHealth.diskUsed}} / {{serverHealth.diskTotal}}</text></view><view class="server-storage-bar {{serverHealth.diskProgress === null ? 'server-storage-bar--unconfirmed' : ''}}"><view wx:if="{{serverHealth.diskProgress !== null}}" class="server-storage-fill" style="width:{{serverHealth.diskProgress}}%" /></view><view class="server-storage-footer"><text>硬盘使用 {{serverHealth.diskUsage}}</text><text>网站占用 {{serverHealth.websiteStorage}}</text></view></view>
      <view class="server-network-heading">服务器外网连接 · 每小时检测</view>
      <view class="server-network"><view class="server-network-item server-network-item--{{serverHealth.google.state}}"><view class="server-network-line"><view class="server-state-dot" /><text class="server-network-name">Google</text><text>{{serverHealth.google.label}}</text></view><text class="server-network-time">上次 {{serverHealth.google.checkedAt}}</text></view><view class="server-network-item server-network-item--{{serverHealth.youtube.state}}"><view class="server-network-line"><view class="server-state-dot" /><text class="server-network-name">YouTube</text><text>{{serverHealth.youtube.label}}</text></view><text class="server-network-time">上次 {{serverHealth.youtube.checkedAt}}</text></view></view>
      <view class="server-sites-summary"><text>有效祝福 {{serverHealth.giftActiveCount}}</text><text>公示 {{serverHealth.giftPublicCount}}</text></view>
      <view class="server-status-footer"><text class="server-status-note">{{serverHealth.note}}</text><button class="server-check tech-control" bindtap="loadServerHealth" disabled="{{serverHealth.updating}}" hover-class="tap-feedback tech-pressed" aria-label="重新检测服务器状态">{{serverHealth.updating ? '更新中…' : '重新检测'}}<text wx:if="{{!serverHealth.updating}}">↻</text></button></view>
      <view class="server-details">
        <view class="server-status-metrics server-status-metrics--details"><view class="server-metric"><text class="server-metric-label">数据库</text><text class="server-metric-value">{{serverHealth.database}}</text></view><view class="server-metric"><text class="server-metric-label">请求耗时</text><text class="server-metric-value">{{serverHealth.elapsed}}</text></view><view class="server-metric"><text class="server-metric-label">检测时间</text><text class="server-metric-value">{{serverHealth.checkedAt}}</text></view></view>
        <view class="server-detail-row"><text>整机内存使用</text><text>{{serverHealth.memoryDetail}}</text></view><view class="server-detail-row"><text>主机采样时间</text><text>{{serverHealth.sampledAt}}</text></view>
        <view class="server-detail-row"><text>硬盘可用空间</text><text>{{serverHealth.diskAvailable}}</text></view><view class="server-detail-row"><text>网站占用统计时间</text><text>{{serverHealth.websiteStorageCheckedAt}}</text></view><text class="server-detail-note">网站占用范围：网站文件、图片和业务数据库，不含运维备份。约每5分钟统计一次。</text>
        <view wx:if="{{serverHealth.bootedAt !== '未确认'}}" class="server-detail-row"><text>主机开机时间</text><text>{{serverHealth.bootedAt}}</text></view>
        <view class="server-detail-row"><text>Google · {{serverHealth.google.route}}</text><text>{{serverHealth.google.checkedAt}}</text></view><view class="server-detail-row"><text>YouTube · {{serverHealth.youtube.route}}</text><text>{{serverHealth.youtube.checkedAt}}</text></view>
        <text class="server-detail-note">外网检测来自服务器，不代表手机网络。</text>
      </view>
      </view>
    </view>
    <view class="friend-links-card"><view><text class="friend-links-title">友情链接 ✧</text><text class="friend-links-note">个人主页 · 复制后在浏览器打开</text></view><button class="friend-link-button tech-control" bindtap="copyPersonalHomepage" hover-class="tap-feedback tech-pressed">复制主页链接 ↗</button></view>
  </view>
</view>

</mahiro-scroll>

</block>
