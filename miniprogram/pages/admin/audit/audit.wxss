@import "../../../styles/admin-ui.wxss";
.container {
  min-height: 100vh;
  background-color: #f2f6fa;
  display: flex;
  flex-direction: column;
}

.filter-bar {
  display: flex;
  padding: 20rpx;
  background-color: #fff;
  gap: 20rpx;
  align-items: center;
}

.filter-bar picker {
  flex-shrink: 0;
}

.picker-btn {
  box-sizing: border-box;
  height: 88rpx;
  display: flex;
  align-items: center;
  background-color: #f0f0f0;
  padding: 16rpx 24rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.picker-btn .arrow {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: #7e94a6;
}

.search-input {
  flex: 1;
  min-width: 0;
}

.search-input input {
  background-color: #f0f0f0;
  padding: 16rpx 24rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.list-container {
  flex: 1;
}

.list {
  padding: 20rpx;
}

.item {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.shop-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.status-tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.status-tag.pending {
  background-color: #fff7e6;
  color: #fa8c16;
}

.status-tag.approved {
  background-color: #f6ffed;
  color: #52c41a;
}

.status-tag.rejected {
  background-color: #fff2f0;
  color: #ff4d4f;
}

.item-info {
  background-color: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx;
}

.info-row {
  display: flex;
  font-size: 26rpx;
  margin-bottom: 10rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-row .label {
  color: #7e94a6;
  width: 160rpx;
}

.images-row {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.image-item {
  flex: 1;
  text-align: center;
}

.image-item image {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
}

.image-item text {
  display: block;
  font-size: 24rpx;
  color: #7e94a6;
  margin-top: 10rpx;
}

.reject-reason {
  margin-top: 20rpx;
  padding: 16rpx;
  background-color: #fff2f0;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.reject-reason .label {
  color: #ff4d4f;
}

.action-row {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.btn.approve {
  background-color: #52c41a;
  color: #fff;
}

.btn.reject {
  background-color: #ff4d4f;
  color: #fff;
}

.empty, .loading {
  text-align: center;
  padding: 100rpx 0;
  color: #7e94a6;
  font-size: 28rpx;
}

@import "../../../styles/tech-ui.wxss";
