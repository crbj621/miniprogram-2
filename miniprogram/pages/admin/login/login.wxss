@import "../../../styles/campus-ui.wxss";
.container { min-height: 100vh; box-sizing: border-box; padding: 60rpx 28rpx 40rpx; display: flex; flex-direction: column; align-items: stretch; justify-content: flex-start; background: #f2f6fa; }
.login-heading { display: flex; flex-direction: column; align-items: center; gap: 16rpx; margin-bottom: 38rpx; }.welcome { font-size: 40rpx; font-weight: 800; }.welcome-note { font-size: 24rpx; color: #7e94a6; }
.login-card { padding: 32rpx; border: 2rpx solid #dee8f0; border-radius: 32rpx; background: #fff; }.title { display: block; font-size: 34rpx; font-weight: 700; }.subtitle { display: block; margin-top: 10rpx; font-size: 24rpx; color: #7e94a6; }.form { margin-top: 30rpx; }.field { margin-bottom: 24rpx; }.label { display: block; font-size: 26rpx; margin-bottom: 12rpx; }.input { width: 100%; height: 88rpx; padding: 0 22rpx; background: #f2f6fa; border: 2rpx solid #dee8f0; border-radius: 22rpx; font-size: 28rpx; box-sizing: border-box; }
.error { color: #a74d5d; background: #fff0f2; padding: 18rpx; font-size: 25rpx; line-height: 1.6; margin-bottom: 22rpx; border-radius: 16rpx; }.login-btn.tech-control { width: 100%; height: 96rpx; margin: 12rpx 0 0; line-height: 96rpx; background: #338ac7; border-radius: 26rpx; font-size: 30rpx; color: #fff; font-weight: 700; }.login-btn::after { border: 0; }.login-btn[disabled] { opacity: .6; }.footer { text-align: center; margin-top: 28rpx; font-size: 23rpx; color: #7e94a6; }

