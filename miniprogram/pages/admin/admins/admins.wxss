@import "../../../styles/admin-ui.wxss";
.container {
  min-height: 100vh;
  background: #f2f6fa;
  padding: 20rpx;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 6rpx 18rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 800;
  color: #222;
}

.btn {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 1;
}

.btn.primary {
  background: #338ac7;
  color: #fff;
}

.btn.ghost {
  background: #f1f3f7;
  color: #333;
}

.item {
  background: #fff;
  border-radius: 24rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 10rpx 30rpx rgba(17, 24, 39, 0.06);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.name {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.tag.super {
  background: #eef2ff;
  color: #4f46e5;
}

.tag.normal {
  background: #ecfdf5;
  color: #10b981;
}

.meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666;
}

.ops {
  margin-top: 14rpx;
  display: flex;
  gap: 18rpx;
}

.op {
  color: #338ac7;
  font-size: 24rpx;
}

.op.danger {
  color: #ff4d4f;
}

.empty, .loading {
  text-align: center;
  color: #7e94a6;
  padding: 80rpx 0;
}

/* modal */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
}

.modal-wrap {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  box-sizing: border-box;
}

.modal {
  width: 100%;
  max-width: 680rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #222;
}

.modal-close {
  font-size: 34rpx;
  color: #7e94a6;
  padding: 4rpx 10rpx;
}

.modal-body {
  flex: 1;
  min-height: 0;
  height: 55vh;
  max-height: 55vh;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
}

.field {
  margin-bottom: 18rpx;
}

.label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.input {
  width: 100%;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx 16rpx;
  font-size: 28rpx;
}

.modal-footer {
  flex-shrink: 0;
  display: flex;
  gap: 18rpx;
  padding: 18rpx 24rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.modal-footer .btn {
  width: auto;
  flex: 1;
  min-width: 0;
  margin: 0;
  line-height: 1.4;
}


@import "../../../styles/tech-ui.wxss";
