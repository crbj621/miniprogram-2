@import "../../../styles/campus-ui.wxss";
button { padding: 0; line-height: normal; } button::after { border: 0; }
.container { min-height: 100vh; box-sizing: border-box; padding: 0 0 calc(36rpx + env(safe-area-inset-bottom)); display: block; background: #f2f6fa; }
.header { padding: 28rpx; background: #edf2fa; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }.admin-info { flex: 1; min-width: 0; display: flex; align-items: center; gap: 20rpx; }.info { min-width: 0; }.name { font-size: 34rpx; font-weight: 800; overflow-wrap: break-word; }.role { font-size: 24rpx; color: #647ba7; margin-top: 8rpx; }.header .logout-btn { width: auto; margin: 0; flex-shrink: 0; min-height: 88rpx; padding: 0 22rpx; display: flex; align-items: center; border-radius: 24rpx; background: #fff; color: #647ba7; font-size: 26rpx; }
.quick-section { margin: 26rpx 28rpx; }.section-title { font-size: 26rpx; color: #7e94a6; font-weight: 700; margin-bottom: 16rpx; }.quick-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16rpx; }.quick-grid .quick-btn { width: 100%; min-width: 0; margin: 0; min-height: 128rpx; padding: 22rpx; border-radius: 26rpx; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 10rpx; font-size: 30rpx; font-weight: 700; color: #193449; }.quick-btn:last-child { grid-column: 1 / -1; }.quick-note { font-size: 23rpx; font-weight: 400; }.quick-green { background: #e8f4fc; color: #3786b8; }.quick-yellow { background: #e7f2fc; color: #437caa; }.quick-pink { background: #eaf0fc; color: #647ba7; }
.stats-title { margin: 0 28rpx 16rpx; }.stats-row { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16rpx; margin: 0 28rpx 28rpx; }.stat-card { background: #fff; padding: 24rpx; border: 2rpx solid #dee8f0; border-radius: 24rpx; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }.stat-card:last-child { grid-column: 1 / -1; }.stat-num { font-size: 36rpx; color: #3786b8; font-weight: 800; }.stat-label { font-size: 23rpx; color: #7e94a6; }
.menu-section { margin: 0 28rpx 28rpx; }.menu-list { background: #fff; border: 2rpx solid #dee8f0; border-radius: 28rpx; overflow: hidden; }.menu-item { display: flex; align-items: center; padding: 26rpx 22rpx; gap: 16rpx; min-height: 96rpx; box-sizing: border-box; border-bottom: 2rpx solid #f4eee7; }.menu-item:last-child { border: 0; }.menu-icon { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: #f2f6fa; border-radius: 20rpx; font-size: 34rpx; }.menu-content { flex: 1; min-width: 0; }.menu-name { font-size: 29rpx; font-weight: 700; }.menu-desc { font-size: 23rpx; color: #7e94a6; margin-top: 8rpx; line-height: 1.6; }.menu-badge { min-width: 32rpx; padding: 5rpx 10rpx; background: #eaf0fc; color: #647ba7; border-radius: 16rpx; font-size: 22rpx; text-align: center; }.menu-arrow { font-size: 40rpx; color: #b9a89a; }
.modal-mask { position: fixed; inset: 0; background: rgba(67,58,52,.45); z-index: 999; }.modal-wrap { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; padding: 28rpx; box-sizing: border-box; z-index: 1000; }.modal { width: 100%; max-width: 680rpx; max-height: 85vh; display: flex; flex-direction: column; border-radius: 32rpx; background: #fff; overflow: hidden; }.modal-header { padding: 24rpx 26rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 2rpx solid #dee8f0; flex-shrink: 0; }.modal-title { font-size: 32rpx; font-weight: 700; }.modal-close { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; color: #7e94a6; }.settings-scroll { flex: 1; min-height: 0; height: 55vh; }.modal-body { padding: 24rpx 26rpx; }.field { margin-bottom: 24rpx; }.label { font-size: 26rpx; margin-bottom: 12rpx; font-weight: 700; }.input { width: 100%; height: 88rpx; padding: 0 20rpx; border-radius: 20rpx; background: #f2f6fa; border: 2rpx solid #dee8f0; font-size: 28rpx; box-sizing: border-box; }.field-note { color: #7e94a6; font-size: 24rpx; line-height: 1.6; }.preset-grid { margin: 20rpx 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }.preset-grid button { margin: 0; min-height: 88rpx; padding: 16rpx 12rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; background: #e8f4fc; color: #3786b8; font-size: 24rpx; }.preset-grid button:first-child { grid-column: 1 / -1; }.module-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; min-height: 100rpx; border-bottom: 2rpx dashed #dee8f0; }.module-row:last-child { border: 0; }.module-name { flex: 1; min-width: 0; font-size: 26rpx; }.modal-footer { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; padding: 22rpx 26rpx; flex-shrink: 0; border-top: 2rpx solid #dee8f0; }.modal-footer .btn { width: 100%; min-width: 0; margin: 0; height: 88rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; border-radius: 24rpx; }.btn.ghost { background: #edf3f8; color: #70879b; }.btn.primary { background: #338ac7; color: #fff; }.btn[disabled] { opacity: .5; }.modal-loading { padding: 40rpx 0; text-align: center; color: #7e94a6; font-size: 26rpx; }
.quick-btn:last-child,.stat-card:last-child { grid-column: auto; }.quick-btn { border: 2rpx solid #dbe7f1; box-shadow: 0 10rpx 24rpx #1934490b; }.container { background: #f2f6fa; }.header { background: #fff; border-bottom: 2rpx solid #dde7ef; }.overview-heading { display: flex; justify-content: space-between; align-items: center; padding: 26rpx 28rpx 20rpx; font-size: 28rpx; font-weight: 700; }.overview-heading button.tech-control { width: auto; margin: 0; min-height: 72rpx; padding: 0 22rpx; border-radius: 20rpx; background: #eaf3fb; color: #6c8ca2; font-size: 23rpx; }.menu-section .group-heading { width: 100%; min-height: 96rpx; padding: 20rpx 24rpx; margin: 0 0 14rpx; display: flex; align-items: center; justify-content: space-between; gap: 14rpx; background: #fff; border: 2rpx solid #dde7ef; border-radius: 24rpx; font-size: 27rpx; color: #5e7b96; }.group-heading text:last-child { font-size: 22rpx; color: #879ead; }.role { font-size: 22rpx; }.menu-icon { color: #6c8ca2; }

.page-refresh-scroll { height: 100vh; display: block; }

@import "../../../styles/uiverse.wxss";

.quick-btn .uiverse-card-content { display: flex; flex-direction: column; gap: 10rpx; }
.quick-btn:last-child { grid-column: auto; }

.pending-pill { font-size: 20rpx; background: #fff1e0; color: #b88145; padding: 6rpx 10rpx; border-radius: 12rpx; }

