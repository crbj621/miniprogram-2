@import "../../../styles/admin-ui.wxss";
.container {
  min-height: 100vh;
  background-color: #f2f6fa;
  display: flex;
  flex-direction: column;
}

.search-box {
  display: flex;
  align-items: center;
  background-color: #f2f6fa;
  border-radius: 30rpx;
  padding: 0 16rpx;
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
}

.search-bar {
  display: flex;
  padding: 20rpx;
  background-color: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  align-items: center;
}

.add-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 88rpx;
  margin-left: 20rpx;
  background: #338ac7;
  color: #fff;
  padding: 0 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: bold;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-box input {
  flex: 1;
  font-size: 28rpx;
}

.list-container {
  flex: 1;
}

.list {
  padding: 20rpx;
}

.item {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.item-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.shop-logo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
  margin-right: 20rpx;
}

.shop-info {
  flex: 1;
  min-width: 0;
}

.shop-name {
  overflow-wrap: break-word;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.shop-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rating {
  font-size: 24rpx;
  color: #faad14;
}

.sales {
  font-size: 24rpx;
  color: #7e94a6;
}

.status-tag {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.status-tag.open {
  background-color: #e6f7ff;
  color: #1890ff;
}

.status-tag.closed {
  background-color: #fff1f0;
  color: #ff4d4f;
}

.status-tag.pending {
  background-color: #fff7e6;
  color: #fa8c16;
}

.item-body {
  background-color: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.info-label {
  color: #7e94a6;
  width: 140rpx;
}

.action-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.action-row .btn {
  min-width: 0;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.btn.enable {
  background-color: #e6f7ff;
  color: #1890ff;
}

.btn.disable {
  background-color: #fff1f0;
  color: #ff4d4f;
}

.btn.edit {
  background-color: #f6ffed;
  color: #52c41a;
}

.btn.account {
  background-color: #e6f7ff;
  color: #1890ff;
}

.btn.reset {
  background-color: #fff7e6;
  color: #fa8c16;
}

.btn.delete {
  background-color: #fff1f0;
  color: #ff4d4f;
}

.btn.logs {
  background-color: #f0f0f0;
  color: #666;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #7e94a6;
  font-size: 28rpx;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  color: #7e94a6;
  font-size: 26rpx;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #338ac7;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 100;
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-mask {
  position: absolute;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  width: 90%;
  max-width: 600rpx;
  background-color: #fff;
  border-radius: 24rpx;
  z-index: 101;
  overflow: hidden;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: #338ac7;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.modal-close {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1;
}

.modal-body {
  flex: 1;
  min-height: 0;
  height: 55vh;
  max-height: 55vh;
  box-sizing: border-box;
  padding: 30rpx;
}

.shop-name-tip {
  font-size: 28rpx;
  color: #666;
  background-color: #f0f0f0;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item.half {
  flex: 1;
  min-width: 0;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  background-color: #f2f6fa;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-footer {
  flex-shrink: 0;
  display: flex;
  padding: 20rpx 30rpx 30rpx;
  gap: 20rpx;
}

.modal-footer .btn {
  flex: 1;
  min-width: 0;
  margin: 0;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.modal-footer .cancel {
  background-color: #f2f6fa;
  color: #666;
}

.modal-footer .confirm {
  background: #338ac7;
  color: #fff;
}

@import "../../../styles/tech-ui.wxss";
