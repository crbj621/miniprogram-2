@import "../../../styles/admin-ui.wxss";
.container {
  min-height: 100vh;
  background: #f2f6fa;
  padding: 20rpx;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 6rpx 18rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 800;
  color: #222;
}

.btn {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 1;
}

.btn.primary {
  background: #338ac7;
  color: #fff;
}

.btn.ghost {
  background: #f1f3f7;
  color: #333;
}

.filters {
  display: flex;
  gap: 14rpx;
  padding: 0 6rpx 18rpx;
}

.chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #666;
  font-size: 24rpx;
}

.chip.active {
  background: #338ac7;
  color: #fff;
}

.item {
  background: #fff;
  border-radius: 24rpx;
  padding: 22rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 10rpx 30rpx rgba(17, 24, 39, 0.06);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
  flex: 1;
  padding-right: 12rpx;
}

.badge {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.badge.published {
  background: #ecfdf5;
  color: #10b981;
}

.badge.draft {
  background: #fff7ed;
  color: #fb923c;
}

.content {
  margin-top: 12rpx;
  color: #555;
  font-size: 26rpx;
  line-height: 1.5;
  white-space: pre-wrap;
}

.bottom {
  margin-top: 16rpx;
}

.meta {
  font-size: 22rpx;
  color: #7e94a6;
}

.ops {
  display: flex;
  gap: 18rpx;
}

.op {
  color: #338ac7;
  font-size: 24rpx;
}

.op.danger {
  color: #ff4d4f;
}

.empty, .loading {
  text-align: center;
  color: #7e94a6;
  padding: 80rpx 0;
}

/* modal */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
}

.modal-wrap {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
}

.modal {
  width: 100%;
  max-width: 680rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #222;
}

.modal-close {
  font-size: 34rpx;
  color: #7e94a6;
  padding: 4rpx 10rpx;
}

.modal-body {
  padding: 22rpx 24rpx;
}

.field {
  margin-bottom: 18rpx;
}

.label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.input, .textarea, .picker {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx 16rpx;
  font-size: 28rpx;
}

.textarea {
  min-height: 180rpx;
}

.row-inline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-footer {
  display: flex;
  gap: 18rpx;
  padding: 18rpx 24rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}


@import "../../../styles/tech-ui.wxss";
