.container {
  display: block;
  height: auto;
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(180deg, #fff5f5 0%, #fff0f8 45%, #f5f0ff 100%);
  padding: 20rpx;
  box-sizing: border-box;
}

.search-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  padding: 20rpx 20rpx 16rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
  z-index: 10;
  background: rgba(255, 245, 245, 0.9);
}

.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  padding: 0 14rpx 0 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 12rpx 28rpx rgba(255, 154, 158, 0.12);
}

.search-icon {
  font-size: 28rpx;
  opacity: 0.7;
}

.search-input {
  flex: 1;
  height: 86rpx;
  background: transparent;
  font-size: 28rpx;
}

.search-clear {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(0, 0, 0, 0.45);
  font-size: 30rpx;
  line-height: 1;
}

.search-btn {
  height: 64rpx;
  padding: 0 24rpx;
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.content {
  padding-top: calc(160rpx + env(safe-area-inset-top));
}

.section-title {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

.user-list {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 14rpx 34rpx rgba(0, 0, 0, 0.06);
}

.user-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.user-item:last-child {
  border-bottom: none;
}

.user-avatar {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #e0e0e0;
}

.user-info {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

.user-name {
  font-size: 30rpx;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 24rpx;
  color: #999999;
}

.user-item .add-btn {
  margin-left: 0;
  margin-right: 0;
  padding: 0;
  flex-shrink: 0;
  width: 120rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
  color: #ffffff;
  border: none;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.added-tag {
  flex-shrink: 0;
  height: 60rpx;
  padding: 0 22rpx;
  border-radius: 30rpx;
  background: rgba(0, 0, 0, 0.05);
  color: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.user-item .delete-btn {
  margin-left: 0;
  margin-right: 0;
  padding: 0;
  flex-shrink: 0;
  width: 120rpx;
  height: 60rpx;
  background: #ff4d4f;
  color: #ffffff;
  border: none;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  font-size: 28rpx;
  color: #999999;
}

@import "../../styles/tech-ui.wxss";
