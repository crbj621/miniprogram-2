.login-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  position: relative;
}

.bg-image {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -2;
}

.bg-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.3);
  z-index: -1;
}

.login-content {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}

.login-logo {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo-text {
  display: block;
  font-size: 60rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
  -webkit-background-clip: text;
  color: transparent;
  text-shadow: none;
}

.slogan {
  display: inline-block;
  font-size: 28rpx;
  color: #666;
  text-shadow: none;
  font-weight: 500;
}

.form-section {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  background-color: rgba(255, 255, 255, 0.85);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.5);
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.avatar-btn.tech-control {
  margin-left: 0;
  margin-right: 0;
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  padding: 20rpx;
  border-radius: 16rpx;
  border: none;
  width: 100%;
  box-sizing: border-box;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  flex-shrink: 0;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background-color: #e0e0e0;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.avatar-tip {
  min-width: 0;
  font-size: 28rpx;
  color: #666;
}

.nickname-input {
  width: 100%;
  min-width: 0;
  height: 88rpx;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.login-btn.tech-control {
  margin-left: 0;
  margin-right: 0;
  width: 100%;
  height: 96rpx;
  background: #ff9a9e;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 154, 158, 0.4);
}

.login-btn::after {
  border: none;
}

.login-btn[disabled] {
  opacity: 0.6;
}

.login-btn-text {
  color: #fff;
}

.login-content .skip-login.tech-control {
  width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  margin: 32rpx 0 0;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  font-size: 28rpx;
  font-weight: 700;
  color: #4b3972 !important;
  background: linear-gradient(105deg, #ffadd5 0%, #cbb4ff 52%, #8be9ff 100%) !important;
  border: 2rpx solid rgba(255, 255, 255, 0.92) !important;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 24rpx rgba(192, 138, 220, 0.28), inset 0 2rpx 8rpx rgba(255, 255, 255, 0.55) !important;
  text-shadow: none;
}

.login-content .skip-login.tech-pressed {
  box-shadow: 0 3rpx 12rpx rgba(158, 124, 205, 0.24), inset 0 2rpx 8rpx rgba(255, 255, 255, 0.55) !important;
}

@import "../../styles/tech-ui.wxss";
