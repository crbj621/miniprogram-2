@import "../../../styles/campus-ui.wxss";
@import "../../../styles/tech-ui.wxss";
.wardrobe-page { padding:28rpx; min-height:100vh; box-sizing:border-box; padding-bottom:calc(36rpx + env(safe-area-inset-bottom)); }
button { padding:0; margin:0; line-height:normal; font-size:24rpx; }
.wardrobe-page button.tech-control { margin-left:0; margin-right:0; border-color:var(--campus-theme-line) !important; color:var(--campus-theme-accent) !important; }
.wardrobe-page button.tech-primary,.wardrobe-page button.selected { background:var(--campus-theme-button) !important; }
.wardrobe-heading { display:flex; align-items:center; justify-content:space-between; gap:18rpx; margin-bottom:24rpx; }
.wardrobe-heading > view:first-child { flex:1; min-width:0; }
.wardrobe-kicker { display:block; color:#8996a7; font-size:22rpx; }.wardrobe-title { display:block; font-size:37rpx; font-weight:750; color:var(--campus-theme-accent); margin-top:10rpx; }
.coin-balance { display:flex; gap:8rpx; align-items:center; flex-shrink:0; padding:16rpx 20rpx; border:2rpx solid #efdfb7; border-radius:24rpx; color:#a28037; background:#fffae9; font-size:23rpx; font-weight:650; }
.wardrobe-status { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:24rpx; min-height:220rpx; padding:32rpx; border-radius:28rpx; background:#fff; font-size:25rpx; line-height:1.6; color:#8291a6; text-align:center; }
.wardrobe-page .status-retry { width:auto; min-height:88rpx; padding:0 32rpx; }
.companion-card { display:flex; align-items:center; gap:20rpx; padding:24rpx 20rpx; background:linear-gradient(145deg,#fff,var(--campus-theme-soft)); border:2rpx solid var(--campus-theme-line); border-radius:34rpx; }
.wardrobe-stage { width:260rpx; height:340rpx; flex-shrink:0; }.companion-copy { min-width:0; flex:1; }.companion-title { display:block; font-size:28rpx; font-weight:700; color:var(--campus-theme-accent); }.companion-note { display:block; font-size:23rpx; color:#8796a9; line-height:1.6; margin-top:12rpx; }
.character-options { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:20rpx; }.wardrobe-page .character-option { width:auto; flex:1; min-width:110rpx; min-height:80rpx; padding:10rpx; text-align:center; }
.wardrobe-page .earn-coins { width:100%; min-height:88rpx; padding:14rpx; margin-top:16rpx; text-align:center; font-size:22rpx; line-height:1.5; }
.wardrobe-tabs { margin:26rpx 0 18rpx; width:100%; }.tab-row,.theme-module-row { display:flex; gap:12rpx; width:max-content; padding:2rpx; }.wardrobe-page .category-tab { width:auto; min-width:116rpx; min-height:88rpx; padding:0 20rpx; text-align:center; white-space:nowrap; flex-shrink:0; }
.category-note { display:block; font-size:23rpx; color:#8898aa; line-height:1.6; margin:0 4rpx 18rpx; }.theme-module-scroll { margin-bottom:20rpx; }.wardrobe-page .theme-module { width:auto; flex-shrink:0; min-height:80rpx; padding:0 20rpx; white-space:nowrap; font-size:22rpx; }
.item-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18rpx; }.item-card { display:flex; flex-direction:column; min-width:0; padding:18rpx; background:#fff; border:2rpx solid var(--campus-theme-line); border-radius:28rpx; }
.item-preview { height:164rpx; display:flex; align-items:center; justify-content:center; position:relative; border-radius:20rpx; background:var(--campus-theme-soft); overflow:hidden; margin-bottom:14rpx; }.item-preview image { width:100%; height:100%; }.item-preview--outfit { height:236rpx; }.item-symbol { font-size:64rpx; }.equipped-badge { position:absolute; bottom:8rpx; right:8rpx; padding:5rpx 10rpx; background:#ffffffdf; color:var(--campus-theme-accent); border-radius:14rpx; font-size:19rpx; }
.item-name { font-size:26rpx; font-weight:700; line-height:1.5; color:#40546e; word-break:break-all; }.item-description { font-size:21rpx; color:#8a9bae; margin-top:8rpx; line-height:1.5; }.item-meta { font-size:21rpx; color:#8a9bae; margin:8rpx 0 18rpx; }.wardrobe-page .item-action { width:100%; min-height:88rpx; padding:12rpx 8rpx; text-align:center; margin-top:10rpx; font-size:23rpx; }.item-card .item-action:first-of-type { margin-top:auto; }
.theme-sample { width:78%; padding:14rpx; border:2rpx solid var(--campus-theme-line); background:#fff; border-radius:16rpx; box-sizing:border-box; color:var(--campus-theme-accent); }.theme-sample > text { font-size:26rpx; }.theme-sample-line { width:66%; height:8rpx; background:var(--campus-theme-soft); border-radius:10rpx; margin:10rpx 0; }.theme-sample-button { padding:8rpx; background:var(--campus-theme-button); border:1rpx solid var(--campus-theme-line); border-radius:10rpx; text-align:center; font-size:20rpx; }
.wardrobe-page .reset-button { width:100%; min-height:88rpx; margin-top:24rpx; padding:16rpx; text-align:center; }.busy-note { display:block; margin-top:16rpx; font-size:22rpx; text-align:center; color:#8796a9; }
.wardrobe-view-tabs { display:flex; gap:14rpx; margin-bottom:24rpx; }.wardrobe-page .wardrobe-view-tabs button { flex:1; width:auto; min-height:88rpx; text-align:center; }
.companion-heat { display:block; margin-top:12rpx; color:#b08a4a; font-size:23rpx; font-weight:650; }
.item-layer-preview { position:relative; width:100%; height:100%; }.item-layer-preview image { position:absolute; top:0; left:0; }
.ranking-intro { padding:26rpx; border-radius:28rpx; background:linear-gradient(140deg,#fff7e4,var(--campus-theme-soft)); border:2rpx solid var(--campus-theme-line); margin-bottom:20rpx; }.ranking-title { display:block; font-size:31rpx; color:#85655c; font-weight:700; }.ranking-note { display:block; font-size:23rpx; color:#9a8990; margin-top:12rpx; line-height:1.6; }.ranking-mine { display:flex; flex-wrap:wrap; gap:14rpx; justify-content:space-between; margin-top:24rpx; font-size:24rpx; color:#a27e44; font-weight:650; }
.wardrobe-rank-row { display:flex; align-items:center; gap:16rpx; padding:24rpx 18rpx; margin-bottom:16rpx; border:2rpx solid var(--campus-theme-line); border-radius:26rpx; background:#fff; }.wardrobe-rank-row--top { background:linear-gradient(130deg,#fffaf0,#fff); }.rank-position { width:66rpx; flex-shrink:0; text-align:center; font-size:30rpx; font-weight:750; color:#ae8951; }.rank-position-label { display:block; font-size:18rpx; margin-top:5rpx; }.rank-avatar { width:66rpx; height:66rpx; border-radius:50%; flex-shrink:0; }.rank-avatar--empty { display:flex; align-items:center; justify-content:center; background:var(--campus-theme-soft); color:var(--campus-theme-accent); font-size:32rpx; }.rank-person { flex:1; min-width:0; }.rank-name { display:block; font-size:26rpx; font-weight:650; color:#52627a; word-break:break-all; }.rank-outfit { display:block; margin-top:8rpx; font-size:20rpx; line-height:1.6; color:#9b8f9a; word-break:break-all; }.rank-heat { flex-shrink:0; text-align:center; color:#b98b45; font-size:29rpx; font-weight:700; }.rank-heat > text { display:block; }.rank-heat > text:last-child { font-size:19rpx; margin-top:5rpx; font-weight:400; }.ranking-rule { display:block; margin-top:24rpx; font-size:22rpx; line-height:1.8; color:#9694a3; }
@media (max-width:340px) { .companion-card { flex-direction:column; }.wardrobe-stage { width:260rpx; height:310rpx; }.companion-copy { width:100%; text-align:center; }.character-options { justify-content:center; }.coin-balance { padding:12rpx; font-size:21rpx; } }
