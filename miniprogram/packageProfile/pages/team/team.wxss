.container {
  padding: 30rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.no-team {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 60rpx;
}

.action-buttons {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
}

.container .btn {
  margin-left: 0;
  margin-right: 0;
  width: 80%;
  border-radius: 44rpx;
  font-weight: 500;
  font-size: 28rpx;
}

.btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.btn.secondary {
  background-color: #fff;
  color: #667eea;
  border: 2rpx solid #667eea;
}

.btn.danger {
  background-color: #ff4d4f;
  color: #fff;
  margin-top: 40rpx;
}

.btn.small {
  width: auto;
  padding: 16rpx 32rpx;
  font-size: 24rpx;
  border-radius: 32rpx;
}

.btn.cancel {
  background-color: #f5f5f5;
  color: #666;
}

.btn.confirm {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.team-info {
  width: 100%;
}

.team-header {
  background-color: #fff;
  padding: 40rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.team-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.team-name {
  flex: 1;
  min-width: 0;
  overflow-wrap: break-word;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.team-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #667eea;
  background-color: #f0f2ff;
  border: 1rpx solid #667eea;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.invite-section {
  background-color: #fff;
  padding: 40rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.invite-code-box {
  text-align: center;
  margin-bottom: 30rpx;
}

.invite-label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 16rpx;
}

.invite-code {
  font-size: 80rpx;
  font-weight: bold;
  color: #667eea;
  letter-spacing: 20rpx;
  display: block;
}

.invite-expire {
  font-size: 24rpx;
  color: #ff4d4f;
  display: block;
  margin-top: 16rpx;
}

.invite-actions {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  flex-wrap: wrap;
}

.member-list {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.section-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.member-item.empty {
  opacity: 0.5;
}

.avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #f0f2ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.avatar-placeholder.empty {
  background-color: #eee;
  color: #999;
}

.nickname {
  flex: 1;
  min-width: 0;
  overflow-wrap: break-word;
  font-size: 30rpx;
  color: #333;
}

.role {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #667eea;
  background-color: #f0f2ff;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.team-actions {
  margin-top: 40rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0,0,0,0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx;
  box-sizing: border-box;
  z-index: 100;
}

.modal-content {
  width: 100%;
  max-width: 640rpx;
  max-height: 85vh;
  box-sizing: border-box;
  background-color: #fff;
  border-radius: 20rpx;
  z-index: 101;
  overflow-y: auto;
}

.modal-header {
  padding: 30rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  border-bottom: 1rpx solid #eee;
}

.modal-body {
  padding: 40rpx 30rpx;
}

.modal-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.modal-tip {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 20rpx;
  text-align: center;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.modal-footer .btn {
  flex: 1;
  width: 0;
  min-width: 0;
  margin: 0;
  border-radius: 0;
  padding: 30rpx 0;
}
