/* 全局容器 */
.container {
  height: 100vh;
  background-color: #f5f5f5;
}

/* 设置项列表 */
.settings-list {
  padding: 20rpx;
}

/* 设置分组 */
.setting-section {
  background-color: #ffffff;
  border-radius: 15rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 分组标题 */
.section-title {
  font-size: 24rpx;
  color: #999999;
  padding: 20rpx 30rpx 10rpx;
}

/* 设置项 */
.setting-item {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.setting-item:first-child {
  border-top: none;
}

/* 设置标签 */
.setting-label {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

/* 设置描述 */
.setting-desc {
  position: absolute;
  left: 30rpx;
  top: 60rpx;
  font-size: 24rpx;
  color: #999999;
}

/* 设置项带描述时的特殊处理 */
.setting-item:has(.setting-desc) {
  position: relative;
  padding-top: 30rpx;
  padding-bottom: 40rpx;
}

.setting-item:has(.setting-desc) .setting-label {
  margin-bottom: 10rpx;
}

/* 开关 */
.setting-switch {
  transform: scale(0.8);
}

/* 箭头 */
.setting-arrow {
  font-size: 32rpx;
  color: #999999;
}

/* 点击效果 */
.setting-item:active {
  background-color: #f5f5f5;
}
@import "../../../styles/tech-ui.wxss";
