/* pages/profile/coupons/coupons.wxss */
page {
  background-color: #f9f9f9;
}

.container {
  padding: 30rpx;
}

.header {
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(255, 154, 158, 0.3);
}

.total-title {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 10rpx;
}

.total-amount {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.total-amount .symbol {
  font-size: 40rpx;
  font-weight: bold;
  margin-right: 8rpx;
}

.total-amount .num {
  font-size: 80rpx;
  font-weight: 900;
  line-height: 1;
}

.header-desc {
  font-size: 24rpx;
  opacity: 0.8;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.coupon-item {
  display: flex;
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  position: relative;
}

.coupon-item::before, .coupon-item::after {
  content: '';
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  background-color: #f9f9f9;
  border-radius: 50%;
  left: 170rpx;
}

.coupon-item::before {
  top: -12rpx;
}

.coupon-item::after {
  bottom: -12rpx;
}

.coupon-left {
  width: 180rpx;
  background: linear-gradient(135deg, #fff0f5 0%, #fff 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ff7875;
  border-right: 2rpx dashed #f0f0f0;
}

.coupon-left .symbol {
  font-size: 28rpx;
  font-weight: bold;
  margin-top: 10rpx;
  margin-right: 4rpx;
}

.coupon-left .amount {
  font-size: 56rpx;
  font-weight: 900;
}

.coupon-mid {
  flex: 1;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.coupon-mid .title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.coupon-mid .desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.coupon-mid .time {
  font-size: 22rpx;
  color: #ccc;
}

.coupon-right {
  padding: 0 30rpx;
  display: flex;
  align-items: center;
}

.use-btn {
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  padding: 12rpx 30rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 10rpx rgba(255, 154, 158, 0.3);
}

.use-btn.used-btn {
  background: #ccc;
  box-shadow: none;
}

.coupon-left.used {
  background: #f5f5f5;
  color: #999;
}

.new-user-coupon {
  border: 2rpx solid #ff9a9e;
  box-shadow: 0 4rpx 20rpx rgba(255, 154, 158, 0.2);
}

.new-user-coupon .claim-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8b 100%);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); }
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.8;
}

.empty-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.go-run-btn {
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 154, 158, 0.4);
}
@import "../../../styles/tech-ui.wxss";
