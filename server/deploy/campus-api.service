[Unit]
Description=Campus Mini Program Self-hosted API
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=campus-api
Group=campus-api
WorkingDirectory=/opt/campus-api/current/server
EnvironmentFile=/etc/campus-api/app.env
Environment=NODE_PATH=/opt/campus-api/current/server/node_modules
ExecStart=/opt/node/bin/node /opt/campus-api/current/server/src/app.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/www/campus-data/uploads /www/campus-data/portfolio-content.json
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
